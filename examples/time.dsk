import std/time
import std/io
import std/json

schema Api
    time::Timestamp: via(time::to_utc_iso_string, time::from_iso_string)
end

struct Event
    title: string
    startsAt: time::Timestamp
end

func main() -> !void
    let started = time::instant()
    let event = Event(title = "Launch", startsAt = try time::from_iso_string("2026-11-18T14:30:45.123Z"))
    let duration = try time::minutes(90)
    let ends_at = try event.startsAt.add(duration)
    let zone = try time::load_timezone("America/Sao_Paulo")
    io::println(try event.startsAt.to_iso_string())
    io::println(try event.startsAt.to_iso_string(zone))
    io::println(try ends_at.format("DD/MM/YYYY [at] HH:mm Z", zone))
    io::println("Duration: ${duration.seconds()} seconds")
    let text = try json::encode[Event, Api](event)
    io::println(text)
    let restored = try json::decode[Event, Api](text)
    assert(restored.startsAt.is_equal(event.startsAt))
    assert((try started.elapsed()).nanoseconds() >= 0)
end
