import std/json
import std/io
import std/array

struct Record
    id: int
    name: string = "Ada"
    email: ?string = null
    tags: []string = ["default", "fresh"]
end

struct RecordBox
    value: Record
end

func record_box_to_value(box: RecordBox) -> Record
    return box.value
end

func record_box_from_value(value: Record) -> RecordBox
    return RecordBox(value = value)
end

schema DuskPath
    RecordBox: via(record_box_to_value, record_box_from_value)
end

func main() -> !void
    let mut total = 0
    for 0..99999: i do
        let mut box = try json::decode[RecordBox, DuskPath]("{\"id\":42}")
        let mut record = box.value
        assert(record.name == "Ada")
        assert(record.email == null)
        array::append(record.tags, "added")
        total = total + record.id + array::len(record.tags) + 2
    end
    io::println("$total")
end
