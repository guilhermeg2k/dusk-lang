import std/array: len
import std/string

let name = "dusk"

func main() -> void
    let mut total = 0
    for 0..999999: i do
        let line = "item $i: value=${i * 3} tag=$name"
        let fields = string::split(line, " ")
        let joined = string::join(fields, ",")
        total = total + (string::len(line) + len(fields) + string::len(joined))
    end
    echo(total)
end
