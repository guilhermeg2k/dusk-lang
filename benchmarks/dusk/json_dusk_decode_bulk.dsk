import std/json
import std/io
import std/array
import std/string
import @/support/json_model: Record, bulk_text

struct RecordsBox
    value: []Record
end

func records_box_to_value(box: RecordsBox) -> []Record
    return box.value
end

func records_box_from_value(value: []Record) -> RecordsBox
    return RecordsBox(value = value)
end

schema DuskPath
    RecordsBox: via(records_box_to_value, records_box_from_value)
end

func main() -> !void
    let text = bulk_text()
    let mut total = 0
    for 0..999: i do
        let box = try json::decode[RecordsBox, DuskPath](text)
        let records = box.value
        assert(array::len(records) == 256)
        for records: record do
            total = total + record.id + string::len(record.name) + array::len(record.tags) + (record.counts["likes"] orelse 0)
        end
    end
    io::println("$total")
end
