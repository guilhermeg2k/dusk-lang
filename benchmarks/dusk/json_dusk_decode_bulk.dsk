import std/json
import std/serialization
import std/io
import std/array
import std/string
import @/support/json_model: Record, bulk_text

func main() -> !void
    let text = bulk_text()
    let mut total = 0
    for 0..999: i do
        let mut reader = json::reader(text)
        let records = try serialization::decode_document[[]Record, json::Reader](reader)
        assert(array::len(records) == 256)
        for records: record do
            total = total + record.id + string::len(record.name) + array::len(record.tags) + (record.counts["likes"] orelse 0)
        end
    end
    io::println("$total")
end
