import std/json
import std/serialization
import std/io
import std/array
import @/support/json_model: Record, record_text

func main() -> !void
    let mut total = 0
    for 0..99999: i do
        let mut reader = json::reader(record_text)
        let record = try serialization::decode_document[Record, json::Reader](reader)
        assert(record.name == "Ada\nLovelace")
        assert(record.email == null)
        assert(record.is_active)
        assert(record.profile.score == 1.5)
        total = total + record.id + array::len(record.tags) + (record.counts["views"] orelse 0) + 1
    end
    io::println("$total")
end
