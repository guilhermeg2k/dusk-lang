import std/json
import std/io
import std/array
import @/support/json_model: Record, record_text

struct RecordBox
    value: Record
end

func record_box_to_value(box: RecordBox) -> Record
    return box.value
end

func record_box_from_value(value: Record) -> RecordBox
    return RecordBox(value = value)
end

schema DuskPath
    RecordBox: via(record_box_to_value, record_box_from_value)
end

func main() -> !void
    let mut total = 0
    for 0..99999: i do
        let box = try json::decode[RecordBox, DuskPath](record_text)
        let record = box.value
        assert(record.name == "Ada\nLovelace")
        assert(record.email == null)
        assert(record.is_active)
        assert(record.profile.score == 1.5)
        total = total + record.id + array::len(record.tags) + (record.counts["views"] orelse 0) + 1
    end
    io::println("$total")
end
