import std/json
import std/io
import @/support/json_model: Record, bulk_text

struct RecordsBox
    value: []Record
end

func records_box_to_value(box: RecordsBox) -> []Record
    return box.value
end

func records_box_from_value(value: []Record) -> RecordsBox
    return RecordsBox(value = value)
end

schema DuskPath
    RecordsBox: via(records_box_to_value, records_box_from_value)
end

func main() -> !void
    let expected = bulk_text()
    let records = try json::decode[[]Record](expected)
    let box = RecordsBox(value = records)
    let mut total = 0
    for 0..999: i do
        let text = try json::encode[RecordsBox, DuskPath](box)
        assert(text == expected)
        total = total + 1
    end
    io::println("$total")
end
