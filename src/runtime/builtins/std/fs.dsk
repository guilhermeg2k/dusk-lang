error FsError
    NotFound
    PermissionDenied
    AlreadyExists
    IsDirectory
    NotDirectory
    NotEmpty
    InvalidUtf8
    Other
end

struct FileInfo
    size: int
    is_dir: bool
    is_file: bool
    is_symlink: bool
    modified_ms: int
    created_ms: ?int
    permissions: int
end

extern func read(path: string) -> FsError!string
extern func read_bytes(path: string) -> FsError!buffer
extern func write(path: string, text: string) -> FsError!void
extern func write_bytes(path: string, data: buffer) -> FsError!void
extern func append(path: string, text: string) -> FsError!void
extern func read_dir(path: string) -> FsError![]string
extern func make_dir(path: string, recursive: bool = false) -> FsError!void
extern func delete(path: string, recursive: bool = false) -> FsError!void
extern func rename(from: string, to: string) -> FsError!void
extern func exists(path: string) -> bool
extern func ~stat_numbers(path: string) -> FsError![]int

func stat(path: string) -> FsError!FileInfo
    let n = try stat_numbers(path)
    let created: ?int = if n[5] == 0 then null else n[5] end
    return FileInfo(size = n[0], is_dir = n[1] == 1, is_file = n[2] == 1, is_symlink = n[3] == 1, modified_ms = n[4], created_ms = created, permissions = n[6])
end
