import std/io

error FsError
    NotFound
    PermissionDenied
    AlreadyExists
    IsDirectory
    NotDirectory
    NotEmpty
    InvalidUtf8
    Other
end

struct FileInfo
    size: int
    is_dir: bool
    is_file: bool
    is_symlink: bool
    modified_ms: int
    created_ms: ?int
    permissions: int
end

extern func read(path: string) -> FsError!string
extern func read_bytes(path: string) -> FsError!buffer
extern func write(path: string, text: string) -> FsError!void
extern func write_bytes(path: string, data: buffer) -> FsError!void
extern func append(path: string, text: string) -> FsError!void
extern func read_dir(path: string) -> FsError![]string
extern func make_dir(path: string, recursive: bool = false) -> FsError!void
extern func delete(path: string, recursive: bool = false) -> FsError!void
extern func rename(from: string, to: string) -> FsError!void
extern func exists(path: string) -> bool
extern func ~stat_numbers(path: string) -> FsError![]int
extern func ~open_descriptor(path: string, mode: Mode) -> FsError!int
extern func ~file_stream(descriptor: int) -> int
extern func ~stream_read_bytes(handle: int, max: int, timeout_ms: int) -> io::IoError!?buffer
extern func ~stream_read_exact(handle: int, count: int, timeout_ms: int) -> io::IoError!?buffer
extern func ~stream_read_line(handle: int, max: int, timeout_ms: int) -> io::IoError!?string
extern func ~stream_read_all(handle: int, timeout_ms: int) -> io::IoError!string
extern func ~stream_read_all_bytes(handle: int, timeout_ms: int) -> io::IoError!buffer
extern func ~stream_close(handle: int) -> void

enum Mode
    Read
    Write
    Append
end

struct File
    ~handle: int

    func read_line(self: @, max: int = -1, timeout_ms: int = -1) -> io::IoError!?string
        return try stream_read_line(self.handle, max, timeout_ms)
    end

    func read_bytes(self: @, max: int, timeout_ms: int = -1) -> io::IoError!?buffer
        return try stream_read_bytes(self.handle, max, timeout_ms)
    end

    func read_exact(self: @, count: int, timeout_ms: int = -1) -> io::IoError!?buffer
        return try stream_read_exact(self.handle, count, timeout_ms)
    end

    func read_all(self: @, timeout_ms: int = -1) -> io::IoError!string
        return try stream_read_all(self.handle, timeout_ms)
    end

    func read_all_bytes(self: @, timeout_ms: int = -1) -> io::IoError!buffer
        return try stream_read_all_bytes(self.handle, timeout_ms)
    end

    func close(self: @) -> void
        stream_close(self.handle)
    end
end

func open(path: string, mode: Mode = Mode.Read) -> FsError!File
    let descriptor = try open_descriptor(path, mode)
    return File(handle = file_stream(descriptor))
end

func stat(path: string) -> FsError!FileInfo
    let n = try stat_numbers(path)
    let created: ?int = if n[5] == 0 then null else n[5] end
    return FileInfo(size = n[0], is_dir = n[1] == 1, is_file = n[2] == 1, is_symlink = n[3] == 1, modified_ms = n[4], created_ms = created, permissions = n[6])
end
