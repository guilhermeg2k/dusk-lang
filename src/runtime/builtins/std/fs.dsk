import "std/io"

error FsError
    NotFound
    PermissionDenied
    AlreadyExists
    IsDirectory
    NotDirectory
    NotEmpty
    InvalidUtf8
    TooLarge
    InvalidPath
    Other
end

struct FileInfo
    size: int
    is_dir: bool
    is_file: bool
    is_symlink: bool
    modified_ms: int
    created_ms: ?int
    permissions: int
end

extern func read(path: string, max_bytes: int = -1) -> FsError!string
extern func read_bytes(path: string, max_bytes: int = -1) -> FsError!buffer
extern func write(path: string, text: string, permissions: int = 438, follow_symlinks: bool = true) -> FsError!void
extern func write_bytes(path: string, data: buffer, permissions: int = 438, follow_symlinks: bool = true) -> FsError!void
extern func write_atomic(path: string, text: string, permissions: int = 438) -> FsError!void
extern func write_bytes_atomic(path: string, data: buffer, permissions: int = 438) -> FsError!void
extern func append(path: string, text: string, permissions: int = 438, follow_symlinks: bool = true) -> FsError!void
extern func read_dir(path: string) -> FsError![]string
extern func make_dir(path: string, recursive: bool = false, permissions: int = 511) -> FsError!void
extern func delete(path: string, recursive: bool = false) -> FsError!void
extern func rename(from: string, to: string) -> FsError!void
extern func chmod(path: string, permissions: int) -> FsError!void
extern func real_path(path: string) -> FsError!string
extern func resolve_under(root: string, rel: string) -> FsError!string
extern func exists(path: string) -> bool
extern func ~stat_numbers(path: string) -> FsError![]int
extern func ~open_descriptor(path: string, mode: Mode, permissions: int, follow_symlinks: bool) -> FsError![]int
extern func ~file_stream(descriptor: int, size: int, mode: Mode) -> int
extern func ~own(kind: int, handle: int) -> resource
extern func ~release(owner: ?resource) -> void
extern func ~stream_read_bytes(handle: int, max: int, timeout_ms: int) -> io::IoError!?buffer
extern func ~stream_read_exact(handle: int, count: int, timeout_ms: int) -> io::IoError!?buffer
extern func ~stream_read_line(handle: int, max: int, timeout_ms: int) -> io::IoError!?string
extern func ~stream_read_all(handle: int, max_bytes: int, timeout_ms: int) -> io::IoError!string
extern func ~stream_read_all_bytes(handle: int, max_bytes: int, timeout_ms: int) -> io::IoError!buffer
extern func ~stream_close(handle: int) -> void
extern func ~stream_write(handle: int, text: string) -> io::IoError!void
extern func ~stream_write_bytes(handle: int, data: buffer) -> io::IoError!void
extern func ~stream_flush(handle: int) -> io::IoError!void
extern func ~stream_position(handle: int) -> int
extern func ~stream_seek(handle: int, target: int) -> io::IoError!void
extern func ~stream_file_size(handle: int) -> io::IoError!int

enum Mode
    Read
    Write
    Append
    CreateNew
end

enum SeekFrom
    Start
    Current
    End
end

struct File
    ~handle: int
    ~owner: resource

    func read_line(self: @, max: int = -1) -> io::IoError!?string
        return try stream_read_line(self.handle, max, -1)
    end

    func read_bytes(self: @, max: int) -> io::IoError!?buffer
        return try stream_read_bytes(self.handle, max, -1)
    end

    func read_exact(self: @, count: int) -> io::IoError!?buffer
        return try stream_read_exact(self.handle, count, -1)
    end

    func read_all(self: @, max_bytes: int = -1) -> io::IoError!string
        return try stream_read_all(self.handle, max_bytes, -1)
    end

    func read_all_bytes(self: @, max_bytes: int = -1) -> io::IoError!buffer
        return try stream_read_all_bytes(self.handle, max_bytes, -1)
    end

    func write(self: @, text: string) -> io::IoError!void
        try stream_write(self.handle, text)
    end

    func write_bytes(self: @, data: buffer) -> io::IoError!void
        try stream_write_bytes(self.handle, data)
    end

    func flush(self: @) -> io::IoError!void
        try stream_flush(self.handle)
    end

    func position(self: @) -> int
        return stream_position(self.handle)
    end

    func size(self: @) -> io::IoError!int
        try stream_flush(self.handle)
        return try stream_file_size(self.handle)
    end

    func seek(self: @, offset: int, from: SeekFrom = SeekFrom.Start) -> io::IoError!int
        let base = when from
            SeekFrom.Start then 0 end
            SeekFrom.Current then self.position() end
            SeekFrom.End then try self.size() end
        end
        try stream_flush(self.handle)
        if offset > 0 and base > 9223372036854775807 - offset then
            return io::IoError.Other
        end
        try stream_seek(self.handle, base + offset)
        return base + offset
    end

    func close(self: @) -> io::IoError!void
        let mut flush_err: ?io::IoError = null
        stream_flush(self.handle) catch e then
            flush_err = e
        end
        stream_close(self.handle)
        release(self.owner)
        if flush_err: err then
            if err != io::IoError.Closed then
                return err
            end
        end
    end
end

func open(path: string, mode: Mode = Mode.Read, permissions: int = 438, follow_symlinks: bool = true) -> FsError!File
    let opened = try open_descriptor(path, mode, permissions, follow_symlinks)
    let handle = file_stream(opened[0], opened[1], mode)
    return File(handle = handle, owner = own(0, handle))
end

func stat(path: string) -> FsError!FileInfo
    let n = try stat_numbers(path)
    let created: ?int = if n[7] == 0 then null else n[5] end
    return FileInfo(size = n[0], is_dir = n[1] == 1, is_file = n[2] == 1, is_symlink = n[3] == 1, modified_ms = n[4], created_ms = created, permissions = n[6])
end
