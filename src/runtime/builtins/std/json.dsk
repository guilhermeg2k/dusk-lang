import std/serialization
import std/string
import std/buffer
import std/array
import std/map
import std/math

error JsonError
    InvalidJson
    TypeMismatch
    MissingField
    UnknownField
    DuplicateKey
    NumberOutOfRange
    UnknownVariant
    InvalidUnion
    NonFiniteNumber
    DepthExceeded
    CycleDetected
    InvalidOptions
    InvalidValue
end

struct Diagnostic
    path: string = ""
    byte_offset: ?int = null
    line: ?int = null
    column: ?int = null
end

struct DecodeOptions
    should_reject_unknown_fields: bool = false
    max_depth: int = 128
end

struct EncodeOptions
    max_depth: int = 128
end

extern func ~encode_value[T](value: T, options: EncodeOptions, plan: int, fragments: []string) -> JsonError!string
extern func ~decode_value[T](text: string, mut diagnostic: ?Diagnostic, options: DecodeOptions, plan: int, mut steps: []func() -> bool) -> JsonError!T
extern func ~string_end(text: string, position: int) -> int
extern func ~number_end(text: string, position: int) -> int
extern func ~string_value(text: string, start: int, stop: int) -> JsonError!string
extern func ~quote(text: string) -> JsonError!string
extern func ~format_float(value: float) -> JsonError!string
extern func ~key_index(fields: int, text: string, start: int, stop: int) -> JsonError!int
extern func ~parse_int(text: string, start: int, stop: int) -> JsonError!int
extern func ~parse_float(text: string, start: int, stop: int) -> JsonError!float
extern func ~put_quoted(mut data: buffer, at: int, text: string) -> JsonError!int
extern func ~put_float(mut data: buffer, at: int, value: float) -> JsonError!int
extern func ~buffer_text(data: buffer, used: int) -> string

func encode[T, S: schema](value: T, options: EncodeOptions = @()) -> JsonError!string
    if serialization::is_native[T, S]() then
        let mut fragments: []string = []
        if serialization::has_proxies[T, S]() then
            let mut collector = writer(options)
            serialization::proxy_fragments[T, Writer, S](value, collector, fragments) catch e then
                try raise(collector.failure, e)
                return JsonError.InvalidJson
            end
        end
        return try encode_value(value, options, serialization::plan_of[T, S](), fragments)
    else
        return try encode_derived[T, S](value, options)
    end
end

func decode[T, S: schema](text: string, mut diagnostic: ?Diagnostic = null, options: DecodeOptions = @()) -> JsonError!T
    if serialization::is_native[T, S]() then
        let mut steps: []func() -> bool = []
        let value = try decode_value[T](text, diagnostic, options, serialization::plan_of[T, S](), steps)
        for steps: step do
            if !step() then
                return JsonError.InvalidValue
            end
        end
        return value
    else
        return try decode_derived[T, S](text, diagnostic, options)
    end
end

func reader(text: string, options: DecodeOptions = @()) -> Reader
    return Reader(text = text, data = buffer::from_string(text), max_depth = options.max_depth, should_reject_unknown_fields = options.should_reject_unknown_fields)
end

func writer(options: EncodeOptions = @()) -> Writer
    return Writer(max_depth = options.max_depth, data = buffer::from_string(""))
end

func ~is_valid_depth(depth: int) -> bool
    return depth > 0 and depth <= 512
end

func ~encode_derived[T, S: schema](value: T, options: EncodeOptions) -> JsonError!string
    if !is_valid_depth(options.max_depth) then
        return JsonError.InvalidOptions
    end
    let mut writer = writer(options)
    serialization::encode[T, Writer, S](value, writer) catch e then
        try raise(writer.failure, e)
        return JsonError.InvalidJson
    end
    return writer.text()
end

func ~decode_derived[T, S: schema](text: string, mut diagnostic: ?Diagnostic, options: DecodeOptions) -> JsonError!T
    if diagnostic: mut found then
        found.path = ""
        found.byte_offset = null
        found.line = null
        found.column = null
    end
    if !is_valid_depth(options.max_depth) then
        return JsonError.InvalidOptions
    end
    let mut reader = Reader(text = text, data = buffer::from_string(text), max_depth = options.max_depth, should_reject_unknown_fields = options.should_reject_unknown_fields)
    let value = serialization::decode_document[T, Reader, S](reader) catch e then
        if diagnostic: mut found then
            reader.describe(found)
        end
        try raise(reader.failure, e)
        return JsonError.InvalidJson
    end
    return value
end

func ~raise(failure: ?JsonError, cause: serialization::SerializationError) -> JsonError!void
    if failure: found then
        when found
            JsonError.InvalidJson then
                return JsonError.InvalidJson
            end
            JsonError.TypeMismatch then
                return JsonError.TypeMismatch
            end
            JsonError.MissingField then
                return JsonError.MissingField
            end
            JsonError.UnknownField then
                return JsonError.UnknownField
            end
            JsonError.DuplicateKey then
                return JsonError.DuplicateKey
            end
            JsonError.NumberOutOfRange then
                return JsonError.NumberOutOfRange
            end
            JsonError.UnknownVariant then
                return JsonError.UnknownVariant
            end
            JsonError.InvalidUnion then
                return JsonError.InvalidUnion
            end
            JsonError.NonFiniteNumber then
                return JsonError.NonFiniteNumber
            end
            JsonError.DepthExceeded then
                return JsonError.DepthExceeded
            end
            JsonError.CycleDetected then
                return JsonError.CycleDetected
            end
            JsonError.InvalidOptions then
                return JsonError.InvalidOptions
            end
            JsonError.InvalidValue then
                return JsonError.InvalidValue
            end
        end
    end
    when cause
        serialization::SerializationError.TypeMismatch then
            return JsonError.TypeMismatch
        end
        serialization::SerializationError.MissingField then
            return JsonError.MissingField
        end
        serialization::SerializationError.UnknownField then
            return JsonError.UnknownField
        end
        serialization::SerializationError.DuplicateField then
            return JsonError.DuplicateKey
        end
        serialization::SerializationError.OutOfRange then
            return JsonError.NumberOutOfRange
        end
        serialization::SerializationError.InvalidValue then
            return JsonError.InvalidValue
        end
        serialization::SerializationError.UnknownVariant then
            return JsonError.UnknownVariant
        end
        serialization::SerializationError.DepthExceeded then
            return JsonError.DepthExceeded
        end
        serialization::SerializationError.CycleDetected then
            return JsonError.CycleDetected
        end
        else then
            return JsonError.InvalidJson
        end
    end
end

struct Reader
    ~text: string
    ~data: buffer
    ~max_depth: int
    ~should_reject_unknown_fields: bool
    ~pos: int = 0
    ~depth: int = 0
    ~next_object: int = 0
    ~counts: []int = []
    ~objects: []int = []
    ~mark_kinds: []int = []
    ~mark_starts: []int = []
    ~mark_stops: []int = []
    ~seen_keys: map[string, bool] = {}
    ~missing_name: string = ""
    ~failure: ?JsonError = null

    func ~fail(mut self: @, failure: JsonError) -> void
        if self.failure == null then
            self.failure = failure
        end
    end

    func ~peek(mut self: @) -> byte
        let size = buffer::len(self.data)
        for self.pos < size do
            let c = self.data[self.pos]
            let is_space = c == ' ' or c == '\n' or c == '\r' or c == '\t'
            if !is_space then
                return c
            end
            self.pos = self.pos + 1
        end
        return 0
    end

    func ~expect(mut self: @, c: byte) -> serialization::SerializationError!void
        if self.peek() != c then
            self.fail(JsonError.InvalidJson)
            return serialization::SerializationError.InvalidInput
        end
        self.pos = self.pos + 1
    end

    func ~word(mut self: @, a: byte, b: byte, c: byte, d: byte) -> bool
        let has_room = self.pos + 3 < buffer::len(self.data)
        if !has_room then
            return false
        end
        let is_word = self.data[self.pos] == a and self.data[self.pos + 1] == b and self.data[self.pos + 2] == c and self.data[self.pos + 3] == d
        if is_word then
            self.pos = self.pos + 4
        end
        return is_word
    end

    func ~number_stop(mut self: @) -> serialization::SerializationError!int
        let c = self.peek()
        let starts_number = c == '-' or (c >= '0' and c <= '9')
        if !starts_number then
            self.fail(JsonError.TypeMismatch)
            return serialization::SerializationError.TypeMismatch
        end
        let stop = number_end(self.text, self.pos)
        if stop < 0 then
            self.fail(JsonError.InvalidJson)
            return serialization::SerializationError.InvalidInput
        end
        return stop
    end

    func read_int(mut self: @) -> serialization::SerializationError!int
        let stop = try self.number_stop()
        let number = parse_int(self.text, self.pos, stop) catch e then
            self.fail(e)
            return serialization::SerializationError.TypeMismatch
        end
        self.pos = stop
        return number
    end

    func read_float(mut self: @) -> serialization::SerializationError!float
        let stop = try self.number_stop()
        let number = parse_float(self.text, self.pos, stop) catch e then
            self.fail(e)
            return serialization::SerializationError.OutOfRange
        end
        self.pos = stop
        return number
    end

    func read_bool(mut self: @) -> serialization::SerializationError!bool
        let c = self.peek()
        if c == 't' and self.word('t', 'r', 'u', 'e') then
            return true
        end
        if c == 'f' and self.word('f', 'a', 'l', 's') and self.peek() == 'e' then
            self.pos = self.pos + 1
            return false
        end
        self.fail(if c == 't' or c == 'f' then JsonError.InvalidJson else JsonError.TypeMismatch end)
        return serialization::SerializationError.TypeMismatch
    end

    func ~string_stop(mut self: @, failure: JsonError) -> serialization::SerializationError!int
        if self.peek() != '"' then
            self.fail(failure)
            return serialization::SerializationError.TypeMismatch
        end
        let stop = string_end(self.text, self.pos)
        if stop < 0 then
            self.fail(JsonError.InvalidJson)
            return serialization::SerializationError.InvalidInput
        end
        return stop
    end

    func read_string(mut self: @) -> serialization::SerializationError!string
        let stop = try self.string_stop(JsonError.TypeMismatch)
        let value = string_value(self.text, self.pos, stop) catch e then
            self.fail(e)
            return serialization::SerializationError.InvalidInput
        end
        self.pos = stop
        return value
    end

    func read_null(mut self: @) -> serialization::SerializationError!bool
        if self.peek() != 'n' then
            return false
        end
        if !self.word('n', 'u', 'l', 'l') then
            self.fail(JsonError.InvalidJson)
            return serialization::SerializationError.InvalidInput
        end
        return true
    end

    func ~open(mut self: @, c: byte) -> serialization::SerializationError!void
        if self.peek() != c then
            self.fail(JsonError.TypeMismatch)
            return serialization::SerializationError.TypeMismatch
        end
        if self.depth >= self.max_depth then
            self.fail(JsonError.DepthExceeded)
            return serialization::SerializationError.DepthExceeded
        end
        self.pos = self.pos + 1
        if self.depth == array::len(self.counts) then
            array::append(self.counts, 0)
            array::append(self.objects, 0)
            array::append(self.mark_kinds, 0)
            array::append(self.mark_starts, 0)
            array::append(self.mark_stops, 0)
        end
        self.counts[self.depth] = 0
        self.objects[self.depth] = self.next_object
        self.mark_kinds[self.depth] = 0
        self.next_object = self.next_object + 1
        self.depth = self.depth + 1
    end

    func ~close(mut self: @) -> void
        self.pos = self.pos + 1
        self.depth = self.depth - 1
    end

    func ~separate(mut self: @) -> serialization::SerializationError!void
        let level = self.depth - 1
        if self.counts[level] > 0 then
            try self.expect(',')
        end
        self.counts[level] = self.counts[level] + 1
    end

    func ~key_span(mut self: @, kind: int) -> serialization::SerializationError!int
        try self.separate()
        let start = self.pos
        let stop = try self.string_stop(JsonError.InvalidJson)
        let level = self.depth - 1
        self.mark_kinds[level] = kind
        self.mark_starts[level] = start
        self.mark_stops[level] = stop
        self.pos = stop
        try self.expect(':')
        return start
    end

    func ~remember_key(mut self: @, start: int, stop: int) -> serialization::SerializationError!string
        let name = string_value(self.text, start, stop) catch e then
            self.fail(e)
            return serialization::SerializationError.InvalidInput
        end
        let seen = "${self.objects[self.depth - 1]}:${name}"
        if map::has(self.seen_keys, seen) then
            self.fail(JsonError.DuplicateKey)
            return serialization::SerializationError.DuplicateField
        end
        self.seen_keys[seen] = true
        return name
    end

    func begin_struct(mut self: @, fields: int) -> serialization::SerializationError!void
        try self.open('{')
    end

    func next_field(mut self: @, fields: int) -> serialization::SerializationError!int
        for true do
            if self.peek() == '}' then
                self.close()
                return -1
            end
            let start = try self.key_span(1)
            let stop = self.mark_stops[self.depth - 1]
            let index = key_index(fields, self.text, start, stop) catch e then
                self.fail(e)
                return serialization::SerializationError.InvalidInput
            end
            if index >= 0 then
                return index
            end
            if self.should_reject_unknown_fields then
                self.fail(JsonError.UnknownField)
                return serialization::SerializationError.UnknownField
            end
            let name = try self.remember_key(start, stop)
            try self.skip_value()
        end
        return -1
    end

    func missing_field(mut self: @, fields: int, index: int) -> serialization::SerializationError!void
        self.missing_name = serialization::field_name(fields, index)
        self.fail(JsonError.MissingField)
        return serialization::SerializationError.MissingField
    end

    func begin_array(mut self: @) -> serialization::SerializationError!void
        try self.open('[')
    end

    func has_item(mut self: @) -> serialization::SerializationError!bool
        if self.peek() == ']' then
            self.close()
            return false
        end
        let level = self.depth - 1
        self.mark_kinds[level] = 3
        self.mark_starts[level] = self.counts[level]
        try self.separate()
        return true
    end

    func begin_map(mut self: @) -> serialization::SerializationError!void
        try self.open('{')
    end

    func next_key(mut self: @) -> serialization::SerializationError!?string
        if self.peek() == '}' then
            self.close()
            return null
        end
        let start = try self.key_span(2)
        return try self.remember_key(start, self.mark_stops[self.depth - 1])
    end

    func read_variant(mut self: @, variants: int) -> serialization::SerializationError!int
        let name = try self.read_string()
        let index = serialization::find_variant(variants, name)
        if index < 0 then
            self.fail(JsonError.UnknownVariant)
            return serialization::SerializationError.UnknownVariant
        end
        return index
    end

    func begin_union(mut self: @, variants: int) -> serialization::SerializationError!int
        try self.open('{')
        if self.peek() == '}' then
            self.fail(JsonError.InvalidUnion)
            return serialization::SerializationError.InvalidInput
        end
        let start = try self.key_span(1)
        let name = string_value(self.text, start, self.mark_stops[self.depth - 1]) catch e then
            self.fail(e)
            return serialization::SerializationError.InvalidInput
        end
        let index = serialization::find_variant(variants, name)
        if index < 0 then
            self.fail(JsonError.UnknownVariant)
            return serialization::SerializationError.UnknownVariant
        end
        return index
    end

    func end_union(mut self: @) -> serialization::SerializationError!void
        if self.peek() != '}' then
            self.fail(JsonError.InvalidUnion)
            return serialization::SerializationError.InvalidInput
        end
        self.close()
    end

    func end_document(mut self: @) -> serialization::SerializationError!void
        if self.peek() != 0 then
            self.fail(JsonError.InvalidJson)
            return serialization::SerializationError.InvalidInput
        end
    end

    func ~skip_value(mut self: @) -> serialization::SerializationError!void
        let c = self.peek()
        if c == '{' then
            try self.open('{')
            for self.peek() != '}' do
                let start = try self.key_span(1)
                let name = try self.remember_key(start, self.mark_stops[self.depth - 1])
                try self.skip_value()
            end
            self.close()
            return
        end
        if c == '[' then
            try self.open('[')
            for try self.has_item() do
                try self.skip_value()
            end
            return
        end
        if c == '"' then
            let text = try self.read_string()
            return
        end
        if c == 't' or c == 'f' then
            let flag = try self.read_bool()
            return
        end
        if c == 'n' then
            let is_null = try self.read_null()
            return
        end
        let stop = try self.number_stop()
        self.pos = stop
    end

    func ~describe(mut self: @, mut diagnostic: Diagnostic) -> void
        let mut parts: []string = []
        for 0..self.depth - 1: level do
            let kind = self.mark_kinds[level]
            if kind == 3 then
                array::append(parts, "[${self.mark_starts[level]}]")
                continue
            end
            if kind == 0 then
                continue
            end
            let name = string_value(self.text, self.mark_starts[level], self.mark_stops[level]) catch ""
            if kind == 1 and is_identifier(name) then
                array::append(parts, ".${name}")
            else
                let quoted = quote(name) catch "\"\""
                array::append(parts, "[${quoted}]")
            end
        end
        if string::len(self.missing_name) > 0 then
            array::append(parts, ".${self.missing_name}")
        end
        let path = string::join(parts)
        diagnostic.path = if string::starts_with(path, ".") then (string::slice(path, 1, string::len(path)) catch path) else path end
        let offset = if self.pos < buffer::len(self.data) then self.pos else buffer::len(self.data) end
        let mut line = 1
        let mut column = 1
        for 0..offset - 1: i do
            if self.data[i] == '\n' then
                line = line + 1
                column = 1
            else
                column = column + 1
            end
        end
        diagnostic.byte_offset = offset
        diagnostic.line = line
        diagnostic.column = column
    end
end

func ~is_identifier(name: string) -> bool
    if string::len(name) == 0 then
        return false
    end
    let data = buffer::from_string(name)
    for data: c, i do
        let is_letter = (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'
        let is_digit = c >= '0' and c <= '9' and i > 0
        if !is_letter and !is_digit then
            return false
        end
    end
    return true
end

struct Writer
    ~max_depth: int
    ~data: buffer
    ~used: int = 0
    ~depth: int = 0
    ~counts: []int = []
    ~names: map[int, string] = {}
    ~failure: ?JsonError = null

    func text(self: @) -> string
        return buffer_text(self.data, self.used)
    end

    func clear(mut self: @) -> void
        self.used = 0
        self.depth = 0
    end

    func ~fail(mut self: @, failure: JsonError) -> void
        if self.failure == null then
            self.failure = failure
        end
    end

    func ~grow(mut self: @, extra: int) -> void
        let doubled = buffer::len(self.data) * 2
        let needed = self.used + extra
        let capacity = if doubled > needed then doubled else needed end
        let mut bigger = buffer::new(if capacity > 1024 then capacity else 1024 end) catch e then
            return
        end
        let kept = buffer::slice(self.data, 0, self.used) catch e then
            return
        end
        let copied = buffer::put_bytes(bigger, 0, kept) catch e then
            return
        end
        self.data = bigger
    end

    func ~put_text(mut self: @, text: string) -> void
        let next = buffer::put(self.data, self.used, text) catch e then
            self.grow(string::len(text))
            self.used = buffer::put(self.data, self.used, text) catch self.used
            return
        end
        self.used = next
    end

    func ~put_byte(mut self: @, c: byte) -> void
        if self.used >= buffer::len(self.data) then
            self.grow(1)
        end
        self.data[self.used] = c
        self.used = self.used + 1
    end

    func write_int(mut self: @, value: int) -> serialization::SerializationError!void
        let next = buffer::put_int(self.data, self.used, value) catch e then
            self.grow(20)
            self.used = buffer::put_int(self.data, self.used, value) catch self.used
            return
        end
        self.used = next
    end

    func write_float(mut self: @, value: float) -> serialization::SerializationError!void
        for true do
            let next = put_float(self.data, self.used, value) catch e then
                self.fail(e)
                return serialization::SerializationError.InvalidValue
            end
            if next >= 0 then
                self.used = next
                return
            end
            self.grow(32)
        end
    end

    func write_bool(mut self: @, value: bool) -> serialization::SerializationError!void
        self.put_text(if value then "true" else "false" end)
    end

    func write_string(mut self: @, value: string) -> serialization::SerializationError!void
        for true do
            let next = put_quoted(self.data, self.used, value) catch e then
                self.fail(e)
                return serialization::SerializationError.InvalidValue
            end
            if next >= 0 then
                self.used = next
                return
            end
            self.grow(string::len(value) * 6 + 2)
        end
    end

    func write_null(mut self: @) -> serialization::SerializationError!void
        self.put_text("null")
    end

    func ~open(mut self: @, c: byte) -> serialization::SerializationError!void
        if self.depth >= self.max_depth then
            self.fail(JsonError.DepthExceeded)
            return serialization::SerializationError.DepthExceeded
        end
        self.put_byte(c)
        if self.depth == array::len(self.counts) then
            array::append(self.counts, 0)
        end
        self.counts[self.depth] = 0
        self.depth = self.depth + 1
    end

    func ~close(mut self: @, c: byte) -> void
        self.depth = self.depth - 1
        self.put_byte(c)
    end

    func ~separate(mut self: @) -> void
        let level = self.depth - 1
        if self.counts[level] > 0 then
            self.put_byte(',')
        end
        self.counts[level] = self.counts[level] + 1
    end

    func ~cached_name(mut self: @, key: int, name: string) -> serialization::SerializationError!void
        if self.names[key]: found then
            self.put_text(found)
            return
        end
        let quoted = quote(name) catch e then
            self.fail(e)
            return serialization::SerializationError.InvalidValue
        end
        let label = "${quoted}:"
        self.names[key] = label
        self.put_text(label)
    end

    func begin_struct(mut self: @, fields: int, count: int) -> serialization::SerializationError!void
        try self.open('{')
    end

    func field(mut self: @, fields: int, index: int) -> serialization::SerializationError!void
        self.separate()
        let key = fields * 65536 + index
        if self.names[key]: found then
            self.put_text(found)
            return
        end
        try self.cached_name(key, serialization::field_name(fields, index))
    end

    func end_struct(mut self: @) -> serialization::SerializationError!void
        self.close('}')
    end

    func begin_array(mut self: @, length: int) -> serialization::SerializationError!void
        try self.open('[')
    end

    func item(mut self: @, index: int) -> serialization::SerializationError!void
        if index > 0 then
            self.put_byte(',')
        end
    end

    func end_array(mut self: @) -> serialization::SerializationError!void
        self.close(']')
    end

    func begin_map(mut self: @, length: int) -> serialization::SerializationError!void
        try self.open('{')
    end

    func key(mut self: @, text: string) -> serialization::SerializationError!void
        self.separate()
        try self.write_string(text)
        self.put_byte(':')
    end

    func end_map(mut self: @) -> serialization::SerializationError!void
        self.close('}')
    end

    func write_variant(mut self: @, variants: int, index: int) -> serialization::SerializationError!void
        try self.write_string(serialization::variant_name(variants, index))
    end

    func begin_union(mut self: @, variants: int, index: int) -> serialization::SerializationError!void
        try self.open('{')
        self.separate()
        try self.cached_name(0 - (variants * 65536 + index) - 1, serialization::variant_name(variants, index))
    end

    func end_union(mut self: @) -> serialization::SerializationError!void
        self.close('}')
    end
end
