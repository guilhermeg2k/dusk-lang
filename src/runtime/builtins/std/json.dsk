import std/serialization
import std/string
import std/buffer
import std/array
import std/map
import std/math

error JsonError
    InvalidJson
    TypeMismatch
    MissingField
    UnknownField
    DuplicateKey
    NumberOutOfRange
    UnknownVariant
    InvalidUnion
    NonFiniteNumber
    DepthExceeded
    CycleDetected
    InvalidOptions
    InvalidValue
end

struct Diagnostic
    path: string = ""
    byte_offset: ?int = null
    line: ?int = null
    column: ?int = null
end

struct DecodeOptions
    should_reject_unknown_fields: bool = false
    max_depth: int = 128
end

struct EncodeOptions
    max_depth: int = 128
end

extern func ~encode_value[T](value: T, options: EncodeOptions, plan: int) -> JsonError!string
extern func ~decode_value[T](text: string, mut diagnostic: ?Diagnostic, options: DecodeOptions, plan: int, mut defaults: []func() -> void) -> JsonError!T
extern func ~skip_space(text: string, position: int) -> int
extern func ~string_end(text: string, position: int) -> int
extern func ~number_end(text: string, position: int) -> int
extern func ~string_value(text: string, start: int, stop: int) -> JsonError!string
extern func ~quote(text: string) -> JsonError!string
extern func ~format_float(value: float) -> JsonError!string

func encode[T, S: schema](value: T, options: EncodeOptions = @()) -> JsonError!string
    if serialization::is_native[T, S]() then
        return try encode_value(value, options, serialization::plan_of[T, S]())
    else
        return try encode_derived[T, S](value, options)
    end
end

func decode[T, S: schema](text: string, mut diagnostic: ?Diagnostic = null, options: DecodeOptions = @()) -> JsonError!T
    if serialization::is_native[T, S]() then
        let mut defaults: []func() -> void = []
        let value = try decode_value[T](text, diagnostic, options, serialization::plan_of[T, S](), defaults)
        for defaults: apply_default do
            apply_default()
        end
        return value
    else
        return try decode_derived[T, S](text, diagnostic, options)
    end
end

func reader(text: string, options: DecodeOptions = @()) -> Reader
    return Reader(text = text, data = buffer::from_string(text), max_depth = options.max_depth, should_reject_unknown_fields = options.should_reject_unknown_fields)
end

func writer(options: EncodeOptions = @()) -> Writer
    return Writer(max_depth = options.max_depth)
end

func ~is_valid_depth(depth: int) -> bool
    return depth > 0 and depth <= 512
end

func ~encode_derived[T, S: schema](value: T, options: EncodeOptions) -> JsonError!string
    if !is_valid_depth(options.max_depth) then
        return JsonError.InvalidOptions
    end
    let mut writer = Writer(max_depth = options.max_depth)
    serialization::encode[T, Writer, S](value, writer) catch e then
        try raise(writer.failure, e)
        return JsonError.InvalidJson
    end
    return string::join(writer.parts)
end

func ~decode_derived[T, S: schema](text: string, mut diagnostic: ?Diagnostic, options: DecodeOptions) -> JsonError!T
    if diagnostic: mut found then
        found.path = ""
        found.byte_offset = null
        found.line = null
        found.column = null
    end
    if !is_valid_depth(options.max_depth) then
        return JsonError.InvalidOptions
    end
    let mut reader = Reader(text = text, data = buffer::from_string(text), max_depth = options.max_depth, should_reject_unknown_fields = options.should_reject_unknown_fields)
    let value = serialization::decode_document[T, Reader, S](reader) catch e then
        if diagnostic: mut found then
            reader.describe(found)
        end
        try raise(reader.failure, e)
        return JsonError.InvalidJson
    end
    return value
end

func ~raise(failure: ?JsonError, cause: serialization::SerializationError) -> JsonError!void
    if failure: found then
        when found
            JsonError.InvalidJson then
                return JsonError.InvalidJson
            end
            JsonError.TypeMismatch then
                return JsonError.TypeMismatch
            end
            JsonError.MissingField then
                return JsonError.MissingField
            end
            JsonError.UnknownField then
                return JsonError.UnknownField
            end
            JsonError.DuplicateKey then
                return JsonError.DuplicateKey
            end
            JsonError.NumberOutOfRange then
                return JsonError.NumberOutOfRange
            end
            JsonError.UnknownVariant then
                return JsonError.UnknownVariant
            end
            JsonError.InvalidUnion then
                return JsonError.InvalidUnion
            end
            JsonError.NonFiniteNumber then
                return JsonError.NonFiniteNumber
            end
            JsonError.DepthExceeded then
                return JsonError.DepthExceeded
            end
            JsonError.CycleDetected then
                return JsonError.CycleDetected
            end
            JsonError.InvalidOptions then
                return JsonError.InvalidOptions
            end
            JsonError.InvalidValue then
                return JsonError.InvalidValue
            end
        end
    end
    when cause
        serialization::SerializationError.TypeMismatch then
            return JsonError.TypeMismatch
        end
        serialization::SerializationError.MissingField then
            return JsonError.MissingField
        end
        serialization::SerializationError.UnknownField then
            return JsonError.UnknownField
        end
        serialization::SerializationError.DuplicateField then
            return JsonError.DuplicateKey
        end
        serialization::SerializationError.OutOfRange then
            return JsonError.NumberOutOfRange
        end
        serialization::SerializationError.InvalidValue then
            return JsonError.InvalidValue
        end
        serialization::SerializationError.UnknownVariant then
            return JsonError.UnknownVariant
        end
        serialization::SerializationError.DepthExceeded then
            return JsonError.DepthExceeded
        end
        serialization::SerializationError.CycleDetected then
            return JsonError.CycleDetected
        end
        else then
            return JsonError.InvalidJson
        end
    end
end

struct Reader
    ~text: string
    ~data: buffer
    ~max_depth: int
    ~should_reject_unknown_fields: bool
    ~pos: int = 0
    ~counts: []int = []
    ~keys: []map[string, bool] = []
    ~segments: []string = []
    ~failure: ?JsonError = null

    func ~fail(mut self: @, failure: JsonError) -> void
        if self.failure == null then
            self.failure = failure
        end
    end

    func ~peek(mut self: @) -> byte
        self.pos = skip_space(self.text, self.pos)
        if self.pos >= buffer::len(self.data) then
            return 0
        end
        return self.data[self.pos]
    end

    func ~expect(mut self: @, c: byte, failure: JsonError) -> serialization::SerializationError!void
        if self.peek() != c then
            self.fail(failure)
            return serialization::SerializationError.InvalidInput
        end
        self.pos = self.pos + 1
    end

    func ~literal(mut self: @, word: string) -> serialization::SerializationError!void
        let stop = self.pos + string::len(word)
        let found = string::slice(self.text, self.pos, stop) catch ""
        if found != word then
            self.fail(JsonError.InvalidJson)
            return serialization::SerializationError.InvalidInput
        end
        self.pos = stop
    end

    func ~number_text(mut self: @) -> serialization::SerializationError!string
        let c = self.peek()
        let starts_number = c == '-' or (c >= '0' and c <= '9')
        if !starts_number then
            self.fail(JsonError.TypeMismatch)
            return serialization::SerializationError.InvalidInput
        end
        let stop = number_end(self.text, self.pos)
        if stop < 0 then
            self.fail(JsonError.InvalidJson)
            return serialization::SerializationError.InvalidInput
        end
        let text = string::slice(self.text, self.pos, stop) catch ""
        self.pos = stop
        return text
    end

    func read_int(mut self: @) -> serialization::SerializationError!int
        let text = try self.number_text()
        let has_fraction = string::contains(text, ".") or string::contains(text, "e") or string::contains(text, "E")
        if has_fraction then
            self.fail(JsonError.TypeMismatch)
            return serialization::SerializationError.InvalidInput
        end
        let number = string::to_int(text) catch e then
            self.fail(JsonError.NumberOutOfRange)
            return serialization::SerializationError.InvalidInput
        end
        return number
    end

    func read_float(mut self: @) -> serialization::SerializationError!float
        let text = try self.number_text()
        let number = string::to_float(text) catch e then
            self.fail(JsonError.NumberOutOfRange)
            return serialization::SerializationError.InvalidInput
        end
        if !math::is_finite(number) then
            self.fail(JsonError.NumberOutOfRange)
            return serialization::SerializationError.InvalidInput
        end
        return number
    end

    func read_bool(mut self: @) -> serialization::SerializationError!bool
        let c = self.peek()
        if c == 't' then
            try self.literal("true")
            return true
        end
        if c == 'f' then
            try self.literal("false")
            return false
        end
        self.fail(JsonError.TypeMismatch)
        return serialization::SerializationError.InvalidInput
    end

    func read_string(mut self: @) -> serialization::SerializationError!string
        if self.peek() != '"' then
            self.fail(JsonError.TypeMismatch)
            return serialization::SerializationError.InvalidInput
        end
        let stop = string_end(self.text, self.pos)
        if stop < 0 then
            self.fail(JsonError.InvalidJson)
            return serialization::SerializationError.InvalidInput
        end
        let value = string_value(self.text, self.pos, stop) catch e then
            self.fail(e)
            return serialization::SerializationError.InvalidInput
        end
        self.pos = stop
        return value
    end

    func read_null(mut self: @) -> serialization::SerializationError!bool
        if self.peek() != 'n' then
            return false
        end
        try self.literal("null")
        return true
    end

    func ~open(mut self: @, c: byte, is_object: bool) -> serialization::SerializationError!void
        if self.peek() != c then
            self.fail(JsonError.TypeMismatch)
            return serialization::SerializationError.InvalidInput
        end
        if array::len(self.counts) >= self.max_depth then
            self.fail(JsonError.DepthExceeded)
            return serialization::SerializationError.InvalidInput
        end
        self.pos = self.pos + 1
        array::append(self.counts, 0)
        array::append(self.segments, "")
        if is_object then
            array::append(self.keys, {})
        end
    end

    func ~close(mut self: @, is_object: bool) -> void
        self.pos = self.pos + 1
        let count = array::pop(self.counts) catch 0
        let segment = array::pop(self.segments) catch ""
        if is_object then
            let keys = array::pop(self.keys) catch {}
        end
    end

    func ~separate(mut self: @) -> serialization::SerializationError!void
        let last = array::len(self.counts) - 1
        if self.counts[last] > 0 then
            try self.expect(',', JsonError.InvalidJson)
        end
        self.counts[last] = self.counts[last] + 1
    end

    func ~read_key(mut self: @, is_map_key: bool) -> serialization::SerializationError!string
        try self.separate()
        let name = try self.read_string()
        let last = array::len(self.keys) - 1
        if map::has(self.keys[last], name) then
            self.mark(name, is_map_key)
            self.fail(JsonError.DuplicateKey)
            return serialization::SerializationError.InvalidInput
        end
        self.keys[last][name] = true
        self.mark(name, is_map_key)
        try self.expect(':', JsonError.InvalidJson)
        return name
    end

    func ~mark(mut self: @, name: string, is_map_key: bool) -> void
        let last = array::len(self.segments) - 1
        if is_map_key or !is_identifier(name) then
            let quoted = quote(name) catch "\"\""
            self.segments[last] = "[${quoted}]"
            return
        end
        self.segments[last] = ".${name}"
    end

    func begin_struct(mut self: @, fields: int) -> serialization::SerializationError!void
        try self.open('{', true)
    end

    func next_field(mut self: @, fields: int) -> serialization::SerializationError!int
        for true do
            if self.peek() == '}' then
                self.close(true)
                return -1
            end
            let name = try self.read_key(false)
            let index = serialization::find_field(fields, name)
            if index >= 0 then
                return index
            end
            if self.should_reject_unknown_fields then
                self.fail(JsonError.UnknownField)
                return serialization::SerializationError.InvalidInput
            end
            try self.skip_value()
        end
        return -1
    end

    func missing_field(mut self: @, fields: int, index: int) -> serialization::SerializationError!void
        array::append(self.segments, ".${serialization::field_name(fields, index)}")
        self.fail(JsonError.MissingField)
        return serialization::SerializationError.InvalidInput
    end

    func begin_array(mut self: @) -> serialization::SerializationError!void
        try self.open('[', false)
    end

    func has_item(mut self: @) -> serialization::SerializationError!bool
        if self.peek() == ']' then
            self.close(false)
            return false
        end
        let last = array::len(self.counts) - 1
        self.segments[last] = "[${self.counts[last]}]"
        try self.separate()
        return true
    end

    func begin_map(mut self: @) -> serialization::SerializationError!void
        try self.open('{', true)
    end

    func next_key(mut self: @) -> serialization::SerializationError!?string
        if self.peek() == '}' then
            self.close(true)
            return null
        end
        return try self.read_key(true)
    end

    func read_variant(mut self: @, variants: int) -> serialization::SerializationError!int
        let name = try self.read_string()
        let index = serialization::find_variant(variants, name)
        if index < 0 then
            self.fail(JsonError.UnknownVariant)
            return serialization::SerializationError.InvalidInput
        end
        return index
    end

    func begin_union(mut self: @, variants: int) -> serialization::SerializationError!int
        try self.open('{', true)
        if self.peek() == '}' then
            self.fail(JsonError.InvalidUnion)
            return serialization::SerializationError.InvalidInput
        end
        let name = try self.read_key(false)
        let index = serialization::find_variant(variants, name)
        if index < 0 then
            self.fail(JsonError.UnknownVariant)
            return serialization::SerializationError.InvalidInput
        end
        return index
    end

    func end_union(mut self: @) -> serialization::SerializationError!void
        if self.peek() != '}' then
            self.fail(JsonError.InvalidUnion)
            return serialization::SerializationError.InvalidInput
        end
        self.close(true)
    end

    func end_document(mut self: @) -> serialization::SerializationError!void
        if self.peek() != 0 then
            self.fail(JsonError.InvalidJson)
            return serialization::SerializationError.InvalidInput
        end
    end

    func ~skip_value(mut self: @) -> serialization::SerializationError!void
        let c = self.peek()
        if c == '{' then
            try self.open('{', true)
            for self.peek() != '}' do
                let name = try self.read_key(false)
                try self.skip_value()
            end
            self.close(true)
            return
        end
        if c == '[' then
            try self.open('[', false)
            for try self.has_item() do
                try self.skip_value()
            end
            return
        end
        if c == '"' then
            let text = try self.read_string()
            return
        end
        if c == 't' or c == 'f' then
            let flag = try self.read_bool()
            return
        end
        if c == 'n' then
            try self.literal("null")
            return
        end
        let number = try self.number_text()
    end

    func ~describe(mut self: @, mut diagnostic: Diagnostic) -> void
        let path = string::join(self.segments)
        diagnostic.path = if string::starts_with(path, ".") then (string::slice(path, 1, string::len(path)) catch path) else path end
        let offset = if self.pos < buffer::len(self.data) then self.pos else buffer::len(self.data) end
        let mut line = 1
        let mut column = 1
        for 0..offset - 1: i do
            if self.data[i] == '\n' then
                line = line + 1
                column = 1
            else
                column = column + 1
            end
        end
        diagnostic.byte_offset = offset
        diagnostic.line = line
        diagnostic.column = column
    end
end

func ~is_identifier(name: string) -> bool
    if string::len(name) == 0 then
        return false
    end
    let data = buffer::from_string(name)
    for data: c, i do
        let is_letter = (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'
        let is_digit = c >= '0' and c <= '9' and i > 0
        if !is_letter and !is_digit then
            return false
        end
    end
    return true
end

struct Writer
    ~max_depth: int
    ~parts: []string = []
    ~counts: []int = []
    ~failure: ?JsonError = null

    func ~fail(mut self: @, failure: JsonError) -> void
        if self.failure == null then
            self.failure = failure
        end
    end

    func text(self: @) -> string
        return string::join(self.parts)
    end

    func write_int(mut self: @, value: int) -> serialization::SerializationError!void
        array::append(self.parts, "${value}")
    end

    func write_float(mut self: @, value: float) -> serialization::SerializationError!void
        let text = format_float(value) catch e then
            self.fail(e)
            return serialization::SerializationError.InvalidValue
        end
        array::append(self.parts, text)
    end

    func write_bool(mut self: @, value: bool) -> serialization::SerializationError!void
        array::append(self.parts, if value then "true" else "false" end)
    end

    func write_string(mut self: @, value: string) -> serialization::SerializationError!void
        let text = quote(value) catch e then
            self.fail(e)
            return serialization::SerializationError.InvalidValue
        end
        array::append(self.parts, text)
    end

    func write_null(mut self: @) -> serialization::SerializationError!void
        array::append(self.parts, "null")
    end

    func ~open(mut self: @, text: string) -> serialization::SerializationError!void
        if array::len(self.counts) >= self.max_depth then
            self.fail(JsonError.DepthExceeded)
            return serialization::SerializationError.InvalidValue
        end
        array::append(self.parts, text)
        array::append(self.counts, 0)
    end

    func ~close(mut self: @, text: string) -> void
        let count = array::pop(self.counts) catch 0
        array::append(self.parts, text)
    end

    func ~separate(mut self: @) -> void
        let last = array::len(self.counts) - 1
        if self.counts[last] > 0 then
            array::append(self.parts, ",")
        end
        self.counts[last] = self.counts[last] + 1
    end

    func ~name(mut self: @, text: string) -> serialization::SerializationError!void
        self.separate()
        try self.write_string(text)
        array::append(self.parts, ":")
    end

    func begin_struct(mut self: @, fields: int, count: int) -> serialization::SerializationError!void
        try self.open("{")
    end

    func field(mut self: @, fields: int, index: int) -> serialization::SerializationError!void
        try self.name(serialization::field_name(fields, index))
    end

    func end_struct(mut self: @) -> serialization::SerializationError!void
        self.close("}")
    end

    func begin_array(mut self: @, length: int) -> serialization::SerializationError!void
        try self.open("[")
    end

    func item(mut self: @, index: int) -> serialization::SerializationError!void
        self.separate()
    end

    func end_array(mut self: @) -> serialization::SerializationError!void
        self.close("]")
    end

    func begin_map(mut self: @, length: int) -> serialization::SerializationError!void
        try self.open("{")
    end

    func key(mut self: @, text: string) -> serialization::SerializationError!void
        try self.name(text)
    end

    func end_map(mut self: @) -> serialization::SerializationError!void
        self.close("}")
    end

    func write_variant(mut self: @, variants: int, index: int) -> serialization::SerializationError!void
        try self.write_string(serialization::variant_name(variants, index))
    end

    func begin_union(mut self: @, variants: int, index: int) -> serialization::SerializationError!void
        try self.open("{")
        try self.name(serialization::variant_name(variants, index))
    end

    func end_union(mut self: @) -> serialization::SerializationError!void
        self.close("}")
    end
end
