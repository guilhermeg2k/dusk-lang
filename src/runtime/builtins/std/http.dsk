error HttpError
    InvalidUrl
    UnsupportedScheme
    InvalidMethod
    InvalidHeader
    HostNotFound
    ConnectionRefused
    NetworkUnreachable
    TimedOut
    HandshakeFailed
    UntrustedCertificate
    ExpiredCertificate
    WrongHostCertificate
    InvalidCertificate
    ConnectionReset
    InvalidResponse
    HeadersTooLarge
    BodyTooLarge
    TooManyRedirects
    InvalidUtf8
    Closed
    InvalidRequest
    AddressInUse
    PermissionDenied
    ProxyRefused
    Other
end

struct Header
    name: string
    value: string
end

struct Headers
    ~items: []Header
    ~lowered: []string

    func get(self: @, name: string) -> ?string
        let wanted = string::lower(name)
        for self.lowered: lowered, index do
            if lowered == wanted then
                return self.items[index].value
            end
        end
        return null
    end

    func get_all(self: @, name: string) -> []string
        let wanted = string::lower(name)
        let mut values: []string = []
        for self.lowered: lowered, index do
            if lowered == wanted then
                append(values, self.items[index].value)
            end
        end
        return values
    end

    func has(self: @, name: string) -> bool
        return self.get(name) != null
    end

    func entries(self: @) -> []Header
        return copy(self.items)
    end

    func set(mut self: @, name: string, value: string) -> void
        self.remove(name)
        self.add(name, value)
    end

    func add(mut self: @, name: string, value: string) -> void
        append(self.items, Header(name = name, value = value))
        append(self.lowered, string::lower(name))
    end

    func remove(mut self: @, name: string) -> void
        let wanted = string::lower(name)
        let mut items: []Header = []
        let mut lowered: []string = []
        for self.lowered: existing, index do
            if existing != wanted then
                append(items, copy(self.items[index]))
                append(lowered, existing)
            end
        end
        self.items = items
        self.lowered = lowered
    end
end

struct Response
    status: int
    reason: string
    headers: Headers
    body: buffer
    url: string
    ~stream: ?func(mut BodyWriter) -> io::IoError!void = null
    ~stream_length: int = -1

    func text(self: @) -> HttpError!string
        return string::from_bytes(self.body) catch e then
            return HttpError.InvalidUtf8
        end
    end

    func is_success(self: @) -> bool
        return self.status >= 200 and self.status < 300
    end
end

struct ContentType
    let HTML = "text/html; charset=utf-8"
    let CSS = "text/css; charset=utf-8"
    let JS = "text/javascript; charset=utf-8"
    let JSON = "application/json"
    let TEXT = "text/plain; charset=utf-8"
    let CSV = "text/csv; charset=utf-8"
    let XML = "application/xml"
    let SVG = "image/svg+xml"
    let PNG = "image/png"
    let JPEG = "image/jpeg"
    let GIF = "image/gif"
    let WEBP = "image/webp"
    let ICO = "image/x-icon"
    let WASM = "application/wasm"
    let PDF = "application/pdf"
    let EVENT_STREAM = "text/event-stream"
    let FORM = "application/x-www-form-urlencoded"
    let BINARY = "application/octet-stream"
end

struct ResponseStream
    status: int
    reason: string
    headers: Headers
    url: string
    ~handle: int
    ~pool_key: string

    func read_bytes(mut self: @, max: int, timeout_ms: int = -1) -> io::IoError!?buffer
        return try stream_body_bytes(self.handle, max, timeout_ms)
    end

    func read_line(mut self: @, max: int = -1, timeout_ms: int = -1) -> io::IoError!?string
        return try stream_body_line(self.handle, max, timeout_ms)
    end

    func read_all(mut self: @, timeout_ms: int = -1) -> io::IoError!string
        return try stream_body_all(self.handle, timeout_ms)
    end

    func read_all_bytes(mut self: @, timeout_ms: int = -1) -> io::IoError!buffer
        return try stream_body_all_bytes(self.handle, timeout_ms)
    end

    func close(mut self: @) -> void
        pool_put(self.pool_key, self.handle)
    end
end

struct Server
    ~listener: net::TcpListener
    ~state: int
    ~max_body: int
    ~head_timeout_ms: int
    ~idle_timeout_ms: int
    ~write_timeout_ms: int
    ~max_connections: int
    ~compress: bool
    ~compression_level: int

    func port(self: @) -> int
        return self.listener.port()
    end

    func close(self: @) -> void
        server_close(self.state)
        self.listener.close()
    end

    func serve[E: error](self: @, handler: func(Request) -> E!Response) -> void
        let mut active = 0
        for true do
            let is_full = self.max_connections > 0 and active >= self.max_connections
            if is_full then
                if server_is_closing(self.state) then
                    break
                end
                task::sleep(1)
                continue
            end
            let conn = self.listener.accept() catch e then
                if e == io::IoError.Closed then
                    break
                end
                task::sleep(10)
                continue
            end
            active = active + 1
            spawn(func() -> void
                serve_connection(self, conn, handler)
                active = active - 1
            end)
        end
        for active > 0 do
            task::sleep(10)
        end
    end
end

struct BodyWriter
    ~handle: int
    ~state: int
    ~is_chunked: bool
    ~is_discarding: bool
    ~remaining: int
    ~pending: buffer
    ~used: int
    ~compressor: compression::Compressor
    ~is_compressing: bool

    func write(mut self: @, text: string) -> io::IoError!void
        let size = string::len(text)
        try self.make_room(size)
        if size > buffer::len(self.pending) then
            try self.send(buffer::from_string(text))
            return
        end
        self.used = buffer::put(self.pending, self.used, text) catch e then
            return io::IoError.Other
        end
    end

    func write_bytes(mut self: @, data: buffer) -> io::IoError!void
        let size = buffer::len(data)
        try self.make_room(size)
        if size > buffer::len(self.pending) then
            try self.send(data)
            return
        end
        self.used = buffer::put_bytes(self.pending, self.used, data) catch e then
            return io::IoError.Other
        end
    end

    func flush(mut self: @) -> io::IoError!void
        try self.send_pending()
        if !self.is_compressing then
            return
        end
        let packed = self.compressor.flush() catch e then
            return io::IoError.Other
        end
        try self.send_frame(packed)
    end

    func ~send_pending(mut self: @) -> io::IoError!void
        if self.used == 0 then
            return
        end
        let data = buffer::slice(self.pending, 0, self.used) catch e then
            return io::IoError.Other
        end
        self.used = 0
        try self.send(data)
    end

    func ~finish_body(mut self: @) -> io::IoError!void
        try self.send_pending()
        if !self.is_compressing then
            return
        end
        let packed = self.compressor.finish() catch e then
            return io::IoError.Other
        end
        try self.send_frame(packed)
    end

    func ~make_room(mut self: @, size: int) -> io::IoError!void
        let is_closed = self.is_discarding or server_is_closing(self.state)
        if is_closed then
            return io::IoError.Closed
        end
        if self.remaining >= 0 then
            if size > self.remaining then
                return io::IoError.Other
            end
            self.remaining = self.remaining - size
        end
        if self.used + size > buffer::len(self.pending) then
            try self.send_pending()
        end
    end

    func ~send(mut self: @, data: buffer) -> io::IoError!void
        if !self.is_compressing then
            try self.send_frame(data)
            return
        end
        let packed = self.compressor.write_bytes(data) catch e then
            return io::IoError.Other
        end
        try self.send_frame(packed)
    end

    func ~send_frame(mut self: @, data: buffer) -> io::IoError!void
        if buffer::len(data) == 0 then
            return
        end
        if !self.is_chunked then
            try stream_write_bytes(self.handle, data)
            return
        end
        let size_line = "${hex_text(buffer::len(data))}\r\n"
        let body_start = string::len(size_line)
        let mut framed = buffer::new(body_start + buffer::len(data) + 2) catch e then
            return io::IoError.Other
        end
        buffer::put(framed, 0, size_line) catch e then
            return io::IoError.Other
        end
        let body_end = buffer::put_bytes(framed, body_start, data) catch e then
            return io::IoError.Other
        end
        buffer::put(framed, body_end, "\r\n") catch e then
            return io::IoError.Other
        end
        try stream_write_bytes(self.handle, framed)
    end
end

struct Request
    method: string
    target: string
    path: string
    query: ?string
    headers: Headers
    remote_address: net::Address
    ~handle: int
    ~keeps_alive: bool
    ~max_body: int
    ~expects_continue: bool

    func query_param(self: @, name: string) -> ?string
        if self.query: text then
            let params = url::parse_query(text) catch e then
                return null
            end
            if params[name]: values then
                return values[0]
            end
        end
        return null
    end

    func text(self: @, timeout_ms: int = -1) -> HttpError!string
        let data = try self.bytes(timeout_ms)
        return string::from_bytes(data) catch e then
            return HttpError.InvalidUtf8
        end
    end

    func bytes(self: @, timeout_ms: int = -1) -> HttpError!buffer
        self.send_continue() catch e then
            return from_io(e)
        end
        return try stream_read_whole_body(self.handle, self.max_body, timeout_ms)
    end

    func read_bytes(self: @, max: int, timeout_ms: int = -1) -> io::IoError!?buffer
        try self.send_continue()
        return try stream_body_bytes(self.handle, max, timeout_ms)
    end

    func ~send_continue(self: @) -> io::IoError!void
        if self.expects_continue and claim_continue(self.handle) then
            try stream_write(self.handle, "HTTP/1.1 100 Continue\r\n\r\n")
        end
    end
end

extern func ~tcp_connect_handle(host: string, port: int, timeout_ms: int) -> net::NetError!int
extern func ~stream_start_tls(handle: int, host: string, ca: ?string, verify: bool, timeout_ms: int) -> net::NetError!void
extern func ~stream_write(handle: int, text: string) -> io::IoError!void
extern func ~stream_write_bytes(handle: int, data: buffer) -> io::IoError!void
extern func ~stream_set_write_timeout(handle: int, timeout_ms: int) -> void
extern func ~stream_close(handle: int) -> void
extern func ~stream_read_head(handle: int, is_head_request: bool, timeout_ms: int) -> HttpError!?buffer
extern func ~stream_read_whole_body(handle: int, cap: int, timeout_ms: int) -> HttpError!buffer
extern func ~stream_body_bytes(handle: int, max: int, timeout_ms: int) -> io::IoError!?buffer
extern func ~stream_body_line(handle: int, max: int, timeout_ms: int) -> io::IoError!?string
extern func ~stream_body_all(handle: int, timeout_ms: int) -> io::IoError!string
extern func ~stream_body_all_bytes(handle: int, timeout_ms: int) -> io::IoError!buffer
extern func ~parse_head(head: buffer, is_head_request: bool) -> HttpError![]string
extern func ~stream_decode_body(handle: int, format: compression::Format) -> void
extern func ~pool_take(key: string) -> int
extern func ~pool_put(key: string, handle: int) -> void
extern func ~conn_handle(conn: net::TcpConn) -> int
extern func ~stream_wait_data(handle: int, timeout_ms: int) -> io::IoError!?buffer
extern func ~stream_read_request_head(handle: int, timeout_ms: int) -> HttpError!?buffer
extern func ~stream_drain_request_body(handle: int, cap: int, timeout_ms: int) -> HttpError!buffer
extern func ~parse_request_head(head: buffer) -> HttpError![]string
extern func ~http_date() -> string
extern func ~claim_continue(handle: int) -> bool
