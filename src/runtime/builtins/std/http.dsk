import std/array: append, contains, len
import std/buffer
import std/io
import std/map
import std/net
import std/string
import std/time
import std/url

error HttpError
    InvalidUrl
    UnsupportedScheme
    InvalidMethod
    InvalidHeader
    HostNotFound
    ConnectionRefused
    NetworkUnreachable
    TimedOut
    HandshakeFailed
    UntrustedCertificate
    ExpiredCertificate
    WrongHostCertificate
    InvalidCertificate
    ConnectionReset
    InvalidResponse
    HeadersTooLarge
    BodyTooLarge
    TooManyRedirects
    InvalidUtf8
    Closed
    Other
end

struct Header
    name: string
    value: string
end

struct Headers
    ~items: []Header
    ~lowered: []string

    func get(self: @, name: string) -> ?string
        let wanted = string::lower(name)
        for self.lowered: lowered, index do
            if lowered == wanted then
                return self.items[index].value
            end
        end
        return null
    end

    func get_all(self: @, name: string) -> []string
        let wanted = string::lower(name)
        let mut values: []string = []
        for self.lowered: lowered, index do
            if lowered == wanted then
                append(values, self.items[index].value)
            end
        end
        return values
    end

    func has(self: @, name: string) -> bool
        return self.get(name) != null
    end

    func entries(self: @) -> []Header
        return copy(self.items)
    end
end

struct Response
    status: int
    reason: string
    headers: Headers
    body: buffer
    url: string

    func text(self: @) -> HttpError!string
        return string::from_bytes(self.body) catch e then
            return HttpError.InvalidUtf8
        end
    end

    func is_success(self: @) -> bool
        return self.status >= 200 and self.status < 300
    end
end

struct ResponseStream
    status: int
    reason: string
    headers: Headers
    url: string
    ~handle: int
    ~pool_key: string

    func read_bytes(mut self: @, max: int, timeout_ms: int = -1) -> io::IoError!?buffer
        return try stream_body_bytes(self.handle, max, timeout_ms)
    end

    func read_line(mut self: @, max: int = -1, timeout_ms: int = -1) -> io::IoError!?string
        return try stream_body_line(self.handle, max, timeout_ms)
    end

    func read_all(mut self: @, timeout_ms: int = -1) -> io::IoError!string
        return try stream_body_all(self.handle, timeout_ms)
    end

    func read_all_bytes(mut self: @, timeout_ms: int = -1) -> io::IoError!buffer
        return try stream_body_all_bytes(self.handle, timeout_ms)
    end

    func close(mut self: @) -> void
        pool_put(self.pool_key, self.handle)
    end
end

extern func ~tcp_connect_handle(host: string, port: int, timeout_ms: int) -> net::NetError!int
extern func ~stream_start_tls(handle: int, host: string, ca: ?string, verify: bool, timeout_ms: int) -> net::NetError!void
extern func ~stream_write(handle: int, text: string) -> io::IoError!void
extern func ~stream_write_bytes(handle: int, data: buffer) -> io::IoError!void
extern func ~stream_close(handle: int) -> void
extern func ~stream_read_head(handle: int, is_head_request: bool, timeout_ms: int) -> HttpError!?buffer
extern func ~stream_read_whole_body(handle: int, cap: int, timeout_ms: int) -> HttpError!buffer
extern func ~stream_body_bytes(handle: int, max: int, timeout_ms: int) -> io::IoError!?buffer
extern func ~stream_body_line(handle: int, max: int, timeout_ms: int) -> io::IoError!?string
extern func ~stream_body_all(handle: int, timeout_ms: int) -> io::IoError!string
extern func ~stream_body_all_bytes(handle: int, timeout_ms: int) -> io::IoError!buffer
extern func ~parse_head(head: buffer, is_head_request: bool) -> HttpError![]string
extern func ~gunzip(data: buffer, cap: int) -> HttpError!buffer
extern func ~pool_take(key: string) -> int
extern func ~pool_put(key: string, handle: int) -> void
extern func ~is_method(text: string) -> bool
extern func ~is_header_name(text: string) -> bool
extern func ~is_header_value(text: string) -> bool
extern func ~body_given_twice() -> void

let ~USER_AGENT = "dusk/0.16"
let ~REDIRECT_DRAIN_LIMIT = 65536

struct ~Exchange
    method: string
    headers: map[string, string]
    body: ?string
    body_bytes: ?buffer
    max_body: int
    timeout_ms: int
    started_ns: int
    ca: ?string
    verify: bool
    follows_redirects: bool
    reads_body: bool
end

struct ~Opened
    response: Response
    handle: int
    pool_key: string
end

func request(url: string, method: string = "GET", headers: map[string, string] = {}, body: ?string = null, body_bytes: ?buffer = null, query: map[string, string] = {}, timeout_ms: int = -1, max_redirects: int = 10, max_body: int = 67108864, ca: ?string = null, verify: bool = true) -> HttpError!Response
    let exchange = Exchange(method = method, headers = headers, body = body, body_bytes = body_bytes, max_body = max_body, timeout_ms = timeout_ms, started_ns = time::monotonic_ns(), ca = ca, verify = verify, follows_redirects = max_redirects > 0, reads_body = true)
    let opened = try start(url, query, exchange, max_redirects)
    return opened.response
end

func open(url: string, method: string = "GET", headers: map[string, string] = {}, body: ?string = null, body_bytes: ?buffer = null, query: map[string, string] = {}, timeout_ms: int = -1, max_redirects: int = 10, ca: ?string = null, verify: bool = true) -> HttpError!ResponseStream
    let exchange = Exchange(method = method, headers = headers, body = body, body_bytes = body_bytes, max_body = 0, timeout_ms = timeout_ms, started_ns = time::monotonic_ns(), ca = ca, verify = verify, follows_redirects = max_redirects > 0, reads_body = false)
    let opened = try start(url, query, exchange, max_redirects)
    let response = opened.response
    return ResponseStream(status = response.status, reason = response.reason, headers = response.headers, url = response.url, handle = opened.handle, pool_key = opened.pool_key)
end

func ~start(url: string, query: map[string, string], exchange: Exchange, max_redirects: int) -> HttpError!Opened
    if exchange.body != null and exchange.body_bytes != null then
        body_given_twice()
    end
    let target = try parse_target(url, query)
    if !is_method(exchange.method) then
        return HttpError.InvalidMethod
    end
    try check_headers(exchange.headers)
    return try follow(target, exchange, max_redirects)
end

func ~follow(target: url::Url, exchange: Exchange, redirects_left: int) -> HttpError!Opened
    let opened = try send(target, exchange)
    let response = opened.response
    let location = redirect_location(response, exchange) orelse ""
    if location == "" then
        return opened
    end
    if redirects_left == 0 then
        return HttpError.TooManyRedirects
    end
    let next = url::resolve(target, location) catch e then
        return HttpError.InvalidResponse
    end
    let is_http = next.scheme == "http" or next.scheme == "https"
    if !is_http then
        return HttpError.UnsupportedScheme
    end
    return try follow(next, redirected(exchange, response.status, is_same_origin(target, next)), redirects_left - 1)
end

func ~redirect_location(response: Response, exchange: Exchange) -> ?string
    if !exchange.follows_redirects or !is_redirect_status(response.status) then
        return null
    end
    return response.headers.get("location")
end

func ~is_redirect_status(status: int) -> bool
    return status == 301 or status == 302 or status == 303 or status == 307 or status == 308
end

func ~redirected(exchange: Exchange, status: int, is_same_origin: bool) -> Exchange
    let keeps_method = status == 307 or status == 308 or exchange.method == "HEAD"
    let becomes_get = !keeps_method and (status == 303 or exchange.method != "GET")
    let mut dropped: []string = []
    if becomes_get then
        append(dropped, "content-type")
        append(dropped, "content-length")
    end
    if !is_same_origin then
        append(dropped, "authorization")
        append(dropped, "cookie")
        append(dropped, "host")
    end
    let headers = without_headers(exchange.headers, dropped)
    if becomes_get then
        return Exchange(method = "GET", headers = headers, body = null, body_bytes = null, max_body = exchange.max_body, timeout_ms = exchange.timeout_ms, started_ns = exchange.started_ns, ca = exchange.ca, verify = exchange.verify, follows_redirects = true, reads_body = exchange.reads_body)
    end
    return Exchange(method = exchange.method, headers = headers, body = exchange.body, body_bytes = exchange.body_bytes, max_body = exchange.max_body, timeout_ms = exchange.timeout_ms, started_ns = exchange.started_ns, ca = exchange.ca, verify = exchange.verify, follows_redirects = true, reads_body = exchange.reads_body)
end

func ~without_headers(headers: map[string, string], dropped: []string) -> map[string, string]
    let mut kept: map[string, string] = {}
    for headers: value, name do
        if !contains(dropped, string::lower(name)) then
            kept[name] = value
        end
    end
    return kept
end

func ~is_same_origin(a: url::Url, b: url::Url) -> bool
    return a.scheme == b.scheme and a.host == b.host and port_of(a) == port_of(b)
end

func ~port_of(target: url::Url) -> int
    return target.port orelse (if target.scheme == "https" then 443 else 80 end)
end

func ~parse_target(text: string, query: map[string, string]) -> HttpError!url::Url
    let mut target = url::parse(text) catch e then
        return HttpError.InvalidUrl
    end
    let is_http = target.scheme == "http" or target.scheme == "https"
    if !is_http then
        return HttpError.UnsupportedScheme
    end
    if map::len(query) == 0 then
        return target
    end
    let extra = url::query(query)
    let existing = target.query orelse ""
    target.query = if existing == "" then extra else "$existing&$extra" end
    return target
end

func ~check_headers(headers: map[string, string]) -> HttpError!void
    for headers: value, name do
        let is_valid = is_header_name(name) and is_header_value(value)
        if !is_valid or string::lower(name) == "transfer-encoding" then
            return HttpError.InvalidHeader
        end
    end
end

func ~send(target: url::Url, exchange: Exchange) -> HttpError!Opened
    let key = pool_key_of(target, exchange)
    let reused = pool_take(key)
    if reused >= 0 then
        let answered = try exchange_on_reused(reused, target, exchange, key)
        if answered: opened then
            return opened
        end
    end
    let handle = try open_connection(target, exchange)
    return try exchange_on(handle, target, exchange, key)
end

func ~pool_key_of(target: url::Url, exchange: Exchange) -> string
    let origin = "${target.scheme}://${target.host}:${port_of(target)}"
    if target.scheme != "https" then
        return origin
    end
    return "$origin|${exchange.verify}|${exchange.ca orelse ""}"
end

func ~exchange_on_reused(handle: int, target: url::Url, exchange: Exchange, key: string) -> HttpError!?Opened
    let opened = exchange_on(handle, target, exchange, key) catch e then
        let can_retry = e == HttpError.ConnectionReset and is_idempotent(exchange.method)
        if can_retry then
            return null
        end
        return e
    end
    return opened
end

func ~is_idempotent(method: string) -> bool
    return method == "GET" or method == "HEAD" or method == "PUT" or method == "DELETE" or method == "OPTIONS"
end

func ~exchange_on(handle: int, target: url::Url, exchange: Exchange, key: string) -> HttpError!Opened
    let response = receive(handle, target, exchange) catch e then
        stream_close(handle)
        return e
    end
    let opened = Opened(response = response, handle = handle, pool_key = key)
    if is_followed(response.status, response.headers, exchange) then
        if drain(handle, exchange) then
            pool_put(key, handle)
        else
            stream_close(handle)
        end
        return opened
    end
    if exchange.reads_body then
        pool_put(key, handle)
    end
    return opened
end

func ~drain(handle: int, exchange: Exchange) -> bool
    stream_read_whole_body(handle, REDIRECT_DRAIN_LIMIT, remaining_ms(exchange)) catch e then
        return false
    end
    return true
end

func ~is_followed(status: int, headers: Headers, exchange: Exchange) -> bool
    return exchange.follows_redirects and is_redirect_status(status) and headers.has("location")
end

func ~open_connection(target: url::Url, exchange: Exchange) -> HttpError!int
    let is_tls = target.scheme == "https"
    let handle = tcp_connect_handle(target.host, port_of(target), remaining_ms(exchange)) catch e then
        return from_net(e)
    end
    if !is_tls then
        return handle
    end
    stream_start_tls(handle, target.host, exchange.ca, exchange.verify, remaining_ms(exchange)) catch e then
        stream_close(handle)
        return from_net(e)
    end
    return handle
end

func ~receive(handle: int, target: url::Url, exchange: Exchange) -> HttpError!Response
    stream_write(handle, request_head(target, exchange)) catch e then
        return from_io(e)
    end
    if exchange.body: text then
        stream_write(handle, text) catch e then
            return from_io(e)
        end
    end
    if exchange.body_bytes: data then
        stream_write_bytes(handle, data) catch e then
            return from_io(e)
        end
    end
    let is_head_request = exchange.method == "HEAD"
    let head = try stream_read_head(handle, is_head_request, remaining_ms(exchange))
    if head: received then
        let parts = try parse_head(received, is_head_request)
        let status = string::to_int(parts[0]) catch 0
        let headers = headers_of(parts)
        let skips_body = !exchange.reads_body or is_followed(status, headers, exchange)
        let body = if skips_body then buffer::from_string("") else try stream_read_whole_body(handle, exchange.max_body, remaining_ms(exchange)) end
        let is_gzip = asks_for_gzip(exchange) and is_gzip_encoding(headers.get("content-encoding") orelse "")
        let plain = if is_gzip and !skips_body then try gunzip(body, exchange.max_body) else body end
        return Response(status = status, reason = parts[1], headers = headers, body = plain, url = target.to_string())
    end
    return HttpError.ConnectionReset
end

func ~request_head(target: url::Url, exchange: Exchange) -> string
    let mut lines: []string = []
    let path = if target.query: query then "${target.path}?$query" else target.path end
    append(lines, "${exchange.method} $path HTTP/1.1")
    let mut given: map[string, bool] = {}
    for exchange.headers: value, name do
        let lowered = string::lower(name)
        given[lowered] = true
        if lowered != "content-length" then
            append(lines, "$name: $value")
        end
    end
    if !map::has(given, "host") then
        append(lines, "Host: ${host_header(target)}")
    end
    if !map::has(given, "user-agent") then
        append(lines, "User-Agent: $USER_AGENT")
    end
    if asks_for_gzip(exchange) then
        append(lines, "Accept-Encoding: gzip")
    end
    let length = body_length(exchange)
    if length >= 0 then
        append(lines, "Content-Length: $length")
    end
    return "${string::join(lines, "\r\n")}\r\n\r\n"
end

func ~asks_for_gzip(exchange: Exchange) -> bool
    if !exchange.reads_body or exchange.method == "HEAD" then
        return false
    end
    for exchange.headers: value, name do
        if string::lower(name) == "accept-encoding" then
            return false
        end
    end
    return true
end

func ~is_gzip_encoding(value: string) -> bool
    let encoding = string::lower(string::trim(value))
    return encoding == "gzip" or encoding == "x-gzip"
end

func ~host_header(target: url::Url) -> string
    let host = if string::contains(target.host, ":") then "[${target.host}]" else target.host end
    let default_port = if target.scheme == "https" then 443 else 80 end
    if target.port: port then
        if port != default_port then
            return "$host:$port"
        end
    end
    return host
end

func ~body_length(exchange: Exchange) -> int
    if exchange.body: text then
        return string::len(text)
    end
    if exchange.body_bytes: data then
        return buffer::len(data)
    end
    let needs_length = exchange.method == "POST" or exchange.method == "PUT" or exchange.method == "PATCH"
    return if needs_length then 0 else -1 end
end

func ~headers_of(parts: []string) -> Headers
    let mut items: []Header = []
    let mut lowered: []string = []
    let mut index = 2
    for index < len(parts) do
        append(items, Header(name = parts[index], value = parts[index + 1]))
        append(lowered, string::lower(parts[index]))
        index = index + 2
    end
    return Headers(items = items, lowered = lowered)
end

func ~remaining_ms(exchange: Exchange) -> int
    if exchange.timeout_ms < 0 then
        return -1
    end
    let left = exchange.timeout_ms - (time::monotonic_ns() - exchange.started_ns) // 1000000
    return if left > 0 then left else 0 end
end

func ~from_net(failure: net::NetError) -> HttpError
    return when failure
        net::NetError.HostNotFound then HttpError.HostNotFound end
        net::NetError.ConnectionRefused then HttpError.ConnectionRefused end
        net::NetError.NetworkUnreachable then HttpError.NetworkUnreachable end
        net::NetError.TimedOut then HttpError.TimedOut end
        net::NetError.HandshakeFailed then HttpError.HandshakeFailed end
        net::NetError.UntrustedCertificate then HttpError.UntrustedCertificate end
        net::NetError.ExpiredCertificate then HttpError.ExpiredCertificate end
        net::NetError.WrongHostCertificate then HttpError.WrongHostCertificate end
        net::NetError.InvalidCertificate then HttpError.InvalidCertificate end
        net::NetError.InvalidAddress then HttpError.InvalidUrl end
        else then HttpError.Other end
    end
end

func ~from_io(failure: io::IoError) -> HttpError
    return when failure
        io::IoError.Closed then HttpError.Closed end
        io::IoError.BrokenPipe then HttpError.ConnectionReset end
        io::IoError.ConnectionReset then HttpError.ConnectionReset end
        io::IoError.TimedOut then HttpError.TimedOut end
        io::IoError.HandshakeFailed then HttpError.HandshakeFailed end
        else then HttpError.Other end
    end
end
