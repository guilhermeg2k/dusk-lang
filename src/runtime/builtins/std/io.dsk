import std/buffer

error IoError
    Closed
    Busy
    BrokenPipe
    ConnectionReset
    LineTooLong
    InvalidUtf8
    TimedOut
    Other
end

extern func print(text: string) -> void
extern func println(text: string) -> void
extern func eprint(text: string) -> void
extern func eprintln(text: string) -> void
extern func ~stdin_handle() -> int
extern func ~stream_read_bytes(handle: int, max: int, timeout_ms: int) -> IoError!?buffer
extern func ~stream_read_line(handle: int, max: int, timeout_ms: int) -> IoError!?string
extern func ~stream_read_all(handle: int, timeout_ms: int) -> IoError!string
extern func ~stream_read_all_bytes(handle: int, timeout_ms: int) -> IoError!buffer
extern func ~is_terminal_fd(fd: int) -> bool
extern func ~stream_close(handle: int) -> void

struct Stdin
    ~handle: int

    func read_line(self: @, max: int = -1, timeout_ms: int = -1) -> IoError!?string
        return try stream_read_line(self.handle, max, timeout_ms)
    end

    func read_bytes(self: @, max: int, timeout_ms: int = -1) -> IoError!?buffer
        return try stream_read_bytes(self.handle, max, timeout_ms)
    end

    func read_all(self: @, timeout_ms: int = -1) -> IoError!string
        return try stream_read_all(self.handle, timeout_ms)
    end

    func read_all_bytes(self: @, timeout_ms: int = -1) -> IoError!buffer
        return try stream_read_all_bytes(self.handle, timeout_ms)
    end

    func is_terminal(self: @) -> bool
        return is_terminal_fd(0)
    end

    func close(self: @) -> void
        stream_close(self.handle)
    end
end

struct Stdout
    ~fd: int

    func is_terminal(self: @) -> bool
        return is_terminal_fd(self.fd)
    end
end

struct Stderr
    ~fd: int

    func is_terminal(self: @) -> bool
        return is_terminal_fd(self.fd)
    end
end

func stdin() -> Stdin
    return Stdin(handle = stdin_handle())
end

func stdout() -> Stdout
    return Stdout(fd = 1)
end

func stderr() -> Stderr
    return Stderr(fd = 2)
end
