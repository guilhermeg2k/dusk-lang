error ConversionError
    Invalid
    Overflow
end

error StringError
    OutOfRange
    NegativeCount
    InvalidUtf8
end

error ArrayError
    Empty
    OutOfRange
end

error BufferError
    NegativeSize
end

extern func echo(msgs: dynamic) -> void
extern func append[T](mut array: []T, value: T) -> void
extern func len[T](array: []T) -> int
extern func __array_pop[T](mut array: []T) -> T
extern func __array_insert[T](mut array: []T, index: int, value: T) -> void
extern func __array_remove[T](mut array: []T, index: int) -> T
extern func clear[T](mut array: []T) -> void
extern func index_of[T: int | float | byte | bool | string](array: []T, value: T) -> ?int
extern func contains[T: int | float | byte | bool | string](array: []T, value: T) -> bool
extern func str_len(text: string) -> int
extern func buffer_len(data: buffer) -> int
extern func __new_buffer(size: int) -> buffer
extern func __to_byte(value: int) -> byte
extern func to_float(value: int) -> float
extern func assert(cond: bool) -> void
extern func buffer_from(text: string) -> buffer
extern func string_from(data: buffer) -> StringError!string
extern func str_equal(a: string, b: string, ignore_case: bool = false) -> bool
extern func str_char_count(text: string) -> int
extern func str_concat(a: string, b: string) -> string
extern func str_join(parts: []string, sep: string = "") -> string
extern func str_to_int(text: string) -> ConversionError!int
extern func str_to_float(text: string) -> ConversionError!float
extern func copy[T](value: T) -> T
extern func str_find(text: string, needle: string) -> ?int
extern func str_contains(text: string, needle: string) -> bool
extern func str_starts_with(text: string, prefix: string) -> bool
extern func str_ends_with(text: string, suffix: string) -> bool
extern func str_count(text: string, needle: string) -> int
extern func str_byte_at(text: string, index: int) -> StringError!byte
extern func str_char_at(text: string, index: int) -> StringError!string
extern func str_trim(text: string) -> string
extern func str_split(text: string, separator: string) -> []string
extern func str_replace(text: string, old: string, new: string) -> string
extern func str_upper(text: string) -> string
extern func str_lower(text: string) -> string
extern func str_slice(text: string, start: int, stop: int) -> StringError!string
extern func str_repeat(text: string, count: int) -> StringError!string

func pop[T](mut array: []T) -> ArrayError!T
    if len(array) == 0 then return ArrayError.Empty end
    return __array_pop(array)
end

func pop_or_null[T](mut arr: []T) -> ?T
    return pop(arr) catch null
end

func insert[T](mut array: []T, index: int, value: T) -> ArrayError!void
    if index < 0 or index > len(array) then return ArrayError.OutOfRange end
    __array_insert(array, index, value)
end

func remove[T](mut array: []T, index: int) -> ArrayError!T
    if index < 0 or index >= len(array) then return ArrayError.OutOfRange end
    return __array_remove(array, index)
end

func reverse[T](mut array: []T) -> void
    let mut low = 0
    let mut high = len(array) - 1
    for low < high do
        let mut item = array[low]
        array[low] = array[high]
        array[high] = item
        low = low + 1
        high = high - 1
    end
end

func slice[T](array: []T, start: int, stop: int) -> ArrayError![]T
    if start < 0 or start > stop or stop > len(array) then return ArrayError.OutOfRange end
    let mut out: []T = []
    let mut i = start
    for i < stop do
        append(out, copy(array[i]))
        i = i + 1
    end
    return out
end

func new_buffer(size: int) -> BufferError!buffer
    if size < 0 then
        return BufferError.NegativeSize
    end
    return __new_buffer(size)
end

func to_byte(value: int) -> ConversionError!byte
    if value < 0 or value > 255 then
        return ConversionError.Overflow
    end
    return __to_byte(value)
end
