import std/io

enum Color
    Red
    Green
    Blue
end

union Shape
    circle: int
    square: int
end

func main() -> void
    let s = Shape(circle = 1)
    when s
        circle: r then io::println("${r}") end
        circle: x then io::println("${x}") end
        square: x then io::println("${x}") end
    end
end
