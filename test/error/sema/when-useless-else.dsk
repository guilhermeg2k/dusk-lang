import "std/io"

enum Color
    Red
    Green
    Blue
end

union Shape
    circle: int
    square: int
end

let c = Color.Red

func main() -> void
    when c
        Color.Red then io::println("${1}") end
        Color.Green, Color.Blue then io::println("${2}") end
        else then io::println("${3}") end
    end
end
