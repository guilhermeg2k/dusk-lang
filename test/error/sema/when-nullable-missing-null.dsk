import "std/io"

enum Color
    Red
    Green
    Blue
end

union Shape
    circle: int
    square: int
end

func main() -> void
    let c: ?Color = Color.Red
    when c
        Color.Red then io::println("${1}") end
        Color.Green then io::println("${2}") end
        Color.Blue then io::println("${3}") end
    end
end
