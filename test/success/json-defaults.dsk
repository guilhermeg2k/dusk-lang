import std/json
import std/io
import std/task

func make_name() -> string
    task::sleep(0)
    io::println("name")
    return "Ada"
end

func make_items() -> []int
    io::println("items")
    return [1, 2]
end

struct Item
    name: string = make_name()
    items: []int = make_items()
end

struct Group
    item: Item = Item()
end

func main() -> !void
    let first = try json::decode[Item]("{}")
    assert(first.name == "Ada")
    assert(first.items[1] == 2)
    let explicit = try json::decode[Item]("{\"name\":\"Bea\",\"items\":[4]}")
    assert(explicit.name == "Bea")
    assert(explicit.items[0] == 4)
    let group = try json::decode[Group]("{}")
    assert(group.item.name == "Ada")
    let mut items = try json::decode[[]Item]("[{},{}]")
    items[0].items[0] = 99
    assert(items[1].items[0] == 1)
    assert(first.items[0] == 1)
end
