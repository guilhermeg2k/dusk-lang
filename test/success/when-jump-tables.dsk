enum Op
    Add
    Sub
    Mul
    Div
    Mod
end

union Shape
    circle: int
    square: int
    line: int
    dot: int
end

func apply(op: Op, a: int, b: int) -> int
    when op
        Op.Add then return a + b end
        Op.Sub then return a - b end
        Op.Mul then return a * b end
        Op.Div then return a // b end
        Op.Mod then return a % b end
    end
end

func size(s: Shape) -> int
    when s
        circle: r then return r * 3 end
        square: side then return side * side end
        line: n then return n end
        dot: _ then return 0 end
    end
end

func grade(n: int) -> string
    return when n
        90..100 then "A" end
        80..89 then "B" end
        70..79 then "C" end
        0..69 then "F" end
        else then "?" end
    end
end

func digit(c: byte) -> int
    let mut out = -1
    when c
        '0' then out = 0 end
        '1' then out = 1 end
        '2' then out = 2 end
        '3' then out = 3 end
        else then out = -2 end
    end
    return out
end

func maybe(n: ?int) -> int
    let mut out = 0
    when n
        1 then out = 10 end
        2 then out = 20 end
        3 then out = 30 end
        4 then out = 40 end
        else then out = 99 end
    end
    return out
end

func maybe_null(n: ?int) -> int
    let mut out = 0
    when n
        null then out = -1 end
        1, 2, 3, 4 then out = 1 end
        else then out = 2 end
    end
    return out
end

func sparse(n: int) -> int
    let mut out = 0
    when n
        1 then out = 1 end
        1000 then out = 2 end
        -5000 then out = 3 end
        77777 then out = 4 end
        else then out = 5 end
    end
    return out
end

func nested(a: int, b: int) -> int
    when a
        1 then
            when b
                10 then return 110 end
                11 then return 111 end
                12 then return 112 end
                13 then return 113 end
                else then return 199 end
            end
        end
        2 then return 2 end
        3 then return 3 end
        4 then return 4 end
        else then return 9 end
    end
end

func main() -> void
    echo([apply(Op.Add, 7, 3), apply(Op.Sub, 7, 3), apply(Op.Mul, 7, 3), apply(Op.Div, 7, 3), apply(Op.Mod, 7, 3)])
    echo([size(Shape(circle = 2)), size(Shape(square = 3)), size(Shape(line = 9)), size(Shape(dot = 1))])
    echo([grade(95), grade(85), grade(75), grade(10), grade(101), grade(-1)])
    echo([digit('0'), digit('3'), digit('9')])
    echo([maybe(1), maybe(4), maybe(5), maybe(null)])
    echo([maybe_null(null), maybe_null(3), maybe_null(9)])
    echo([sparse(1), sparse(1000), sparse(-5000), sparse(77777), sparse(2)])
    echo([nested(1, 10), nested(1, 13), nested(1, 50), nested(2, 10), nested(4, 0), nested(7, 0)])
end
