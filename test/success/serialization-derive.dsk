import "std/serialization"
import "std/string"
import "std/buffer"
import "std/array"
import "std/task"

struct JsonReader
    text: string
    data: buffer
    pos: int = 0

    func skip_spaces(mut self: @) -> void
        for self.pos < buffer::len(self.data) do
            let c = self.data[self.pos]
            let is_space = c == ' ' or c == '\n' or c == '\t' or c == '\r'
            if !is_space then
                break
            end
            self.pos = self.pos + 1
        end
    end

    func peek(mut self: @) -> byte
        self.skip_spaces()
        if self.pos >= buffer::len(self.data) then
            return 0
        end
        return self.data[self.pos]
    end

    func expect(mut self: @, c: byte) -> serialization::SerializationError!void
        if self.peek() != c then
            return serialization::SerializationError.InvalidInput
        end
        self.pos = self.pos + 1
    end

    func read_int(mut self: @) -> serialization::SerializationError!int
        let mut is_negative = false
        if self.peek() == '-' then
            is_negative = true
            self.pos = self.pos + 1
        end
        let start = self.pos
        let mut number = 0
        for self.pos < buffer::len(self.data) do
            let c = self.data[self.pos]
            let is_digit = c >= '0' and c <= '9'
            if !is_digit then
                break
            end
            number = number * 10 + (c - '0')
            self.pos = self.pos + 1
        end
        if self.pos == start then
            return serialization::SerializationError.InvalidInput
        end
        if is_negative then
            return 0 - number
        end
        return number
    end

    func read_float(mut self: @) -> serialization::SerializationError!float
        self.skip_spaces()
        let start = self.pos
        for self.pos < buffer::len(self.data) do
            let c = self.data[self.pos]
            let is_number_part = (c >= '0' and c <= '9') or c == '.' or c == '-' or c == 'e' or c == 'E' or c == '+'
            if !is_number_part then
                break
            end
            self.pos = self.pos + 1
        end
        let text = string::slice(self.text, start, self.pos) catch "x"
        let number = string::to_float(text) catch e then
            return serialization::SerializationError.InvalidInput
        end
        return number
    end

    func read_bool(mut self: @) -> serialization::SerializationError!bool
        let c = self.peek()
        if c == 't' then
            self.pos = self.pos + 4
            return true
        end
        if c == 'f' then
            self.pos = self.pos + 5
            return false
        end
        return serialization::SerializationError.TypeMismatch
    end

    func read_string(mut self: @) -> serialization::SerializationError!string
        try self.expect('"')
        let start = self.pos
        for self.pos < buffer::len(self.data) and self.data[self.pos] != '"' do
            self.pos = self.pos + 1
        end
        let text = string::slice(self.text, start, self.pos) catch ""
        self.pos = self.pos + 1
        return text
    end

    func read_null(mut self: @) -> serialization::SerializationError!bool
        if self.peek() != 'n' then
            return false
        end
        self.pos = self.pos + 4
        return true
    end

    func begin_struct(mut self: @, fields: int) -> serialization::SerializationError!void
        try self.expect('{')
    end

    func next_field(mut self: @, fields: int) -> serialization::SerializationError!int
        for true do
            let c = self.peek()
            if c == '}' then
                self.pos = self.pos + 1
                return -1
            end
            if c == ',' then
                self.pos = self.pos + 1
            end
            try self.expect('"')
            let start = self.pos
            for self.pos < buffer::len(self.data) and self.data[self.pos] != '"' do
                self.pos = self.pos + 1
            end
            let stop = self.pos
            self.pos = self.pos + 1
            try self.expect(':')
            let index = serialization::find_field_in(fields, self.text, start, stop)
            if index >= 0 then
                return index
            end
            self.skip_value()
        end
        return -1
    end

    func missing_field(mut self: @, fields: int, index: int) -> serialization::SerializationError!void
        return serialization::SerializationError.MissingField
    end

    func begin_array(mut self: @) -> serialization::SerializationError!void
        try self.expect('[')
    end

    func has_item(mut self: @) -> serialization::SerializationError!bool
        let c = self.peek()
        if c == ']' then
            self.pos = self.pos + 1
            return false
        end
        if c == ',' then
            self.pos = self.pos + 1
        end
        return true
    end

    func skip_value(mut self: @) -> void
        self.skip_spaces()
        let mut depth = 0
        let mut is_in_string = false
        for self.pos < buffer::len(self.data) do
            let c = self.data[self.pos]
            if is_in_string then
                if c == '"' then
                    is_in_string = false
                end
                self.pos = self.pos + 1
                continue
            end
            let is_open = c == '{' or c == '['
            let is_close = c == '}' or c == ']'
            if c == '"' then
                is_in_string = true
            elif is_open then
                depth = depth + 1
            elif is_close then
                if depth == 0 then
                    return
                end
                depth = depth - 1
            elif c == ',' and depth == 0 then
                return
            end
            self.pos = self.pos + 1
        end
    end
    func begin_map(mut self: @) -> serialization::SerializationError!void
        try self.expect('{')
    end

    func next_key(mut self: @) -> serialization::SerializationError!?string
        let c = self.peek()
        if c == '}' then
            self.pos = self.pos + 1
            return null
        end
        if c == ',' then
            self.pos = self.pos + 1
        end
        let name = try self.read_string()
        try self.expect(':')
        return name
    end

    func read_variant(mut self: @, variants: int) -> serialization::SerializationError!int
        try self.expect('"')
        let start = self.pos
        for self.pos < buffer::len(self.data) and self.data[self.pos] != '"' do
            self.pos = self.pos + 1
        end
        let index = serialization::find_variant_in(variants, self.text, start, self.pos)
        self.pos = self.pos + 1
        if index < 0 then
            return serialization::SerializationError.UnknownVariant
        end
        return index
    end

    func begin_union(mut self: @, variants: int) -> serialization::SerializationError!int
        try self.expect('{')
        let index = try self.read_variant(variants)
        try self.expect(':')
        return index
    end

    func end_union(mut self: @) -> serialization::SerializationError!void
        try self.expect('}')
    end
end
func reader_for(text: string) -> JsonReader
    return JsonReader(text = text, data = buffer::from_string(text))
end

struct JsonWriter
    parts: []string = []
    map_counts: []int = []

    func write_int(mut self: @, value: int) -> serialization::SerializationError!void
        array::append(self.parts, "${value}")
    end

    func write_float(mut self: @, value: float) -> serialization::SerializationError!void
        array::append(self.parts, "${value}")
    end

    func write_bool(mut self: @, value: bool) -> serialization::SerializationError!void
        array::append(self.parts, if value then "true" else "false" end)
    end

    func write_string(mut self: @, value: string) -> serialization::SerializationError!void
        array::append(self.parts, "\"${value}\"")
    end

    func write_null(mut self: @) -> serialization::SerializationError!void
        array::append(self.parts, "null")
    end

    func begin_struct(mut self: @, fields: int, count: int) -> serialization::SerializationError!void
        array::append(self.parts, "{")
    end

    func field(mut self: @, fields: int, index: int) -> serialization::SerializationError!void
        if index > 0 then
            array::append(self.parts, ",")
        end
        array::append(self.parts, "\"${serialization::field_name(fields, index)}\":")
    end

    func end_struct(mut self: @) -> serialization::SerializationError!void
        array::append(self.parts, "}")
    end

    func begin_array(mut self: @, length: int) -> serialization::SerializationError!void
        array::append(self.parts, "[")
    end

    func item(mut self: @, index: int) -> serialization::SerializationError!void
        if index > 0 then
            array::append(self.parts, ",")
        end
    end

    func end_array(mut self: @) -> serialization::SerializationError!void
        array::append(self.parts, "]")
    end
    func begin_map(mut self: @, length: int) -> serialization::SerializationError!void
        array::append(self.parts, "{")
        array::append(self.map_counts, 0)
    end

    func key(mut self: @, name: string) -> serialization::SerializationError!void
        let last = array::len(self.map_counts) - 1
        if self.map_counts[last] > 0 then
            array::append(self.parts, ",")
        end
        self.map_counts[last] = self.map_counts[last] + 1
        array::append(self.parts, "\"${name}\":")
    end

    func end_map(mut self: @) -> serialization::SerializationError!void
        let count = array::pop(self.map_counts) catch 0
        array::append(self.parts, "}")
    end

    func write_variant(mut self: @, variants: int, index: int) -> serialization::SerializationError!void
        array::append(self.parts, "\"${serialization::variant_name(variants, index)}\"")
    end

    func begin_union(mut self: @, variants: int, index: int) -> serialization::SerializationError!void
        array::append(self.parts, "{\"${serialization::variant_name(variants, index)}\":")
    end

    func end_union(mut self: @) -> serialization::SerializationError!void
        array::append(self.parts, "}")
    end
end

func text_of(writer: JsonWriter) -> string
    return string::join(writer.parts)
end

enum Color
    Red
    Green
    Blue
end

enum Level
    Low = 1
    Medium = 2
    Mid = 2
end

struct Box
    side: byte
end

union Shape
    circle: int
    square: Box
    nothing: ?int
end

struct Scene
    colors: []Color
    shapes: []Shape
    labels: map[string, int]
    notes: map[string, ?string]
    level: Level
    nested: [][]int
    maybe_shape: ?Shape
    small: byte
end

struct Chain
    value: int
    next: ?Chain = null
end

func scene_error(text: string) -> ?serialization::SerializationError
    let mut reader = reader_for(text)
    let scene = serialization::decode[Scene, JsonReader](reader) catch e then
        return e
    end
    return null
end

func chain_error(text: string) -> ?serialization::SerializationError
    let mut reader = reader_for(text)
    let chain = serialization::decode[Chain, JsonReader](reader) catch e then
        return e
    end
    return null
end

struct NullableDefault
    count: ?int = 5
end

struct Branch
    left: ?Branch = null
    right: ?Branch = null
end

func main() -> !void
    let text = "{\"colors\": [\"Red\", \"Blue\"], \"shapes\": [{\"circle\": 3}, {\"square\": {\"side\": 200}}, {\"nothing\": null}], \"labels\": {\"a\": 1, \"b\": 2}, \"notes\": {\"x\": null, \"y\": \"why\"}, \"level\": \"Mid\", \"nested\": [[1, 2], [], [3]], \"maybe_shape\": null, \"small\": 7}"
    let mut reader = reader_for(text)
    let scene: Scene = try serialization::decode(reader)
    assert(scene.colors[1] == Color.Blue)
    assert(scene.level == Level.Medium)
    assert(scene.labels["b"] == 2)
    assert(scene.notes["y"] == "why")
    assert(scene.nested[2][0] == 3)
    assert(scene.small == 7)
    assert(scene.maybe_shape == null)
    if scene.shapes[1].square: found then
        assert(found.side == 200)
    else
        assert(false)
    end
    let mut writer = JsonWriter()
    try serialization::encode(scene, writer)
    let encoded = text_of(writer)
    assert(encoded == "{\"colors\":[\"Red\",\"Blue\"],\"shapes\":[{\"circle\":3},{\"square\":{\"side\":200}},{\"nothing\":null}],\"labels\":{\"a\":1,\"b\":2},\"notes\":{\"x\":null,\"y\":\"why\"},\"level\":\"Medium\",\"nested\":[[1,2],[],[3]],\"maybe_shape\":null,\"small\":7}")
    let mut again_reader = reader_for(encoded)
    let again: Scene = try serialization::decode(again_reader)
    let mut again_writer = JsonWriter()
    try serialization::encode(again, again_writer)
    assert(text_of(again_writer) == encoded)

    assert(scene_error("{\"small\": 300}") == serialization::SerializationError.OutOfRange)
    assert(scene_error("{\"level\": \"High\"}") == serialization::SerializationError.UnknownVariant)

    let mut null_reader = reader_for("null")
    let nothing: ?Box = try serialization::decode(null_reader)
    assert(nothing == null)
    let mut box_reader = reader_for("{\"side\": 9}")
    let some: ?Box = try serialization::decode(box_reader)
    assert(some?.side == 9)
    let mut int_reader = reader_for("42")
    assert((try serialization::decode[int, JsonReader](int_reader)) == 42)
    let mut list_reader = reader_for("[1, 2, 3]")
    let list: []int = try serialization::decode(list_reader)
    assert(array::len(list) == 3)
    let mut color_writer = JsonWriter()
    try serialization::encode(Color.Green, color_writer)
    assert(text_of(color_writer) == "\"Green\"")

    let mut default_omitted_reader = reader_for("{}")
    let omitted: NullableDefault = try serialization::decode(default_omitted_reader)
    assert(omitted.count == 5)
    let mut default_null_reader = reader_for("{\"count\": null}")
    let explicit_null: NullableDefault = try serialization::decode(default_null_reader)
    assert(explicit_null.count == null)

    let mut deep_parts: []string = []
    for 0..599: i do
        array::append(deep_parts, "{\"value\": 1, \"next\": ")
    end
    array::append(deep_parts, "null")
    for 0..599: i do
        array::append(deep_parts, "}")
    end
    assert(chain_error(string::join(deep_parts)) == serialization::SerializationError.DepthExceeded)

    let mut first = Chain(value = 1)
    let mut second = Chain(value = 2, next = first)
    first.next = second
    let mut cycle_writer = JsonWriter()
    let mut cycle_failed = false
    serialization::encode(first, cycle_writer) catch e then
        assert(e == serialization::SerializationError.CycleDetected)
        cycle_failed = true
    end
    assert(cycle_failed)

    let shared_leaf = Branch()
    let dag = Branch(left = shared_leaf, right = shared_leaf)
    let mut dag_writer = JsonWriter()
    try serialization::encode(dag, dag_writer)
    assert(text_of(dag_writer) == "{\"left\":{\"left\":null,\"right\":null},\"right\":{\"left\":null,\"right\":null}}")

    let mut fan = Branch()
    fan.left = fan
    fan.right = fan
    let mut fan_writer = JsonWriter()
    let mut fan_failed = false
    serialization::encode(fan, fan_writer) catch e then
        assert(e == serialization::SerializationError.CycleDetected)
        fan_failed = true
    end
    assert(fan_failed)
end
