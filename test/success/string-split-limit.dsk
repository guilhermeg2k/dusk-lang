import std/array
import std/string

func check(parts: []string, expected: []string) -> void
    assert(array::len(parts) == array::len(expected))
    for parts: part, index do
        assert(part == expected[index])
    end
end

func main() -> void
    check(string::split("a=b=c", "="), ["a", "b", "c"])
    check(string::split("a=b=c", "=", -1), ["a", "b", "c"])
    check(string::split("a=b=c", "=", -5), ["a", "b", "c"])
    assert(array::len(string::split("a=b=c", "=", 0)) == 0)
    assert(array::len(string::split("olá", "", 0)) == 0)
    check(string::split("a=b=c", "=", 2), ["a", "b=c"])
    check(string::split("a=b=c", "=", 1), ["a=b=c"])
    check(string::split("a=b=c", "=", 3), ["a", "b", "c"])
    check(string::split("a=b=c", "=", 100), ["a", "b", "c"])
    check(string::split("abc", "=", 2), ["abc"])
    check(string::split("", "=", 2), [""])
    check(string::split("=a==", "=", 3), ["", "a", "="])
    check(string::split("a=", "=", 2), ["a", ""])
    check(string::split("a::b::c", "::", 2), ["a", "b::c"])
    check(string::split("a🙂b🙂c", "🙂", 2), ["a", "b🙂c"])
    check(string::split("olá🙂", "", 2), ["o", "lá🙂"])
    check(string::split("olá🙂", "", 1), ["olá🙂"])
    check(string::split("olá🙂", "", 4), ["o", "l", "á", "🙂"])
    check(string::split("olá🙂", "", 100), ["o", "l", "á", "🙂"])
    assert(array::len(string::split("", "", 2)) == 0)
    check("a=b=c" |> string::split("=", 2), ["a", "b=c"])
    for 1..20000: i do
        let parts = string::split("key$i=value$i=rest", "=", 2)
        assert(parts[0] == "key$i")
        assert(parts[1] == "value$i=rest")
    end
end
