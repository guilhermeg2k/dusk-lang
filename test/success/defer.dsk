import "std/array": append, len
import "std/string"
import "std/task"
import "std/time"

error Oops
    Bad
    Worse
end

struct Log
    lines: []string = []

    func add(mut self: @, line: string) -> void
        append(self.lines, line)
    end

    func text(self: @) -> string
        return string::join(self.lines, sep = ",")
    end
end

struct Box
    value: int = 0
end

func order(mut log: Log) -> void
    log.add("start")
    defer log.add("first declared")
    defer log.add("second declared")
    if true then
        defer log.add("inner block")
        log.add("in block")
    end
    log.add("after block")
end

func returned_before_cleanup(mut box: Box) -> int
    box.value = 1
    defer box.value = 100
    return box.value
end

func read_at_exit(mut log: Log) -> void
    let mut step = "starting"
    defer log.add("stopped at $step")
    step = "loading"
    step = "saving"
end

func maybe(should_fail: bool) -> Oops!int
    if should_fail then
        return Oops.Bad
    end
    return 5
end

func steps(mut log: Log, should_fail: bool) -> Oops!int
    defer log.add("defer")
    errdefer log.add("errdefer")
    let value = try maybe(should_fail)
    log.add("value $value")
    return value
end

func returns_error(mut log: Log) -> Oops!void
    errdefer log.add("errdefer on return")
    defer log.add("defer on return")
    return Oops.Worse
end

func catch_paths(mut log: Log, gives_up: bool) -> Oops!int
    errdefer log.add("errdefer")
    defer log.add("defer")
    let value = maybe(true) catch e then
        if gives_up then
            return e
        end
        return 0
    end
    return value
end

func loops(mut log: Log) -> void
    defer log.add("function end")
    for 1..4: i do
        defer log.add("iteration $i done")
        if i == 2 then
            continue
        end
        if i == 4 then
            defer log.add("breaking")
            break
        end
        log.add("body $i")
    end
    let mut count = 0
    for count < 2 do
        count = count + 1
        defer log.add("while $count")
    end
end

func nested_loops(mut log: Log) -> void
    for 1..2: outer do
        defer log.add("outer $outer")
        for 1..3: inner do
            defer log.add("inner $outer.$inner")
            if inner == 2 then
                break
            end
        end
    end
end

func compound(mut log: Log, items: []string) -> void
    defer for items: item do
        if item == "stop" then
            break
        end
        log.add("cleanup $item")
    end
    defer if len(items) > 1 then
        log.add("many items")
    end
    log.add("working")
end

func shadowed(mut log: Log) -> void
    let name = "outer"
    defer log.add("defer sees $name")
    if true then
        let name = "inner"
        log.add("block has $name")
        return
    end
end

func branch_value(mut log: Log, flag: bool) -> int
    let result = if flag then
        defer log.add("branch cleanup")
        log.add("branch body")
        10
    else
        20
    end
    return result
end

func when_case(mut log: Log, n: int) -> void
    when n
        1 then
            defer log.add("case one done")
            log.add("case one")
        end
        else then
            log.add("other")
        end
    end
end

func lambda_scopes(mut log: Log) -> void
    defer log.add("outer function")
    let inner = func() -> int
        defer log.add("lambda cleanup")
        log.add("lambda body")
        return 3
    end
    log.add("lambda returned ${inner()}")
end

func lambda_errdefer(mut log: Log) -> !int
    let attempt = func(should_fail: bool) -> !int
        errdefer log.add("lambda errdefer")
        if should_fail then
            return Oops.Bad
        end
        return 1
    end
    let fine = try attempt(false)
    let failed = attempt(true) catch 0
    return fine + failed
end

func with_rollback[E: error, T](mut log: Log, work: func() -> E!T) -> E!T
    defer log.add("generic defer")
    errdefer log.add("generic errdefer")
    let value = try work()
    return value
end

func nested_errdefer(mut log: Log, fail_inside: bool, fail_after: bool) -> Oops!void
    errdefer log.add("outer errdefer")
    if true then
        errdefer log.add("inner errdefer")
        if fail_inside then
            return Oops.Bad
        end
        log.add("inner ok")
    end
    if fail_after then
        return Oops.Worse
    end
end

func nested_defer_and_lambda(mut log: Log) -> void
    defer if true then
        defer log.add("inner defer")
        let inner = func() -> Oops!void
            errdefer log.add("lambda inside defer errdefer")
            return Oops.Bad
        end
        inner() catch e then end
        log.add("outer defer body")
    end
    log.add("main body")
end

func if_capture_and_map_defer(mut log: Log, opt: ?string) -> void
    if opt: value then
        defer log.add("if_capture $value")
        log.add("saw $value")
    end
    let entries = { "a": 1, "b": 2 }
    for entries: v, k do
        defer log.add("map $k=$v")
    end
end

func catch_in_loop_defer(mut log: Log) -> void
    for 1..3: i do
        defer log.add("iter $i")
        let _ = maybe(i == 2) catch e then
            defer log.add("catch $i")
            if i == 2 then
                continue
            end
            return
        end
        log.add("ok $i")
    end
end

func gc_during_return_defer(mut log: Log) -> string
    let kept = string::concat("hello ", "world")
    defer if true then
        let mut garbage = ""
        for 1..250: i do
            garbage = string::concat(garbage, "x")
        end
        log.add("gc ${string::len(garbage)}")
    end
    return kept
end

func parked_defer(mut log: Log, should_fail: bool) -> Oops!int
    defer task::sleep(time::milliseconds(1))
    defer log.add("after sleep")
    errdefer log.add("err after sleep")
    let value = try maybe(should_fail)
    return value
end

func main() -> !void
    let mut log = Log()
    order(log)
    assert(log.text() == "start,in block,inner block,after block,second declared,first declared")

    let mut box = Box()
    assert(returned_before_cleanup(box) == 1)
    assert(box.value == 100)

    log = Log()
    read_at_exit(log)
    assert(log.text() == "stopped at saving")

    log = Log()
    assert(try steps(log, false) == 5)
    assert(log.text() == "value 5,defer")
    log = Log()
    assert((steps(log, true) catch -1) == -1)
    assert(log.text() == "errdefer,defer")

    log = Log()
    returns_error(log) catch e then
        assert(e == Oops.Worse)
    end
    assert(log.text() == "defer on return,errdefer on return")

    log = Log()
    assert((catch_paths(log, true) catch -1) == -1)
    assert(log.text() == "defer,errdefer")
    log = Log()
    assert(try catch_paths(log, false) == 0)
    assert(log.text() == "defer")

    log = Log()
    loops(log)
    assert(log.text() == "body 1,iteration 1 done,iteration 2 done,body 3,iteration 3 done,breaking,iteration 4 done,while 1,while 2,function end")

    log = Log()
    nested_loops(log)
    assert(log.text() == "inner 1.1,inner 1.2,outer 1,inner 2.1,inner 2.2,outer 2")

    log = Log()
    compound(log, ["a", "stop", "b"])
    assert(log.text() == "working,many items,cleanup a")

    log = Log()
    shadowed(log)
    assert(log.text() == "block has inner,defer sees outer")

    log = Log()
    assert(branch_value(log, true) == 10)
    assert(log.text() == "branch body,branch cleanup")

    log = Log()
    when_case(log, 1)
    when_case(log, 2)
    assert(log.text() == "case one,case one done,other")

    log = Log()
    lambda_scopes(log)
    assert(log.text() == "lambda body,lambda cleanup,lambda returned 3,outer function")

    log = Log()
    assert(try lambda_errdefer(log) == 1)
    assert(log.text() == "lambda errdefer")

    log = Log()
    let job = spawn(func() -> void
        defer log.add("task cleanup")
        log.add("task body")
    end)
    await(job)
    assert(log.text() == "task body,task cleanup")

    log = Log()
    let plain_res = with_rollback(log, func() -> int
        return 42
    end)
    assert(plain_res == 42)
    assert(log.text() == "generic defer")

    log = Log()
    let fail_res = with_rollback(log, func() -> Oops!int
        return Oops.Bad
    end) catch -1
    assert(fail_res == -1)
    assert(log.text() == "generic errdefer,generic defer")

    log = Log()
    nested_errdefer(log, true, false) catch e then
        assert(e == Oops.Bad)
    end
    assert(log.text() == "inner errdefer,outer errdefer")

    log = Log()
    nested_errdefer(log, false, true) catch e then
        assert(e == Oops.Worse)
    end
    assert(log.text() == "inner ok,outer errdefer")

    log = Log()
    nested_defer_and_lambda(log)
    assert(log.text() == "main body,lambda inside defer errdefer,outer defer body,inner defer")

    log = Log()
    if_capture_and_map_defer(log, "hi")
    assert(log.text() == "saw hi,if_capture hi,map a=1,map b=2")

    log = Log()
    catch_in_loop_defer(log)
    assert(log.text() == "ok 1,iter 1,catch 2,iter 2,ok 3,iter 3")

    log = Log()
    assert(gc_during_return_defer(log) == "hello world")
    assert(log.text() == "gc 250")

    log = Log()
    assert(try parked_defer(log, false) == 5)
    assert(log.text() == "after sleep")
    log = Log()
    assert((parked_defer(log, true) catch -1) == -1)
    assert(log.text() == "err after sleep,after sleep")
end
