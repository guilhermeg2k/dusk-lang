import std/array: len, append
import std/string
import std/buffer

func greeting() -> string
    return "hello"
end

struct Holder
    let shared = "static text"
    text: string
end

let local = "hello"

func main() -> !void
    assert(string::equal(local, greeting()))
    assert(string::equal("hello", "hello"))
    let mut kept: []string = []
    let holder = Holder(text = "field text")
    for 1..30000: i do
        let garbage = "number $i"
        let mut data = try buffer::new(32)
        data[0] = 1
        if i % 10000 == 0 then
            append(kept, "kept")
        end
    end
    assert(string::equal(local, greeting()))
    assert(string::equal(holder.text, "field text"))
    assert(string::equal(Holder.shared, "static text"))
    assert(len(kept) == 3)
    for kept: text do
        assert(string::equal(text, "kept"))
    end
    echo(local)
    echo(holder.text)
    echo(Holder.shared)
    echo(kept)
end
