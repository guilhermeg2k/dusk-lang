struct Bounds
    calls = 0
    upper = 3
end

func start(mut bounds: Bounds) -> int
    bounds.calls = bounds.calls + 1
    assert(bounds.calls == 1)
    return 1
end

func stop(mut bounds: Bounds) -> int
    bounds.calls = bounds.calls + 1
    assert(bounds.calls == 2)
    return bounds.upper
end

func main() -> void
    let mut bounds = Bounds()

    let mut total = 0

    for start(bounds)..stop(bounds): value do
        bounds.upper = 100
        total = total + value
    end

    assert(total == 6)
    assert(bounds.calls == 2)
    let mut upper = 4
    let mut lower = 2

    for lower..upper: value, index do
        lower = 99
        upper = 99
        assert(value == index + 2)
    end

    let mut visits = 0

    for 0..999: value do
        let pressure = [[value], [value + 1]]
        assert(pressure[0][0] == value)
        visits = visits + 1
    end

    assert(visits == 1000)
end
