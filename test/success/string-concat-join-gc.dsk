import std/array: append
import std/string

func main() -> void
    let mut kept: []string = []
    let mut total = 0
    for 1..20000: i do
        let mut parts: []string = []
        append(parts, "item")
        append(parts, "$i")
        append(parts, "end")
        let joined = string::join(parts, "-")
        let text = string::concat(joined, "!")
        total = total + string::len(text)
        if i % 5000 == 0 then
            append(kept, text)
        end
    end
    echo(string::join(kept, " | "))
    echo(total)
end
