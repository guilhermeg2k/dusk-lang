func main() -> void
    let mut kept: []string = []
    let mut total = 0
    for 1..20000: i do
        let mut parts: []string = []
        append(parts, "item")
        append(parts, "$i")
        append(parts, "end")
        let joined = str_join(parts, "-")
        let text = str_concat(joined, "!")
        total = total + str_len(text)
        if i % 5000 == 0 then
            append(kept, text)
        end
    end
    echo(str_join(kept, " | "))
    echo(total)
end
