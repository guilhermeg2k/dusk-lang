import std/array: len
import std/string

func repeat_reason(count: int) -> string
    let repeated = string::repeat("ab", count) catch e then
        return when e
            string::StringError.NegativeCount then "negative count" end
            else then "other" end
        end
    end
    return repeated
end

func main() -> !void
    echo("[${string::trim("  \t hello world \n\r")}]")
    echo("[${string::trim("   ")}]")
    echo("[${string::trim("none")}]")
    echo("[${string::trim("\u{0B}\u{0C}x\u{0C}")}]")
    echo("[${string::trim("\u{A0}x\u{A0}")}]")
    echo(string::split("a,b,,c", ","))
    echo(string::split("abc", ","))
    echo(len(string::split("", ",")))
    echo(string::split("a::b::c", "::"))
    echo(string::split("olá mundo", " "))
    echo(string::replace("a-b-c", "-", "+"))
    echo(string::replace("aaa", "a", "bb"))
    echo(string::replace("hello", "l", ""))
    echo(string::replace("abc", "z", "y"))
    echo(string::upper("hello, ação! ß ÿ × ÷ α"))
    echo(string::lower("HELLO, AÇÃO! Ž Ω"))
    echo(try string::repeat("ab", 3))
    echo("[${try string::repeat("ab", 0)}]")
    echo("[${try string::repeat("", 5)}]")
    echo(string::split("olá", ""))
    echo(len(string::split("", "")))
    echo(string::split("a,b", ","))
    echo(string::replace("abc", "", "x"))
    echo(repeat_reason(-1))
    echo(repeat_reason(2))
    echo("  a, b ,c  " |> string::trim() |> string::split(","))
end
