func repeat_reason(count: int) -> string
    let repeated = str_repeat("ab", count) catch e then
        return when e
            StringError.NegativeCount then "negative count" end
            else then "other" end
        end
    end
    return repeated
end

func main() -> !void
    echo("[${str_trim("  \t hello world \n\r")}]")
    echo("[${str_trim("   ")}]")
    echo("[${str_trim("none")}]")
    echo("[${str_trim("\u{0B}\u{0C}x\u{0C}")}]")
    echo("[${str_trim("\u{A0}x\u{A0}")}]")
    echo(str_split("a,b,,c", ","))
    echo(str_split("abc", ","))
    echo(len(str_split("", ",")))
    echo(str_split("a::b::c", "::"))
    echo(str_split("olá mundo", " "))
    echo(str_replace("a-b-c", "-", "+"))
    echo(str_replace("aaa", "a", "bb"))
    echo(str_replace("hello", "l", ""))
    echo(str_replace("abc", "z", "y"))
    echo(str_upper("hello, ação! ß ÿ × ÷ α"))
    echo(str_lower("HELLO, AÇÃO! Ž Ω"))
    echo(try str_repeat("ab", 3))
    echo("[${try str_repeat("ab", 0)}]")
    echo("[${try str_repeat("", 5)}]")
    echo(str_split("olá", ""))
    echo(len(str_split("", "")))
    echo(str_split("a,b", ","))
    echo(str_replace("abc", "", "x"))
    echo(repeat_reason(-1))
    echo(repeat_reason(2))
    echo("  a, b ,c  " |> str_trim() |> str_split(","))
end
