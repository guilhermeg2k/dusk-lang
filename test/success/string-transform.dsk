import std/array: len
import std/string
import std/io

func repeat_reason(count: int) -> string
    let repeated = string::repeat("ab", count) catch e then
        return when e
            string::StringError.NegativeCount then "negative count" end
            else then "other" end
        end
    end
    return repeated
end

func main() -> !void
    io::println("[${string::trim("  \t hello world \n\r")}]")
    io::println("[${string::trim("   ")}]")
    io::println("[${string::trim("none")}]")
    io::println("[${string::trim("\u{0B}\u{0C}x\u{0C}")}]")
    io::println("[${string::trim("\u{A0}x\u{A0}")}]")
    io::println("${string::split("a,b,,c", ",")}")
    io::println("${string::split("abc", ",")}")
    io::println("${len(string::split("", ","))}")
    io::println("${string::split("a::b::c", "::")}")
    io::println("${string::split("olá mundo", " ")}")
    io::println("${string::replace("a-b-c", "-", "+")}")
    io::println("${string::replace("aaa", "a", "bb")}")
    io::println("${string::replace("hello", "l", "")}")
    io::println("${string::replace("abc", "z", "y")}")
    io::println("${string::upper("hello, ação! ß ÿ × ÷ α")}")
    io::println("${string::lower("HELLO, AÇÃO! Ž Ω")}")
    io::println("${try string::repeat("ab", 3)}")
    io::println("[${try string::repeat("ab", 0)}]")
    io::println("[${try string::repeat("", 5)}]")
    io::println("${string::split("olá", "")}")
    io::println("${len(string::split("", ""))}")
    io::println("${string::split("a,b", ",")}")
    io::println("${string::replace("abc", "", "x")}")
    io::println("${repeat_reason(-1)}")
    io::println("${repeat_reason(2)}")
    io::println("${"  a, b ,c  " |> string::trim() |> string::split(",")}")
end
