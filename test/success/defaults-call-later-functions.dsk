import std/string

struct Config
    port: int = default_port()
    name: string = label("svc", 2)
    retries: int = triple(default_port() // 4000)
    pick: func(int) -> int = doubled
    safe: int = risky(true) catch 7
end

struct Point
    x: int = origin().x
    y: int = Origin().scaled(3)
    z: int = Limits.MAX
    name: string = Origin(x = 9).label()
end

func make(base: int = default_port(), text: string = label("p", 1)) -> string
    return "$text:$base"
end

func main() -> void
    let config = Config()
    assert(config.port == 8080)
    assert(config.name == "svc-2")
    assert(config.retries == 6)
    assert(config.pick(4) == 8)
    assert(config.safe == 7)
    let point = Point()
    assert(point.x == 5)
    assert(point.y == 15)
    assert(point.z == 99)
    assert(point.name == "origin 9")
    assert(make() == "p-1:8080")
    assert(make(1) == "p-1:1")
    assert(inline_twice(3) == 12)
end

func default_port() -> int
    return 8080
end

func label(prefix: string, n: int) -> string
    return "$prefix-$n"
end

func triple(n: int) -> int
    return n * 3
end

func doubled(n: int) -> int
    return n * 2
end

error Oops
    Bad
end

func risky(should_fail: bool) -> Oops!int
    if should_fail then
        return Oops.Bad
    end
    return 1
end

func origin() -> Origin
    return Origin()
end

func inline_twice(n: int) -> return doubled(doubled(n))

struct Origin
    x: int = 5

    func scaled(self: @, n: int) -> int
        return self.x * n
    end

    func label(self: @) -> string
        return "origin ${self.x}"
    end
end

struct Limits
    let MAX = 99
end
