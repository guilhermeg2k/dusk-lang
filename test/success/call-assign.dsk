import std/array: len

func id(n: int) -> int
    return n
end

func f(a: []int) -> int
    let mut out = 0
    let other = 5
    out = len(a)
    assert(other == 5)
    return out
end

func g() -> int
    let mut out = 0
    let other = 5
    out = id(7)
    out = id(out) + other
    return out
end

func main() -> void
    assert(f([1, 2, 3]) == 3)
    assert(g() == 12)
end
