import "std/io"

let name = "Dusk"
let age = 13
let a = 2
let b = 3
struct Calls
    count = 0
end

func next(mut calls: Calls) -> int
    calls.count = calls.count + 1
    return calls.count
end

func change(mut items: []int) -> int
    items[0] = 9
    return 7
end

func greet(who: string = "${"World"}!") -> string
    return "Hello, $who"
end

struct Box
    value: string = "${"default"}"
end

enum Color
    Red = 3
end

error Fault
    Bad
end

struct Pair
    value: int = 9
end

union Choice
    number: int
end

func main() -> void
    io::println("Hello, $name! You are $age years old.")
    io::println("Sum: ${a + b}")
    io::println("${name}${age}${a + b}")
    io::println("$name.length ${[10, 20][1]} ${if true then "yes" else "no" end}")
    io::println("Nested: ${"$name ${a + b}"}")
    io::println("Escaped: \$name \${a + b} \u{24}name $ $5")
    io::println("Backslash: \\$name; Unicode: 🌙 ${"\u{1F319}"}")
    io::println("${"#= } =#"}")
    io::println("Controls: ${"a\0b"}\n${"\t"}")
    let mut updated = "old"
    updated = "$updated!"
    io::println("${updated}")
    let mut calls = Calls()
    io::println("${next(calls)} ${next(calls)} ${next(calls)}")
    assert(calls.count == 3)
    let mut items = [1, 2]
    io::println("$items ${change(items)} $items")
    io::println("${greet()}")
    io::println("${Box().value}")
    let nullable_int: ?int = 7
    let nullable_float: ?float = 1.5
    let nullable_bool: ?bool = true
    let nullable_text: ?string = "text"
    let missing: ?int = null
    io::println("${true} ${1.5} ${null} $nullable_int $nullable_float $nullable_bool $nullable_text $missing")
    io::println("${Color.Red} ${Fault.Bad} ${[1, 2]} ${Pair()}")
    io::println("${Choice(number = 4)}")
end
