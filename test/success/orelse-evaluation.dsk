struct Calls
    source = 0
    fallback = 0
end

func source(mut calls: Calls, is_present: bool) -> ?int
    calls.source += 1
    return if is_present then
        5
    else
        null
    end
end

func fallback(mut calls: Calls) -> int
    calls.fallback += 1
    return 9
end

func main() -> void
    let mut calls = Calls()

    assert((source(calls, true) orelse fallback(calls)) == 5)
    assert(calls.source == 1)
    assert(calls.fallback == 0)
    assert((source(calls, false) orelse fallback(calls)) == 9)
    assert(calls.source == 2)
    assert(calls.fallback == 1)
    assert((source(calls, true) orelse source(calls, false) orelse fallback(calls)) == 5)
    assert(calls.source == 3)
    assert(calls.fallback == 1)
    source(calls, true) orelse fallback(calls)
    assert(calls.source == 4)
    assert(calls.fallback == 1)
    source(calls, false) orelse fallback(calls)
    assert(calls.source == 5)
    assert(calls.fallback == 2)
    let selected = (if source(calls, false) == null then
        null
    else
        null
    end) orelse fallback(calls)

    assert(selected == 9)
    assert(calls.source == 6)
    assert(calls.fallback == 3)
end
