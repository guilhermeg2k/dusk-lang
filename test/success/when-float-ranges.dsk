func classify(value: float) -> int
    return when value
        0.0..1.0, 2..3.5 then
            1
        end

        (-3.0)..(-1.0) then
            2
        end

        5.0..5.0 then
            3
        end

        else then
            0
        end
    end
end

assert(classify(0.0) == 1)
assert(classify(1.0) == 1)
assert(classify(1.5) == 0)
assert(classify(2.0) == 1)
assert(classify(3.5) == 1)
assert(classify(-3.0) == 2)
assert(classify(-1.0) == 2)
assert(classify(-4.0) == 0)
assert(classify(5.0) == 3)
assert(classify(0.0 / 0.0) == 0)
assert(classify(1.0 / 0.0) == 0)
assert(classify(-1.0 / 0.0) == 0)

func optional(value: ?float) -> int
    return when value
        null then
            0
        end

        0.0..1.0 then
            1
        end

        else then
            2
        end
    end
end

assert(optional(null) == 0)
assert(optional(0.5) == 1)
assert(optional(2.0) == 2)

func optional_else(value: ?float) -> int
    return when value
        0.0..1.0 then
            1
        end

        else then
            2
        end
    end
end

assert(optional_else(null) == 2)
assert(optional_else(0.5) == 1)

struct Calls
    let mut count = 0
end

func next_value() -> float
    Calls.count += 1
    return 0.5
end

when next_value()
    0.0..1.0 then
        assert(Calls.count == 1)
    end

    else then
        assert(false)
    end
end

assert(Calls.count == 1)
