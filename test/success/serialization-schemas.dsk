import std/serialization
import std/json
import std/string
import std/buffer
import std/array
import std/task

struct JsonReader
    text: string
    data: buffer
    pos: int = 0

    func skip_spaces(mut self: @) -> void
        for self.pos < buffer::len(self.data) do
            let c = self.data[self.pos]
            let is_space = c == ' ' or c == '\n' or c == '\t' or c == '\r'
            if !is_space then
                break
            end
            self.pos = self.pos + 1
        end
    end

    func peek(mut self: @) -> byte
        self.skip_spaces()
        if self.pos >= buffer::len(self.data) then
            return 0
        end
        return self.data[self.pos]
    end

    func expect(mut self: @, c: byte) -> serialization::SerializationError!void
        if self.peek() != c then
            return serialization::SerializationError.InvalidInput
        end
        self.pos = self.pos + 1
    end

    func read_int(mut self: @) -> serialization::SerializationError!int
        let mut is_negative = false
        if self.peek() == '-' then
            is_negative = true
            self.pos = self.pos + 1
        end
        let start = self.pos
        let mut number = 0
        for self.pos < buffer::len(self.data) do
            let c = self.data[self.pos]
            let is_digit = c >= '0' and c <= '9'
            if !is_digit then
                break
            end
            number = number * 10 + (c - '0')
            self.pos = self.pos + 1
        end
        if self.pos == start then
            return serialization::SerializationError.InvalidInput
        end
        if is_negative then
            return 0 - number
        end
        return number
    end

    func read_float(mut self: @) -> serialization::SerializationError!float
        self.skip_spaces()
        let start = self.pos
        for self.pos < buffer::len(self.data) do
            let c = self.data[self.pos]
            let is_number_part = (c >= '0' and c <= '9') or c == '.' or c == '-' or c == 'e' or c == 'E' or c == '+'
            if !is_number_part then
                break
            end
            self.pos = self.pos + 1
        end
        let text = string::slice(self.text, start, self.pos) catch "x"
        let number = string::to_float(text) catch e then
            return serialization::SerializationError.InvalidInput
        end
        return number
    end

    func read_bool(mut self: @) -> serialization::SerializationError!bool
        let c = self.peek()
        if c == 't' then
            self.pos = self.pos + 4
            return true
        end
        if c == 'f' then
            self.pos = self.pos + 5
            return false
        end
        return serialization::SerializationError.TypeMismatch
    end

    func read_string(mut self: @) -> serialization::SerializationError!string
        try self.expect('"')
        let start = self.pos
        for self.pos < buffer::len(self.data) and self.data[self.pos] != '"' do
            self.pos = self.pos + 1
        end
        let text = string::slice(self.text, start, self.pos) catch ""
        self.pos = self.pos + 1
        return text
    end

    func read_null(mut self: @) -> serialization::SerializationError!bool
        if self.peek() != 'n' then
            return false
        end
        self.pos = self.pos + 4
        return true
    end

    func begin_struct(mut self: @, fields: int) -> serialization::SerializationError!void
        try self.expect('{')
    end

    func next_field(mut self: @, fields: int) -> serialization::SerializationError!int
        for true do
            let c = self.peek()
            if c == '}' then
                self.pos = self.pos + 1
                return -1
            end
            if c == ',' then
                self.pos = self.pos + 1
            end
            try self.expect('"')
            let start = self.pos
            for self.pos < buffer::len(self.data) and self.data[self.pos] != '"' do
                self.pos = self.pos + 1
            end
            let stop = self.pos
            self.pos = self.pos + 1
            try self.expect(':')
            let index = serialization::find_field_in(fields, self.text, start, stop)
            if index >= 0 then
                return index
            end
            self.skip_value()
        end
        return -1
    end

    func missing_field(mut self: @, fields: int, index: int) -> serialization::SerializationError!void
        return serialization::SerializationError.MissingField
    end

    func begin_array(mut self: @) -> serialization::SerializationError!void
        try self.expect('[')
    end

    func has_item(mut self: @) -> serialization::SerializationError!bool
        let c = self.peek()
        if c == ']' then
            self.pos = self.pos + 1
            return false
        end
        if c == ',' then
            self.pos = self.pos + 1
        end
        return true
    end

    func skip_value(mut self: @) -> void
        self.skip_spaces()
        let mut depth = 0
        let mut is_in_string = false
        for self.pos < buffer::len(self.data) do
            let c = self.data[self.pos]
            if is_in_string then
                if c == '"' then
                    is_in_string = false
                end
                self.pos = self.pos + 1
                continue
            end
            let is_open = c == '{' or c == '['
            let is_close = c == '}' or c == ']'
            if c == '"' then
                is_in_string = true
            elif is_open then
                depth = depth + 1
            elif is_close then
                if depth == 0 then
                    return
                end
                depth = depth - 1
            elif c == ',' and depth == 0 then
                return
            end
            self.pos = self.pos + 1
        end
    end
    func begin_map(mut self: @) -> serialization::SerializationError!void
        try self.expect('{')
    end

    func next_key(mut self: @) -> serialization::SerializationError!?string
        let c = self.peek()
        if c == '}' then
            self.pos = self.pos + 1
            return null
        end
        if c == ',' then
            self.pos = self.pos + 1
        end
        let name = try self.read_string()
        try self.expect(':')
        return name
    end

    func read_variant(mut self: @, variants: int) -> serialization::SerializationError!int
        try self.expect('"')
        let start = self.pos
        for self.pos < buffer::len(self.data) and self.data[self.pos] != '"' do
            self.pos = self.pos + 1
        end
        let index = serialization::find_variant_in(variants, self.text, start, self.pos)
        self.pos = self.pos + 1
        if index < 0 then
            return serialization::SerializationError.UnknownVariant
        end
        return index
    end

    func begin_union(mut self: @, variants: int) -> serialization::SerializationError!int
        try self.expect('{')
        let index = try self.read_variant(variants)
        try self.expect(':')
        return index
    end

    func end_union(mut self: @) -> serialization::SerializationError!void
        try self.expect('}')
    end
end
func reader_for(text: string) -> JsonReader
    return JsonReader(text = text, data = buffer::from_string(text))
end

struct JsonWriter
    parts: []string = []
    map_counts: []int = []

    func write_int(mut self: @, value: int) -> serialization::SerializationError!void
        array::append(self.parts, "${value}")
    end

    func write_float(mut self: @, value: float) -> serialization::SerializationError!void
        array::append(self.parts, "${value}")
    end

    func write_bool(mut self: @, value: bool) -> serialization::SerializationError!void
        array::append(self.parts, if value then "true" else "false" end)
    end

    func write_string(mut self: @, value: string) -> serialization::SerializationError!void
        array::append(self.parts, "\"${value}\"")
    end

    func write_null(mut self: @) -> serialization::SerializationError!void
        array::append(self.parts, "null")
    end

    func begin_struct(mut self: @, fields: int, count: int) -> serialization::SerializationError!void
        array::append(self.parts, "{")
    end

    func field(mut self: @, fields: int, index: int) -> serialization::SerializationError!void
        if index > 0 then
            array::append(self.parts, ",")
        end
        array::append(self.parts, "\"${serialization::field_name(fields, index)}\":")
    end

    func end_struct(mut self: @) -> serialization::SerializationError!void
        array::append(self.parts, "}")
    end

    func begin_array(mut self: @, length: int) -> serialization::SerializationError!void
        array::append(self.parts, "[")
    end

    func item(mut self: @, index: int) -> serialization::SerializationError!void
        if index > 0 then
            array::append(self.parts, ",")
        end
    end

    func end_array(mut self: @) -> serialization::SerializationError!void
        array::append(self.parts, "]")
    end
    func begin_map(mut self: @, length: int) -> serialization::SerializationError!void
        array::append(self.parts, "{")
        array::append(self.map_counts, 0)
    end

    func key(mut self: @, name: string) -> serialization::SerializationError!void
        let last = array::len(self.map_counts) - 1
        if self.map_counts[last] > 0 then
            array::append(self.parts, ",")
        end
        self.map_counts[last] = self.map_counts[last] + 1
        array::append(self.parts, "\"${name}\":")
    end

    func end_map(mut self: @) -> serialization::SerializationError!void
        let count = array::pop(self.map_counts) catch 0
        array::append(self.parts, "}")
    end

    func write_variant(mut self: @, variants: int, index: int) -> serialization::SerializationError!void
        array::append(self.parts, "\"${serialization::variant_name(variants, index)}\"")
    end

    func begin_union(mut self: @, variants: int, index: int) -> serialization::SerializationError!void
        array::append(self.parts, "{\"${serialization::variant_name(variants, index)}\":")
    end

    func end_union(mut self: @) -> serialization::SerializationError!void
        array::append(self.parts, "}")
    end
end

func text_of(writer: JsonWriter) -> string
    return string::join(writer.parts)
end

schema Api(case = "snake")
    struct Address
        zipCode: "postcode"
    end
end

schema Db end

schema Shout(case = "pascal") end

schema Dashes(case = "kebab") end

schema Humps(case = "camel") end

struct Address
    zipCode: string
    cityName: string
end

enum Status
    Active
    OnHold

    schema Api
        OnHold: "on-hold"
    end
end

union Contact
    email: string
    phone: string

    schema Api
        phone: "tel"
    end
end

struct User
    userId: int
    displayName: string
    password: string = "secret"
    nickname: ?string = null
    status: Status
    contact: Contact
    address: Address

    schema Api
        userId: "user_id", "legacy_id"
        password: skip
        nickname: omit_null
    end

    schema Db
        userId: "id"
    end
end

struct Names
    userID: int
    HTTPServer: int
    line2: int
    already_snake: int
end

func to_json[T, S: schema](value: T) -> json::JsonError!string
    return try json::encode[T, S](value)
end

func derived_text[S: schema](user: User) -> serialization::SerializationError!string
    let mut writer = JsonWriter()
    try serialization::encode[User, JsonWriter, S](user, writer)
    return text_of(writer)
end

func name_list[S: schema]() -> string
    let plan = serialization::plan_of[Names, S]()
    let mut parts: []string = []
    for 0..serialization::field_count(plan) - 1: i do
        array::append(parts, serialization::field_name(plan, i))
    end
    return string::join(parts, " ")
end

func json_error(text: string) -> ?json::JsonError
    let user = json::decode[User, Api](text) catch e then
        return e
    end
    return null
end

func derived_error(text: string) -> ?serialization::SerializationError
    let mut reader = reader_for(text)
    let user = serialization::decode[User, JsonReader, Api](reader) catch e then
        return e
    end
    return null
end

func main() -> !void
    let user = User(userId = 7, displayName = "Ada", password = "hunter2", status = Status.OnHold, contact = Contact(phone = "555"), address = Address(zipCode = "N1", cityName = "London"))
    let api_text = "{\"user_id\":7,\"display_name\":\"Ada\",\"status\":\"on-hold\",\"contact\":{\"tel\":\"555\"},\"address\":{\"postcode\":\"N1\",\"city_name\":\"London\"}}"
    assert((try json::encode[User, Api](user)) == api_text)
    assert((try to_json[User, Api](user)) == api_text)
    assert((try derived_text[Api](user)) == api_text)

    let plain = try json::encode(user)
    assert(plain == "{\"userId\":7,\"displayName\":\"Ada\",\"password\":\"hunter2\",\"nickname\":null,\"status\":\"OnHold\",\"contact\":{\"phone\":\"555\"},\"address\":{\"zipCode\":\"N1\",\"cityName\":\"London\"}}")
    let mut plain_writer = JsonWriter()
    try serialization::encode(user, plain_writer)
    assert(text_of(plain_writer) == plain)
    assert((try json::encode[User, Db](user)) == "{\"id\":7,\"displayName\":\"Ada\",\"password\":\"hunter2\",\"nickname\":null,\"status\":\"OnHold\",\"contact\":{\"phone\":\"555\"},\"address\":{\"zipCode\":\"N1\",\"cityName\":\"London\"}}")

    let mut named = copy(user)
    named.nickname = "Countess"
    assert((try json::encode[User, Api](named)) == "{\"user_id\":7,\"display_name\":\"Ada\",\"nickname\":\"Countess\",\"status\":\"on-hold\",\"contact\":{\"tel\":\"555\"},\"address\":{\"postcode\":\"N1\",\"city_name\":\"London\"}}")

    let legacy = "{\"legacy_id\":9,\"display_name\":\"Bo\",\"status\":\"active\",\"contact\":{\"email\":\"b@x\"},\"address\":{\"postcode\":\"P\",\"city_name\":\"Porto\"}}"
    let decoded = try json::decode[User, Api](legacy)
    assert(decoded.userId == 9 and decoded.password == "secret" and decoded.status == Status.Active)
    assert(decoded.address.zipCode == "P")
    let mut reader = reader_for(legacy)
    let derived = try serialization::decode[User, JsonReader, Api](reader)
    assert(derived.userId == 9 and derived.password == "secret" and derived.address.cityName == "Porto")

    let both = "{\"user_id\":1,\"legacy_id\":2,\"display_name\":\"C\",\"status\":\"active\",\"contact\":{\"email\":\"c\"},\"address\":{\"postcode\":\"x\",\"city_name\":\"y\"}}"
    assert(json_error(both) == json::JsonError.DuplicateKey)
    assert(derived_error(both) == serialization::SerializationError.DuplicateField)

    assert(serialization::plan_of[User, Api]() != serialization::plan_of[User]())
    assert(name_list[Api]() == "user_id http_server line2 already_snake")
    assert(name_list[Shout]() == "UserId HttpServer Line2 AlreadySnake")
    assert(name_list[Dashes]() == "user-id http-server line2 already-snake")
    assert(name_list[Humps]() == "userId httpServer line2 alreadySnake")
    assert(name_list[Db]() == "userID HTTPServer line2 already_snake")
end
