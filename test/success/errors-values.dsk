error ParseError
    Empty
    BadDigit
end

error IoError
    NotFound
end

let e = ParseError.Empty

struct Report
    code: ParseError
    cause: ?IoError
end

func same(a: ParseError, b: ParseError) -> bool
    return a == b
end

func pick(is_first: bool) -> ParseError
    if is_first then
        return ParseError.Empty
    end
    return ParseError.BadDigit
end

func main() -> void
    let mut last: ParseError = ParseError.BadDigit
    assert(e == ParseError.Empty)
    assert(e != last)
    last = ParseError.Empty
    assert(e == last)
    assert(ParseError.Empty != IoError.NotFound)

    let r = Report(code = ParseError.BadDigit, cause = null)
    assert(r.code == ParseError.BadDigit)
    assert(r.cause == null)

    let r2 = Report(code = ParseError.Empty, cause = IoError.NotFound)
    if r2.cause: c then
        assert(c == IoError.NotFound)
    else
        assert(false)
    end

    let list = [ParseError.Empty, ParseError.BadDigit]
    assert(list[1] == ParseError.BadDigit)
    assert(len(list) == 2)

    assert(same(ParseError.Empty, ParseError.Empty))
    assert(!same(ParseError.Empty, ParseError.BadDigit))

    assert(pick(false) == ParseError.BadDigit)
    echo(ParseError.Empty)
    echo(IoError.NotFound)
end
