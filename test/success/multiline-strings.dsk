import "std/io"

func usage(name: string) -> string
    return """
        Usage: $name <file>
          -h  show ${1 + 1} "help"
      
        quote: \""" done
        """
end

func main() -> void
    io::println("${usage("dusk")}")
    io::println("[${"""
    """}]")
    let x = """
        a

        """
    io::println("[$x]")
    io::println("[${"""
        ${when 2
            1 then "one" end
            else then "other" end
        end} tail
        """}]")
    if true then
        let kept = """
                kept
                indent
            """
        io::println("[$kept]")
    end
end
