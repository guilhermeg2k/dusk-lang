import std/string

let name = "olá"

func main() -> void
    assert(string::len(name) == 4)
    assert(string::char_count(name) == 3)
    assert(string::len("") == 0)
    assert(string::char_count("") == 0)
    assert(string::len("🌙") == 4)
    assert(string::char_count("🌙") == 1)
    assert(string::char_count("a🌙é\n") == 4)
    assert(string::len("x${name}y") == 6)
    assert((name |> string::char_count()) == 3)
    let maybe: ?string = "abc"
    if maybe: text then
        assert(string::len(text) == 3)
    end
    echo(string::len(name))
    echo(string::char_count(name))
end
