    try check(9223340654534400000, "+292278000-02-29T00:00:00.000Z")
    let current = time::now()
    let difference = time::to_unix_ms(current) - time::now_ms()
    assert(difference > -60000 and difference < 60000)
    let info = try fs::stat("test/fixtures/fs/hello.txt")
    let modified = time::from_unix_ms(info.modified_ms)
    assert(time::to_unix_ms(modified) == info.modified_ms)
    let mut kept: []time::Timestamp = []
    for 1..20000: i do
        let mut timestamp = time::from_unix_ms(i - 10000)
        assert((try time::to_iso_string(timestamp)) == (try time::to_iso_string(time::from_unix_ms(i - 10000))))
        if i % 5000 == 0 then
            array::append(kept, timestamp)
        end
    end
    assert((try time::to_iso_string(kept[0])) == "1969-12-31T23:59:55.000Z")
    assert((try time::to_iso_string(kept[3])) == "1970-01-01T00:00:10.000Z")
end
