import "std/time"
import "std/fs"
import "std/array"

func check(milliseconds: int, expected: string) -> !void
    let timestamp = time::from_unix_ms(milliseconds)
    assert(time::to_unix_ms(timestamp) == milliseconds)
    assert((try time::to_iso_string(timestamp)) == expected)
    assert((try time::to_iso_string(timestamp)) == expected)
    assert(time::to_utc_iso_string(timestamp) == expected)
    assert(time::to_unix_ms(try time::from_iso_string(expected)) == milliseconds)
end

func main() -> !void
    try check(0, "1970-01-01T00:00:00.000Z")
    try check(-1, "1969-12-31T23:59:59.999Z")
    try check(1, "1970-01-01T00:00:00.001Z")
    try check(999, "1970-01-01T00:00:00.999Z")
    try check(1000, "1970-01-01T00:00:01.000Z")
    try check(-999, "1969-12-31T23:59:59.001Z")
    try check(-1000, "1969-12-31T23:59:59.000Z")
    try check(-1001, "1969-12-31T23:59:58.999Z")
    try check(86400000, "1970-01-02T00:00:00.000Z")
    try check(-86400000, "1969-12-31T00:00:00.000Z")
    try check(-86400001, "1969-12-30T23:59:59.999Z")
    try check(-9223372036854775807 - 1, "-292275055-05-16T16:47:04.192Z")
    try check(9223372036854775807, "+292278994-08-17T07:12:55.807Z")
    try check(-9223370312889600001, "-292275000-01-01T23:59:59.999Z")
