import std/string

let text = "olá, mundo"
func slice_or_reason(text: string, start: int, stop: int) -> string
    let piece = string::slice(text, start, stop) catch e then
        return when e
            string::StringError.OutOfRange then "out of range" end
            else then "other" end
        end
    end
    return piece
end

func main() -> !void
    echo(try string::slice(text, 0, 2))
    echo(try string::slice(text, 0, 4))
    echo(try string::slice(text, 6, string::len(text)))
    echo("[${try string::slice(text, 4, 4)}]")
    echo("[${try string::slice("", 0, 0)}]")
    let comma = string::find(text, ",") orelse 0
    echo(try string::slice(text, 0, comma))
    echo(slice_or_reason(text, -1, 2))
    echo(slice_or_reason(text, 3, 2))
    echo(slice_or_reason(text, 0, 99))
    echo(slice_or_reason(text, 0, 3))
    echo(slice_or_reason(text, 3, 4))
    echo(slice_or_reason(text, 2, 4))
end
