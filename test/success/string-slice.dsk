import "std/string"
import "std/io"

let text = "olá, mundo"
func slice_or_reason(text: string, start: int, stop: int) -> string
    let piece = string::slice(text, start, stop) catch e then
        return when e
            string::StringError.OutOfRange then "out of range" end
            else then "other" end
        end
    end
    return piece
end

func main() -> !void
    io::println("${try string::slice(text, 0, 2)}")
    io::println("${try string::slice(text, 0, 4)}")
    io::println("${try string::slice(text, 6, string::len(text))}")
    io::println("[${try string::slice(text, 4, 4)}]")
    io::println("[${try string::slice("", 0, 0)}]")
    let comma = string::find(text, ",") orelse 0
    io::println("${try string::slice(text, 0, comma)}")
    io::println("${slice_or_reason(text, -1, 2)}")
    io::println("${slice_or_reason(text, 3, 2)}")
    io::println("${slice_or_reason(text, 0, 99)}")
    io::println("${slice_or_reason(text, 0, 3)}")
    io::println("${slice_or_reason(text, 3, 4)}")
    io::println("${slice_or_reason(text, 2, 4)}")
end
