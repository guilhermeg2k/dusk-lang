import std/array: len, append

struct Point
    x: int
    y: int
end

func make_builder(prefix: string) -> func(int) -> string
    let mut parts: []string = []
    return func(n: int) -> string
        let mut junk: []Point = []
        for 1..50: k do
            append(junk, Point(x = k, y = n))
        end
        append(parts, "$prefix$n")
        let text = parts[len(parts) - 1]
        return "$text ${len(parts)} ${junk[49].x}"
    end
end

func main() -> void
    let build = make_builder("item")
    let mut last = ""
    for 1..20000: i do
        last = build(i)
    end
    assert(last == "item20000 20000 50")

    let mut fns: []func() -> string = []
    for 1..5000: i do
        let label = "label $i"
        let mut hits = [i]
        append(fns, func() -> string
            append(hits, i)
            return "$label ${len(hits)}"
        end)
    end
    let mut garbage: [][]int = []
    for 1..20000: i do
        append(garbage, [i, i, i, i])
    end
    assert(fns[0]() == "label 1 2")
    assert(fns[4999]() == "label 5000 2")
    assert(fns[4999]() == "label 5000 3")

    let mut count = 0
    let mut points: []Point = []
    let track = func(mut p: Point) -> void
        count = count + p.x
        append(points, p)
    end
    for 1..30000: i do
        track(Point(x = 1, y = i))
    end
    assert(count == 30000)
    assert(points[29999].y == 30000)
end
