struct P
    x: int
    func set(mut self: @, v: int) -> void
        self.x = v
    end
end
struct Box
    items: []int
    p: P
    func grow(mut self: @) -> void
        append(self.items, 1)
        self.items[0] = 7
        self.p.x = 3
        self.p.set(4)
    end
end
struct S
    let mut items = [1, 2]
    let mut cfg = P(x = 1)
end
enum E
    let mut list = [1]
    a
end
func mutate(mut a: []int) -> void
    append(a, 9)
end
func g(mut p: P) -> void
    p.x = 10
end
let mut bx = Box(items = [1], p = P(x = 1))
bx.grow()
bx.p.x = 5
mutate(bx.items)
g(bx.p)
assert(bx.p.x == 10)
assert(len(bx.items) == 3)
S.items[0] = 5
S.cfg.x = 6
S.cfg.set(7)
mutate(S.items)
assert(S.cfg.x == 7)
assert(S.items[0] == 5)
E.list[0] = 2
append(E.list, 3)
let mut ps = [P(x = 1)]
ps[0].x = 2
ps[0].set(3)
mutate([1])
let mut maybe: ?P = P(x = 1)
if maybe: mut q then
    q.x = 4
end
let numbers = [1, 2]
let point = P(x = 1)
let built = Box(items = numbers, p = point)
assert(built.p.x == 1)
assert(len(built.items) == 2)
