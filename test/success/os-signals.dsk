import "std/os"
import "std/task"
import "std/time"

func await_close(subscription: os::SignalStream) -> !bool
    subscription.wait() catch e then
        assert(e == os::OsError.Closed)
        return true
    end
    return false
end

func main() -> !void
    let subscription = try os::watch_signal(os::Signal.Interrupt)
    let waiter = spawn(func() -> return try await_close(subscription))
    task::sleep(time::milliseconds(0))
    let mut has_busy_error = false
    subscription.wait() catch e then
        assert(e == os::OsError.Busy)
        has_busy_error = true
    end
    assert(has_busy_error)
    subscription.close()
    subscription.close()
    assert(try await(waiter))
    let mut has_closed_error = false
    subscription.wait() catch e then
        assert(e == os::OsError.Closed)
        has_closed_error = true
    end
    assert(has_closed_error)
    let unused = try os::watch_signal(os::Signal.Interrupt)
end
