import std/string
import std/buffer

let name = "Dusk"

func main() -> void
    let built = "${name}"
    assert(string::equal(built, name))
    assert(string::equal(name, "Dusk"))
    assert(!string::equal(name, "dusk"))
    assert(!string::equal(name, "Dus"))
    assert(!string::equal("", "a"))
    assert(string::equal("", "${""}"))
    assert(string::equal("olá 🌙", "ol\u{E1} \u{1F319}"))
    assert(string::equal(string::from_bytes(buffer::from_string("copy")) catch "", "copy"))
    assert(name |> string::equal("Dusk"))
    let mut matches = 0
    for 1..20000: i do
        let text = "item $i"
        if string::equal(text, "item 19999") then
            matches = matches + 1
        end
    end
    assert(matches == 1)
    echo(string::equal("a", "a"))
    echo(string::equal("a", "b"))
    assert(string::equal(a = "José", b = "JOSÉ", ignore_case = true))
    assert(string::equal("AÇÃO", "ação", true))
    assert(!string::equal("José", "JOSÉ"))
    assert(!string::equal("José", "JOSÉ", false))
    assert(string::equal("Hello", "hELLO", true))
    assert(!string::equal("Hello", "Hell", true))
    assert(!string::equal("ß", "SS", true))
    assert(!string::equal("×", "÷", true))
    assert(!string::equal("Ω", "ω", true))
    assert("Dusk" |> string::equal("DUSK", true))
end
