let text = "olá, mundo, olá"
assert((str_find(text, "mundo") orelse -1) == 6)
assert((str_find(text, "olá") orelse -1) == 0)
assert((str_find(text, "xyz") orelse -1) == -1)
assert((str_find(text, "") orelse -1) == 0)
if str_find(text, ","): at then
    assert(at == 4)
end
assert(str_find("", "a") == null)
assert(str_contains(text, "mundo"))
assert(!str_contains(text, "Mundo"))
assert(str_contains(text, ""))
assert(str_starts_with(text, "olá"))
assert(!str_starts_with(text, "mundo"))
assert(str_starts_with(text, ""))
assert(str_ends_with(text, "olá"))
assert(!str_ends_with(text, "ol"))
assert(str_ends_with("", ""))
assert((try str_count(text, "olá")) == 2)
assert((try str_count("aaaa", "aa")) == 2)
assert((try str_count("abc", "z")) == 0)
assert((text |> str_contains("mundo")))
func count_or_reason(text: string, needle: string) -> string
    let n = str_count(text, needle) catch e then
        return when e
            StringError.EmptyPattern then "empty pattern" end
            else then "other" end
        end
    end
    return "$n"
end
echo(count_or_reason(text, "olá"))
echo(count_or_reason(text, ""))
echo(str_find(text, "mundo"))
echo(str_find(text, "?"))
