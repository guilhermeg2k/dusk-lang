import std/string

let text = "olá, mundo, olá"

func main() -> void
    assert((string::find(text, "mundo") orelse -1) == 6)
    assert((string::find(text, "olá") orelse -1) == 0)
    assert((string::find(text, "xyz") orelse -1) == -1)
    assert(string::find(text, "") == null)
    assert(string::find("", "") == null)
    if string::find(text, ","): at then
        assert(at == 4)
    end
    assert(string::find("", "a") == null)
    assert(string::contains(text, "mundo"))
    assert(!string::contains(text, "Mundo"))
    assert(!string::contains(text, ""))
    assert(!string::contains("", ""))
    assert(string::starts_with(text, "olá"))
    assert(!string::starts_with(text, "mundo"))
    assert(!string::starts_with(text, ""))
    assert(!string::starts_with("", ""))
    assert(string::ends_with(text, "olá"))
    assert(!string::ends_with(text, "ol"))
    assert(!string::ends_with(text, ""))
    assert(!string::ends_with("", ""))
    assert((string::count(text, "olá")) == 2)
    assert((string::count("aaaa", "aa")) == 2)
    assert((string::count("abc", "z")) == 0)
    assert((text |> string::contains("mundo")))
    assert(string::count(text, "") == 0)
    assert(string::count("", "") == 0)
    echo(string::count(text, "olá"))
    echo(string::count(text, ""))
    echo(string::find(text, "mundo"))
    echo(string::find(text, "?"))
end
