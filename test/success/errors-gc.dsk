error BuildError
    Odd
end

struct Box
    id: int
    items: []int
end

func build(n: int) -> BuildError!Box
    let junk = ["garbage garbage garbage", "more garbage here"]
    if n % 2 == 1 then
        return BuildError.Odd
    end
    return Box(id = n, items = [n, n, n])
end

func build_twice(n: int) -> BuildError!Box
    let first = try build(n)
    let second = try build(n + 2)
    return Box(id = first.id + second.id, items = second.items)
end

let mut kept: []Box = []
let mut failures = 0
let mut i = 0
for i < 40000 do
    let box = build(i) catch e then
        let trash = [i, i, i, i]
        failures += 1
        i += 1
        continue
    end
    if i % 1000 == 0 then
        append(kept, box)
    end
    i += 1
end

assert(failures == 20000)
assert(len(kept) == 40)
assert(kept[3].id == 3000)
assert(kept[3].items[2] == 3000)

let mut j = 0
let mut total = 0
for j < 20000 do
    let fallback = Box(id = -1, items = [0])
    let box = build_twice(j) catch fallback
    total += box.id
    build(j) catch e then
        let trash = ["x", "y", "z"]
    end
    j += 1
end
assert(total > 0)

func names(n: int) -> !string
    let junk = [n, n, n, n, n, n]
    if n % 3 == 0 then
        return BuildError.Odd
    end
    return "name"
end

let mut k = 0
let mut kept_names: []string = []
for k < 30000 do
    let name = names(k) catch "none"
    if k % 5000 == 0 or k % 5000 == 1 then
        append(kept_names, name)
    end
    k += 1
end
assert(len(kept_names) == 12)
echo(kept_names)
