func main() -> void
    let smallest = 0 - 9223372036854775807 - 1
    assert(smallest % -1 == 0)
    assert(smallest // 1 == smallest)
    assert(7 % -2 == -1)
    assert(-7 % 2 == 1)
    assert(-7 // 2 == -3)
    assert(7 // -2 == -3)
    assert(7.0 / 2.0 == 3.5)
    let fa = 7.0
    let fb = -2.0
    assert(fa % fb == -1.0)
    let fc = 0.0
    let nan_mod = fa % fc
    assert(nan_mod != nan_mod)
end
