struct Point
    x: int
end

func main() -> void
    let mut xs = [1, 2, 3]
    let last = pop(xs) catch 0
    assert(last == 3)
    assert(len(xs) == 2)
    let mut total = 0
    for true do
        let x = pop(xs) catch _ then break end
        total = total + x
    end
    assert(total == 3)
    assert(len(xs) == 0)
    let e = pop(xs) catch 99
    assert(e == 99)
    let mut names = ["a", "b"]
    let n = pop(names) catch "none"
    assert(str_equal(n, "b"))
    let mut points = [Point(x = 1)]
    let p = pop(points) catch Point(x = 0)
    assert(p.x == 1)
    let mut grid = [[1], [2, 3]]
    let row = pop(grid) catch []
    assert(len(row) == 2)
    pop(xs) catch e then
        assert(e == ArrayError.Empty)
    end
end
