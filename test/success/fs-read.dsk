import std/fs
import std/string
import std/buffer

func error_name(e: fs::FsError) -> string
    return when e
        fs::FsError.NotFound then "NotFound" end
        fs::FsError.IsDirectory then "IsDirectory" end
        fs::FsError.InvalidUtf8 then "InvalidUtf8" end
        else then "other" end
    end
end

func read_error(path: string) -> string
    fs::read(path) catch e then
        return error_name(e)
    end
    return "none"
end

func main() -> !void
    assert(try fs::read("test/fixtures/fs/hello.txt") == "hello")

    let unicode = try fs::read("test/fixtures/fs/unicode.txt")
    assert(unicode == "olá 🌙\n")
    assert(string::len(unicode) == 10)
    assert(string::char_count(unicode) == 6)

    assert(try fs::read("test/fixtures/fs/empty.txt") == "")

    assert(read_error("test/fixtures/fs/invalid-utf8.bin") == "InvalidUtf8")
    assert(read_error("test/fixtures/fs/folder") == "IsDirectory")
    assert(read_error("test/fixtures/fs/missing.txt") == "NotFound")

    let raw = try fs::read_bytes("test/fixtures/fs/invalid-utf8.bin")
    assert(buffer::len(raw) == 3)
    assert(raw[0] == 255)
    assert(raw[1] == 254)
    assert(raw[2] == 'A')

    let mut hello = try fs::read_bytes("test/fixtures/fs/hello.txt")
    hello[0] = 'j'
    assert(try string::from_bytes(hello) == "jello")
    assert(try fs::read("test/fixtures/fs/hello.txt") == "hello")

    let empty = try fs::read_bytes("test/fixtures/fs/empty.txt")
    assert(buffer::len(empty) == 0)

    let mut i = 0
    for i < 2000 do
        let text = try fs::read("test/fixtures/fs/unicode.txt")
        let junk = [i, i, i, i, i, i, i, i]
        assert(text == "olá 🌙\n")
        assert(junk[7] == i)
        i = i + 1
    end
end
