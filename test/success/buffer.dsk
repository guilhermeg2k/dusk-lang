let mut buf = buffer(4)
echo(buf)
echo(len(buf))
buf[0] = 'h'
buf[1] = 105
buf[3] = byte(200 + 55)
echo(buf)
let x = buf[0]
echo(x)
assert(x == 'h')
let copy = buffer_from("olá")
echo(copy)
echo(len(copy))
echo(string_from(copy) orelse "invalid")
echo(string_from(buf) orelse "invalid")
let mut total = 0
for copy: b, i do
    total += b
end
echo(total)
echo("buf=$buf")
let maybe: ?buffer = null
echo(maybe)
echo(buf |> len())
let bufs = [buffer(1), buffer(2)]
echo(bufs)
let empty = buffer(0)
echo(empty)
echo(string_from(empty) orelse "x")
struct Packet
    data: buffer
end
let mut p = Packet(data = buffer(2))
p.data[1] = 9
echo(p.data)
echo(len(p.data))
