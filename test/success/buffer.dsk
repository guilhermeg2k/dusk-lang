import std/string
import std/buffer

struct Packet
    data: buffer
end

func utf8_reason(data: buffer) -> string
    let text = string::from_bytes(data) catch e then
        return when e
            string::StringError.InvalidUtf8 then "invalid utf-8" end
            else then "other" end
        end
    end
    return text
end

func main() -> !void
    let mut buf = try buffer::new(4)
    echo(buf)
    echo(buffer::len(buf))
    buf[0] = 'h'
    buf[1] = 105
    buf[3] = try to_byte(200 + 55)
    echo(buf)
    let x = buf[0]
    echo(x)
    assert(x == 'h')
    let copy = buffer::from_string("olá")
    echo(copy)
    echo(buffer::len(copy))
    echo(string::from_bytes(copy) catch "invalid")
    echo(string::from_bytes(buf) catch "invalid")
    let mut total = 0
    for copy: b, i do
        total = total + b
    end
    echo(total)
    echo("buf=$buf")
    let maybe: ?buffer = null
    echo(maybe)
    echo(buf |> buffer::len())
    let bufs = [try buffer::new(1), try buffer::new(2)]
    echo(bufs)
    let empty = try buffer::new(0)
    echo(empty)
    echo(string::from_bytes(empty) catch "x")
    let mut p = Packet(data = try buffer::new(2))
    p.data[1] = 9
    echo(p.data)
    echo(buffer::len(p.data))
    echo(utf8_reason(buf))
    echo(utf8_reason(buffer::from_string("fine")))
end
