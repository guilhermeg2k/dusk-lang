import std/string
import std/buffer
import std/io

struct Packet
    data: buffer
end

func utf8_reason(data: buffer) -> string
    let text = string::from_bytes(data) catch e then
        return when e
            string::StringError.InvalidUtf8 then "invalid utf-8" end
            else then "other" end
        end
    end
    return text
end

func main() -> !void
    let mut buf = try buffer::new(4)
    io::println("${buf}")
    io::println("${buffer::len(buf)}")
    buf[0] = 'h'
    buf[1] = 105
    buf[3] = try to_byte(200 + 55)
    io::println("${buf}")
    let x = buf[0]
    io::println("${x}")
    assert(x == 'h')
    let copy = buffer::from_string("olá")
    io::println("${copy}")
    io::println("${buffer::len(copy)}")
    io::println("${string::from_bytes(copy) catch "invalid"}")
    io::println("${string::from_bytes(buf) catch "invalid"}")
    let mut total = 0
    for copy: b, i do
        total = total + b
    end
    io::println("${total}")
    io::println("buf=$buf")
    let maybe: ?buffer = null
    io::println("${maybe}")
    io::println("${buf |> buffer::len()}")
    let bufs = [try buffer::new(1), try buffer::new(2)]
    io::println("${bufs}")
    let empty = try buffer::new(0)
    io::println("${empty}")
    io::println("${string::from_bytes(empty) catch "x"}")
    let mut p = Packet(data = try buffer::new(2))
    p.data[1] = 9
    io::println("${p.data}")
    io::println("${buffer::len(p.data)}")
    io::println("${utf8_reason(buf)}")
    io::println("${utf8_reason(buffer::from_string("fine"))}")
end
