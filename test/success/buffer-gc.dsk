import std/array: len, append
import std/string
import std/buffer

func main() -> !void
    let mut kept: []buffer = []
    let mut total = 0
    for 1..20000: i do
        let mut data = try buffer::new(64)
        data[0] = try to_byte(i % 256)
        data[63] = 7
        let copy = buffer::from_string("payload number $i")
        assert(string::len(try string::from_bytes(copy)) == buffer::len(copy))
        total = total + buffer::len(copy)
        if i % 1000 == 0 then
            append(kept, data)
        end
    end
    assert(len(kept) == 20)
    for kept: data, index do
        assert(data[0] == try to_byte(((index + 1) * 1000) % 256))
        assert(data[63] == 7)
        assert(buffer::len(data) == 64)
    end
    echo(total)
end
