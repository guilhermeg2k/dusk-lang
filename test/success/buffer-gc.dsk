func main() -> !void
    let mut kept: []buffer = []
    let mut total = 0
    for 1..20000: i do
        let mut data = buffer(64)
        data[0] = byte(i % 256)
        data[63] = 7
        let copy = buffer_from("payload number $i")
        assert(str_len(try string_from(copy)) == buffer_len(copy))
        total = total + buffer_len(copy)
        if i % 1000 == 0 then
            append(kept, data)
        end
    end
    assert(len(kept) == 20)
    for kept: data, index do
        assert(data[0] == byte(((index + 1) * 1000) % 256))
        assert(data[63] == 7)
        assert(buffer_len(data) == 64)
    end
    echo(total)
end
