import std/reflect
import std/array
import std/map
import std/buffer
import std/task
import std/string

struct User
    name: string
    age: int
    tags: []string
    email: ?string = null
end

struct Node
    value: int
    next: ?Node = null
end

enum Color
    Red = 3
    Crimson = 3
    Blue = 7
end

union Choice
    user: User
    number: int
end

func expect_failure(action: func() -> reflect::ReflectError!void, expected: reflect::ReflectError) -> void
    action() catch err then
        assert(err == expected)
        return
    end
    assert(false)
end

func main() -> !void
    let mut original = User("Ana", 30, ["fresh"])
    let snapshot = reflect::value(original)
    original.age = 99
    original.tags[0] = "changed"
    assert(reflect::is_same(reflect::value_type(snapshot), reflect::type_of[User]()))
    assert((try reflect::cast[int](try reflect::field(snapshot, "age"))) == 30)
    let tags = try reflect::field(snapshot, "tags")
    assert((try reflect::length(tags)) == 1)
    assert((try reflect::cast[string](try reflect::element(tags, 0))) == "fresh")
    let mut recovered = try reflect::cast[User](snapshot)
    recovered.tags[0] = "different"
    assert((try reflect::cast[string](try reflect::element(tags, 0))) == "fresh")
    assert((try reflect::cast[User](copy(snapshot))).age == 30)
    let missing = try reflect::field(snapshot, "email")
    assert(try reflect::is_null(missing))
    let present: ?int = 42
    let nullable = reflect::value(present)
    assert(!(try reflect::is_null(nullable)))
    assert((try reflect::cast[int](try reflect::unwrap(nullable))) == 42)
    assert((try reflect::cast[?int](nullable)) == 42)
    assert(!(try reflect::is_null(reflect::value(0))))
    assert((try reflect::cast[bool](reflect::value(true))))
    assert((try reflect::cast[float](reflect::value(1.5))) == 1.5)
    let byte_value: byte = try to_byte(255)
    assert((try reflect::cast[byte](reflect::value(byte_value))) == byte_value)
    let bytes = buffer::from_string("abc")
    assert((try reflect::cast[buffer](reflect::value(bytes))) != bytes)
    let mut counts: map[string, ?int] = {"removed": 1, "empty": null, "answer": 42}
    map::remove(counts, "removed")
    let mapping = reflect::value(counts)
    counts["answer"] = 99
    assert((try reflect::length(mapping)) == 2)
    assert((try reflect::cast[string](try reflect::map_key(mapping, 0))) == "empty")
    assert(try reflect::is_null(try reflect::map_value(mapping, 0)))
    assert((try reflect::cast[?int](try reflect::map_value(mapping, 1))) == 42)
    let enum_value = reflect::value(Color.Crimson)
    assert((try reflect::variant_name(enum_value)) == "Red")
    assert((try reflect::variant_value(enum_value)) == 3)
    assert((try reflect::cast[Color](enum_value)) == Color.Red)
    let union_value = reflect::value(Choice(number = 7))
    assert((try reflect::variant_name(union_value)) == "number")
    assert((try reflect::cast[int](try reflect::payload(union_value))) == 7)
    let mut node = Node(1)
    node.next = node
    let cycle = reflect::value(node)
    let next = try reflect::unwrap(try reflect::field(cycle, "next"))
    assert(try reflect::is_same_object(cycle, next))
    assert(!(try reflect::is_same_object(reflect::value(1), reflect::value(1))))
    let mut copied = try reflect::cast[Node](cycle)
    assert(copied.next == copied)
    copied.value = 2
    assert(node.value == 1)
    expect_failure(func() -> reflect::ReflectError!void
        let wrong = try reflect::cast[string](snapshot)
    end, reflect::ReflectError.TypeMismatch)
    expect_failure(func() -> reflect::ReflectError!void
        let wrong = try reflect::field(snapshot, "absent")
    end, reflect::ReflectError.UnknownField)
    expect_failure(func() -> reflect::ReflectError!void
        let wrong = try reflect::element(tags, -1)
    end, reflect::ReflectError.OutOfRange)
    expect_failure(func() -> reflect::ReflectError!void
        let wrong = try reflect::map_value(mapping, 2)
    end, reflect::ReflectError.OutOfRange)
    expect_failure(func() -> reflect::ReflectError!void
        let wrong = try reflect::unwrap(missing)
    end, reflect::ReflectError.TypeMismatch)
    expect_failure(func() -> reflect::ReflectError!void
        let wrong = try reflect::length(snapshot)
    end, reflect::ReflectError.TypeMismatch)
    let identity_key = reflect::value(7)
    let indexed: map[reflect::Value, int] = {identity_key: 99}
    let pressure = try string::repeat("x", 2000000)
    assert(indexed[identity_key] == 99)
    for 0..9999: i do
        let current = reflect::value(User("user$i", i, ["tag"]))
        assert((try reflect::cast[int](try reflect::field(current, "age"))) == i)
        if i % 1000 == 0 then
            task::sleep(0)
        end
    end
    assert((try reflect::cast[User](snapshot)).age == 30)
    assert(indexed[identity_key] == 99)
end
