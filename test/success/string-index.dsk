let word = "olá!"
func byte_or_reason(text: string, index: int) -> string
    let b = str_byte_at(text, index) catch e then
        return when e
            StringError.OutOfRange then "out of range" end
            else then "other" end
        end
    end
    return "$b"
end

func char_or_reason(text: string, index: int) -> string
    let c = str_char_at(text, index) catch e then
        return when e
            StringError.OutOfRange then "out of range" end
            else then "other" end
        end
    end
    return c
end

func main() -> !void
    assert((try str_byte_at(word, 0)) == 'o')
    assert((try str_byte_at(word, 2)) == 195)
    assert((try str_byte_at(word, 3)) == 161)
    assert((try str_byte_at(word, 4)) == '!')
    assert(str_equal(try str_char_at(word, 0), "o"))
    assert(str_equal(try str_char_at(word, 2), "á"))
    assert(str_equal(try str_char_at(word, 3), "!"))
    assert(str_equal(try str_char_at("🌙x", 1), "x"))
    echo(byte_or_reason(word, -1))
    echo(byte_or_reason(word, 5))
    echo(byte_or_reason(word, 1))
    echo(char_or_reason(word, -1))
    echo(char_or_reason(word, 4))
    echo(char_or_reason(word, 2))
    echo(char_or_reason("", 0))
    let mut digits = 0
    for "a1b22": b do
        if b >= '0' and b <= '9' then
            digits = digits + 1
        end
    end
    assert(digits == 3)
    for word: b, i do
        echo("$i: $b")
    end
end
