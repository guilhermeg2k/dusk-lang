import "std/string"
import "std/io"

func main() -> void
    let word = "olá!"
    let first_byte: ?byte = string::byte_at(word, 0)
    let first_char: ?string = string::char_at(word, 0)
    assert(first_byte == 'o')
    assert(string::byte_at(word, 2) == 195)
    assert(string::byte_at(word, 3) == 161)
    assert(string::byte_at(word, 4) == '!')
    assert(first_char == "o")
    assert(string::char_at(word, 2) == "á")
    assert(string::char_at(word, 3) == "!")
    assert(string::char_at("🌙x", 1) == "x")
    assert(string::byte_at(word, -1) == null)
    assert(string::byte_at(word, 5) == null)
    assert(string::byte_at("", 0) == null)
    assert(string::char_at(word, -1) == null)
    assert(string::char_at(word, 4) == null)
    assert(string::char_at("", 0) == null)
    let mut digits = 0
    for "a1b22": b do
        if b >= '0' and b <= '9' then
            digits = digits + 1
        end
    end
    assert(digits == 3)
    for word: b, i do
        io::println("$i: $b")
    end
end
