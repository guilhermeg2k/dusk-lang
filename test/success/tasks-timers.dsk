import std/task
import std/array: len, append

func pause_then(ms: int, label: string) -> string
    task::sleep(ms)
    return label
end

func main() -> void
    let mut order: []int = []
    for [30, 10, 20]: ms do
        spawn(func()
            task::sleep(ms)
            append(order, ms)
        end)
    end

    let slow = spawn(func() -> return pause_then(25, "slow"))
    let fast = spawn(func() -> return pause_then(5, "fast"))
    assert(str_equal(await(slow), "slow"))
    assert(str_equal(await(fast), "fast"))
    assert(len(order) == 2)
    assert(order[0] == 10)
    assert(order[1] == 20)

    let mut ticks = 0
    let ticker = spawn(func()
        for 1..3: _ do
            task::sleep(2)
            ticks = ticks + 1
        end
    end)
    for ticks < 3 do
        task::sleep(0)
    end
    await(ticker)

    spawn(func()
        task::sleep(15)
        echo("late task: ${len(order)}")
    end)
    echo("main ends")
end
