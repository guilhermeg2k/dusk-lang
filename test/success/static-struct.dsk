struct Api
    let ip = "127.0.0.1"
    let port = 8000 + 80
    let secure = false

    endpoint: string = ""

    func fetch(self: @) -> string
        return self.ip
    end

    func url(self: @) -> string
        return "${Api.ip}:${Api.port}${self.endpoint}"
    end
end

let api = Api("/me")

assert(str_equal(api.fetch(), "127.0.0.1"))
assert(str_equal(Api.fetch(api), "127.0.0.1"))
assert(Api.port == 8080)
assert(api.port == 8080)
assert(Api.secure == false)
assert(str_equal(api.url(), "127.0.0.1:8080/me"))
