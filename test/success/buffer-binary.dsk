import std/buffer
import std/string

func write_error(mut data: buffer, at: int, value: int) -> ?buffer::BufferError
    let next = buffer::write_u16(data, at, value, buffer::Order.Big) catch e then
        return e
    end
    return null
end

func read_error(data: buffer, at: int) -> ?buffer::BufferError
    let value = buffer::read_i32(data, at, buffer::Order.Little) catch e then
        return e
    end
    return null
end

func parse_error(data: buffer, start: int, stop: int) -> ?buffer::BufferError
    let value = buffer::parse_int(data, start, stop) catch e then
        return e
    end
    return null
end

func range_error(mut data: buffer, from: int, to: int, count: int) -> ?buffer::BufferError
    buffer::copy_within(data, from, to, count) catch e then
        return e
    end
    return null
end

func check_numbers() -> !void
    let mut data = try buffer::new(32)
    let mut at = try buffer::write_u16(data, 0, 513, buffer::Order.Little)
    assert(at == 2 and data[0] == 1 and data[1] == 2)
    at = try buffer::write_u16(data, at, 513, buffer::Order.Big)
    assert(at == 4 and data[2] == 2 and data[3] == 1)
    assert((try buffer::read_u16(data, 0, buffer::Order.Little)) == 513)
    assert((try buffer::read_u16(data, 0, buffer::Order.Big)) == 258)

    at = try buffer::write_u8(data, 4, 255)
    at = try buffer::write_i8(data, at, -1)
    assert(at == 6)
    assert((try buffer::read_u8(data, 4)) == 255)
    assert((try buffer::read_i8(data, 4)) == -1)
    assert((try buffer::read_u8(data, 5)) == 255)

    at = try buffer::write_i16(data, 6, -2, buffer::Order.Big)
    assert(data[6] == 255 and data[7] == 254)
    assert((try buffer::read_i16(data, 6, buffer::Order.Big)) == -2)
    assert((try buffer::read_u16(data, 6, buffer::Order.Big)) == 65534)

    at = try buffer::write_u32(data, 8, 4294967295, buffer::Order.Little)
    assert(at == 12)
    assert((try buffer::read_u32(data, 8, buffer::Order.Little)) == 4294967295)
    assert((try buffer::read_i32(data, 8, buffer::Order.Little)) == -1)
    at = try buffer::write_i32(data, 8, -2147483648, buffer::Order.Big)
    assert(data[8] == 128 and data[11] == 0)
    assert((try buffer::read_i32(data, 8, buffer::Order.Big)) == -2147483648)

    at = try buffer::write_i64(data, 12, -9223372036854775807 - 1, buffer::Order.Big)
    assert(at == 20 and data[12] == 128 and data[19] == 0)
    assert((try buffer::read_i64(data, 12, buffer::Order.Big)) == -9223372036854775807 - 1)
    at = try buffer::write_i64(data, 12, 72623859790382856, buffer::Order.Little)
    assert(data[12] == 8 and data[19] == 1)
    assert((try buffer::read_i64(data, 12, buffer::Order.Little)) == 72623859790382856)

    at = try buffer::write_f32(data, 20, 1.5, buffer::Order.Big)
    assert(at == 24 and data[20] == 63 and data[21] == 192)
    assert((try buffer::read_f32(data, 20, buffer::Order.Big)) == 1.5)
    at = try buffer::write_f64(data, 24, -0.1, buffer::Order.Little)
    assert(at == 32)
    assert((try buffer::read_f64(data, 24, buffer::Order.Little)) == -0.1)
    at = try buffer::write_f32(data, 20, 0.1, buffer::Order.Little)
    let rounded = try buffer::read_f32(data, 20, buffer::Order.Little)
    assert(rounded != 0.1 and rounded > 0.0999999 and rounded < 0.1000001)

    data[30] = 7
    assert(write_error(data, 0, 65536) == buffer::BufferError.ValueOutOfRange)
    assert(write_error(data, 0, -1) == buffer::BufferError.ValueOutOfRange)
    assert(write_error(data, 31, 1) == buffer::BufferError.OutOfRange)
    assert(write_error(data, -1, 1) == buffer::BufferError.OutOfRange)
    assert(write_error(data, 30, 99999) == buffer::BufferError.ValueOutOfRange)
    assert(data[30] == 7)
    assert(read_error(data, 29) == buffer::BufferError.OutOfRange)
    assert(read_error(data, 28) == null)
    let mut tiny = try buffer::new(1)
    assert(read_error(tiny, 0) == buffer::BufferError.OutOfRange)
    let mut big_float = false
    buffer::write_f32(data, 0, 1000000000000000000000000000000000000000.0, buffer::Order.Big) catch e then
        assert(e == buffer::BufferError.ValueOutOfRange)
        big_float = true
    end
    assert(big_float)
end

func check_search() -> !void
    let a = buffer::from_string("hello world")
    let b = buffer::from_string("hello world")
    assert(a != b)
    assert(buffer::equal(a, b))
    assert(!buffer::equal(a, buffer::from_string("hello")))
    assert(buffer::equal(try buffer::new(0), try buffer::new(0)))
    assert(buffer::starts_with(a, buffer::from_string("hello")))
    assert(buffer::starts_with(a, try buffer::new(0)))
    assert(!buffer::starts_with(buffer::from_string("he"), buffer::from_string("hello")))
    let o = buffer::from_string("o")
    assert(buffer::index_of(a, o) == 4)
    assert(buffer::index_of(a, o, from = 5) == 7)
    assert(buffer::index_of(a, o, from = 8) == null)
    assert(buffer::index_of(a, o, from = -1) == null)
    assert(buffer::index_of(a, o, from = 11) == null)
    assert(buffer::index_of(a, try buffer::new(0)) == null)
    assert(buffer::index_of(a, buffer::from_string("world")) == 6)
end

func check_fill_and_copy() -> !void
    let mut data = buffer::from_string("abcdef")
    try buffer::copy_within(data, 2, 0, 4)
    assert((try string::from_bytes(data)) == "cdefef")
    data = buffer::from_string("abcdef")
    try buffer::copy_within(data, 0, 2, 4)
    assert((try string::from_bytes(data)) == "ababcd")
    try buffer::copy_within(data, 1, 1, 0)
    try buffer::copy_within(data, 6, 6, 0)
    assert(range_error(data, 3, 0, 4) == buffer::BufferError.OutOfRange)
    assert(range_error(data, 0, 3, 4) == buffer::BufferError.OutOfRange)
    assert(range_error(data, -1, 0, 1) == buffer::BufferError.OutOfRange)
    assert(range_error(data, 0, 0, -1) == buffer::BufferError.OutOfRange)
    assert((try string::from_bytes(data)) == "ababcd")

    try buffer::fill(data, '-', 1, 3)
    assert((try string::from_bytes(data)) == "a--bcd")
    try buffer::fill(data, 0, 0, 6)
    assert(data[0] == 0 and data[5] == 0)
    try buffer::fill(data, 'x', 6, 6)
    let mut failed = false
    buffer::fill(data, 'x', 4, 7) catch e then
        assert(e == buffer::BufferError.OutOfRange)
        failed = true
    end
    assert(failed and data[4] == 0)
end

func check_parse() -> !void
    let line = buffer::from_string("Content-Length: 1234\r\n")
    assert((try buffer::parse_int(line, 16, 20)) == 1234)
    let numbers = buffer::from_string("-42 0 007 9223372036854775807 -9223372036854775808 9223372036854775808")
    assert((try buffer::parse_int(numbers, 0, 3)) == -42)
    assert((try buffer::parse_int(numbers, 4, 5)) == 0)
    assert((try buffer::parse_int(numbers, 6, 9)) == 7)
    assert((try buffer::parse_int(numbers, 10, 29)) == 9223372036854775807)
    assert((try buffer::parse_int(numbers, 30, 50)) == -9223372036854775807 - 1)
    assert(parse_error(numbers, 51, 70) == buffer::BufferError.ValueOutOfRange)
    assert(parse_error(numbers, 0, 4) == buffer::BufferError.InvalidNumber)
    assert(parse_error(numbers, 3, 3) == buffer::BufferError.InvalidNumber)
    assert(parse_error(numbers, 0, 1) == buffer::BufferError.InvalidNumber)
    let signed = buffer::from_string("+5 1_000")
    assert(parse_error(signed, 0, 2) == buffer::BufferError.InvalidNumber)
    assert(parse_error(signed, 3, 8) == buffer::BufferError.InvalidNumber)
    assert(parse_error(numbers, 5, 4) == buffer::BufferError.OutOfRange)
    assert(parse_error(numbers, 0, 71) == buffer::BufferError.OutOfRange)
end

func main() -> !void
    try check_numbers()
    try check_search()
    try check_fill_and_copy()
    try check_parse()
end
