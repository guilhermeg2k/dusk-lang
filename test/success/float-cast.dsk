func convert[T: int | byte | float](x: T) -> float
    return to_float(x)
end

func main() -> void
    let n = 7
    let b = 'a'
    assert(to_float(n) / 2.0 == 3.5)
    assert(to_float(b) == 97.0)
    assert(to_float(2.5) == 2.5)
    assert(to_float(-3) == -3.0)
    assert(to_float(n + 1) == 8.0)
    let items = [to_float(n), 1.5]
    assert(items[0] == 7.0)
    assert(convert(n) == 7.0)
    assert(convert(b) == 97.0)
    assert(convert(2.5) == 2.5)
end
