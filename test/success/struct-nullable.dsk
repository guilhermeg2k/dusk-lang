import "std/io"

struct Country
    id: int
    name: string
    code: ?string
end

struct Address
    city: ?string
    state: ?string
    country: ?Country
    street: ?string
end

struct UserInfo
    address: ?Address
    phone: ?string
end

struct User
    info: ?UserInfo
end

func main() -> void
    let mut user = User(
        info = @(
            address = @(
                city = null,
                state = "DF",
                country = @(
                    id = 1,
                    name = "Brasil",
                    code = "BR"
                )
            ),
            phone = null
        ),
    )

    if user.info?.address: address then
        if address.country?.name: name then
            io::println("${name}")
        end

        if address.state: name then
            io::println("${name}")
        end

        if address.city: name then
            io::println("${name}")
        end
    end

    if user.info: mut info then
        info.phone = "40028922"
    end

    if user.info?.address?.country?.code: code then
        io::println("${code}")
    end

    if user.info?.phone: phone then
        io::println("${phone}")
    end

    if user.info: mut info then
        info.phone = "40028922"
    end

    if user.info?.phone: phone then
        io::println("${phone}")
    end


    # should still be DF
    io::println("${user.info?.address?.state}")
end
