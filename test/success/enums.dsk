import "std/io"

enum Color
    Red
    Green
    Blue
end

enum HttpStatus
    Ok = 200
    NotFound = 404
    ServerError = 500
end

enum Direction
    let DEFAULT = Direction.North
    let LIMIT = 40 + 2

    North
    South
    East
    West
end

enum Config
    let name: string = "test_config"

    A
    B
end

let col: Color = Color.Blue

func get_color() -> Color
    return Color.Red
end

func is_red(c: Color) -> bool
    return c == Color.Red
end

enum Status
    Active
    Inactive
end

let s = Status.Active

enum GameState
    let DEFAULT = GameState.Playing

    Stopped
    Playing
    End

    func is_playing(self: @) -> bool
        return self == GameState.Playing
    end

    func next(self: @) -> GameState
        if self == GameState.Stopped then
            return GameState.Playing
        end

        if self == GameState.Playing then
            return GameState.End
        end

        return GameState.Stopped
    end
end

func main() -> void
    io::println("${Color.Red}")
    io::println("${Color.Green}")

    io::println("${HttpStatus.Ok}")
    io::println("${HttpStatus.ServerError}")

    io::println("${Direction.DEFAULT}")
    assert(Direction.LIMIT == 42)
    assert(Direction.DEFAULT == Direction.North)

    io::println("${Config.name}")
    io::println("${col}")

    if Color.Red == Color.Red then
        io::println("${100}")
    end

    if Color.Red != Color.Blue then
        io::println("${101}")
    end

    io::println("${get_color()}")
    io::println("${is_red(Color.Red)}")
    io::println("${is_red(Color.Green)}")

    let colors = [Color.Red, Color.Green, Color.Blue]
    io::println("${colors[0]}")
    io::println("${colors[2]}")

    let maybe: ?Color = null
    let maybe2: ?Color = Color.Green
    io::println("${maybe2}")
    io::println("${s}")

    let mut gs = GameState.DEFAULT
    io::println("${gs.is_playing()}")

    gs = gs.next()
    io::println("${gs.is_playing()}")
end
