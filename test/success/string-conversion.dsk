echo(try str_to_int("42"))
echo(try str_to_int("-9223372036854775808"))
echo(str_to_float("3") catch 0.5)
echo(str_to_float("-0.25") catch 0.5)
echo(str_to_int("4x") catch -1)
func describe(text: string) -> string
    let n = str_to_int(text) catch e then
        return when e
            ConversionError.Invalid then "invalid" end
            ConversionError.Overflow then "overflow" end
        end
    end
    return "ok $n"
end
for ["1", "", "-", "+1", " 1", "1 ", "1_000", "0x10", "1.5", "9223372036854775808"]: t do
    echo("'$t' -> ${describe(t)}")
end
func parse(text: string) -> ConversionError!float
    return try str_to_float(text)
end
for ["1.", ".5", "1e3", "inf", "nan", "2.50"]: t do
    echo("'$t' -> ${parse(t) catch -1.0}")
end
assert((str_to_float("") catch -2.0) == -2.0)
let huge = str_to_float("") catch e then
    assert(e == ConversionError.Overflow)
    return
end
