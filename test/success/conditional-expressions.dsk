func choose(is_ready: bool) -> int
    return if is_ready then 10 else 20 end
end

assert(choose(true) == 10)
assert(choose(false) == 20)

func sign(number: int) -> return if number > 0 then 1 elif number < 0 then -1 else 0 end

assert(sign(3) == 1)
assert(sign(-3) == -1)
assert(sign(0) == 0)

let mut selected = if true then
    let base = 4
    base * 3
else
    0
end

assert(selected == 12)
selected = if false then 0 else selected + 1 end
assert(selected == 13)
assert(2 * if true then 3 else 4 end + 1 == 7)
assert((if false then [1] else [2, 3] end)[1] == 3)
assert(len(if true then [1, 2] else [3] end) == 2)

let values = [if true then 3 else 4 end, if false then 5 else 6 end]
assert(values[0] == 3)
assert(values[1] == 6)

let nested = if true then
    if false then 1 else 2 end
else
    3
end

assert(nested == 2)

struct Point
    x: int
end

let point: Point = if true then @(x = 4) else @(x = 5) end
assert(point.x == 4)
assert((if false then Point(1) else Point(2) end).x == 2)

let mut points = [Point(0)]
points[0] = if true then @(x = 7) else @(x = 8) end
assert(points[0].x == 7)
points[0].x = if false then 9 else 10 end
assert(points[0].x == 10)

let mut empty: []int = if true then [] else [1] end
assert(len(empty) == 0)
empty = if false then [1] else [] end
assert(len(empty) == 0)

let contextual_items: [][]int = [if true then [] else [1] end]
assert(len(contextual_items[0]) == 0)

struct Holder
    values: []int = if true then [] else [1] end
end

assert(len(Holder().values) == 0)

struct Record
    count: ?int
    values: []int
end

let record: Record = if true then @(values = [], count = 3) else @(count = null, values = [1]) end
assert(len(record.values) == 0)

if record.count: count then assert(count == 3) else assert(false) end

func take_record(record: Record) -> int
    return len(record.values)
end

assert(take_record(if true then @(values = [], count = 1) else @(count = null, values = [2]) end) == 0)

func default_values(values: []int = if true then [] else [1] end) -> int
    return len(values)
end

assert(default_values() == 0)
assert(default_values() == 0)

struct DefaultBranch
    value: int = if true then let local = 4 local else 5 end
end

let default_first = DefaultBranch()
let default_second = DefaultBranch()
assert(default_first.value == 4)
assert(default_second.value == 4)

let inferred_empty_first = if true then [] else [1] end

let inferred_empty_last = if false then [1] else [] end
assert(len(inferred_empty_first) == 0)
assert(len(inferred_empty_last) == 0)

let inferred_full = if true then [1] else [] end
assert(inferred_full[0] == 1)

assert(if true then [11] else [12] end[0] == 11)
assert(if true then Point(13) else Point(14) end.x == 13)

func double(number: int) -> return number * 2

assert((if true then 3 else 4 end |> double()) == 6)
