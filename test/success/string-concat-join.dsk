import "std/array": append
import "std/string"
import "std/io"

let name = "Dusk"

func main() -> void
    let greeting = string::concat("Hello, ", name)
    io::println("${greeting}")
    assert(greeting == "Hello, Dusk")
    assert(string::concat("", "") == "")
    assert(string::concat("a", "") == "a")
    assert(string::concat("", "b") == "b")
    assert(("ol" |> string::concat("á") |> string::concat(" 🌙")) == "olá 🌙")
    assert(string::len(string::concat("ab", "cd")) == 4)
    io::println("${string::join(["a", "b", "c"], ", ")}")
    io::println("${string::join(["only"], ", ")}")
    let empty: []string = []
    io::println("[${string::join(empty, ", ")}]")
    io::println("${string::join(["", "", ""], "-")}")
    io::println("${string::join(["x", "y"], "")}")
    let mut words: []string = []
    append(words, "grow")
    append(words, "the")
    append(words, "array")
    io::println("${words |> string::join(" ")}")
    io::println("${string::join(["a", "b", "c"])}")
    io::println("${["x", "y"] |> string::join()}")
    io::println("${string::join(parts = ["p", "q"], sep = "+")}")
end
