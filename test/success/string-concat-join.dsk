import std/array: append
import std/string

let name = "Dusk"

func main() -> void
    let greeting = string::concat("Hello, ", name)
    echo(greeting)
    assert(string::equal(greeting, "Hello, Dusk"))
    assert(string::equal(string::concat("", ""), ""))
    assert(string::equal(string::concat("a", ""), "a"))
    assert(string::equal(string::concat("", "b"), "b"))
    assert(string::equal("ol" |> string::concat("á") |> string::concat(" 🌙"), "olá 🌙"))
    assert(string::len(string::concat("ab", "cd")) == 4)
    echo(string::join(["a", "b", "c"], ", "))
    echo(string::join(["only"], ", "))
    let empty: []string = []
    echo("[${string::join(empty, ", ")}]")
    echo(string::join(["", "", ""], "-"))
    echo(string::join(["x", "y"], ""))
    let mut words: []string = []
    append(words, "grow")
    append(words, "the")
    append(words, "array")
    echo(words |> string::join(" "))
    echo(string::join(["a", "b", "c"]))
    echo(["x", "y"] |> string::join())
    echo(string::join(parts = ["p", "q"], sep = "+"))
end
