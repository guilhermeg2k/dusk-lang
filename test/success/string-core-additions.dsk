import std/array
import std/string

struct Player
    name: string
end

func main() -> !void
    assert(string::find("abcabc", "abc") == 0)
    assert(string::find("abcabc", "abc", 1) == 3)
    assert(string::find("abcabc", "abc", 3) == 3)
    assert(string::find("abcabc", "abc", 4) == null)
    assert(string::find("abcabc", "abc", 6) == null)
    assert(string::find("abcabc", "abc", -1) == null)
    assert(string::find("abcabc", "abc", -9223372036854775807 - 1) == null)
    assert(string::find("abcabc", "abc", 9223372036854775807) == null)
    assert(string::find("abc", "", 0) == null)
    assert(string::find("", "a", 0) == null)
    assert(string::find("abc", "abcd", 0) == null)
    assert(string::find("aaaa", "aa", 1) == 1)
    assert(string::find("ááx", "á", 1) == 2)
    assert(("abcabc" |> string::find("abc", 1)) == 3)
    assert(string::find_last("abcabc", "abc") == 3)
    assert(string::find_last("abcabc", "xyz") == null)
    assert(string::find_last("abc", "") == null)
    assert(string::find_last("", "a") == null)
    assert(string::find_last("", "") == null)
    assert(string::find_last("abc", "abcd") == null)
    assert(string::find_last("aaaa", "aa") == 2)
    assert(string::find_last("abc", "abc") == 0)
    assert(string::find_last("a🙂b🙂", "🙂") == 6)
    assert(string::find("a🙂b🙂", "🙂", 2) == 6)
    let offset = string::find_last("a🙂b🙂", "🙂") orelse -1
    assert((try string::slice("a🙂b🙂", offset, 10)) == "🙂")
    assert(string::find("a\0b\0c", "\0", 2) == 3)
    assert(string::find_last("a\0b\0c", "\0") == 3)
    assert(string::trim_start(" \t\ntext \r\n") == "text \r\n")
    assert(string::trim_end(" \t\ntext \r\n") == " \t\ntext")
    assert(string::trim_start("\u{b}\u{c}á🙂 ") == "á🙂 ")
    assert(string::trim_end(" á🙂\u{b}\u{c}") == " á🙂")
    assert(string::trim_start("") == "")
    assert(string::trim_end("") == "")
    assert(string::trim_start(" \t\r\n") == "")
    assert(string::trim_end(" \t\r\n") == "")
    assert(string::trim_start("text") == "text")
    assert(string::trim_end("text") == "text")
    assert(string::trim_start("\u{a0} x \u{a0}") == "\u{a0} x \u{a0}")
    assert(string::trim_end("\u{a0} x \u{a0}") == "\u{a0} x \u{a0}")
    assert(("  text  " |> string::trim_start() |> string::trim_end()) == "text")
    assert(string::compare("", "") == 0)
    assert(string::compare("", "a") == -1)
    assert(string::compare("a", "") == 1)
    assert(string::compare("a", "aa") == -1)
    assert(string::compare("aa", "a") == 1)
    assert(string::compare("a", "b") == -1)
    assert(string::compare("b", "a") == 1)
    assert(string::compare("Z", "a") == -1)
    assert(string::compare("z", "á") == -1)
    assert(string::compare("á", "🙂") == -1)
    assert(string::compare("a\0b", "a\0c") == -1)
    assert(string::compare("same", string::concat("sa", "me")) == 0)
    let mut players = [Player(name = "z"), Player(name = "á"), Player(name = "a"), Player(name = "")]
    array::sort_by(players, func(a, b) -> return string::compare(a.name, b.name) < 0)
    assert(players[0].name == "" and players[1].name == "a")
    assert(players[2].name == "z" and players[3].name == "á")
    for 1..20000: i do
        let text = " \tvalue$i🙂=again🙂 \r\n"
        let first = string::find(text, "🙂") orelse -1
        let last = string::find_last(text, "🙂") orelse -1
        assert(last > first)
        assert(string::find(text, "🙂", first + 1) == last)
        let left = string::trim_start(text)
        let right = string::trim_end(text)
        assert(left == "value$i🙂=again🙂 \r\n")
        assert(right == " \tvalue$i🙂=again🙂")
        assert(string::compare(left, "value$i🙂=again🙂 \r\n") == 0)
        assert((try string::slice(text, last, last + 4)) == "🙂")
    end
end
