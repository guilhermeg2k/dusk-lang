let mut people = [Item(value = 1, next = null), Item(value = 2, next = null)]
let mut total = 0
for people: person do
    total += person.value
end
people[0].value = 10
for people: mut person do
    person.value += 1
    people[1].value += 0
end
assert(total == 3)
assert(people[0].value == 11)

let mut maybe: ?[]int = [1, 2]
if maybe: values then
    assert(len(values) == 2)
end
maybe = null
assert(maybe == null)
