struct Report
    rows: [][]int
    title: string
end

struct Item
    value: int
    next: ?Item
end

struct Chain
    head: ?Item
    tail: ?Item

    func add(mut self: @, value: int) -> void
        let mut item = Item(value = value, next = null)
        if self.tail: mut last then
            last.next = item
        else
            self.head = item
        end
        self.tail = item
    end
end

let mut squares_work: []int = []
for 0..4: i do
    append(squares_work, i * i)
end
let squares = squares_work
assert(squares[4] == 16)

let mut grid: [][]int = []
for 0..2: i do
    let mut row: []int = []
    append(row, i)
    append(grid, row)
end
let report = Report(rows = grid, title = "grid")
assert(len(report.rows) == 3)
assert(report.rows[2][0] == 2)

func build(n: int) -> [][]int
    let mut out: [][]int = []
    for 0..n: i do
        let mut row = [i, i * 2]
        append(out, row)
    end
    return out
end

func first_row(n: int) -> []int
    let table = Report(rows = build(n), title = "t")
    return table.rows[0]
end

func pick(flag: bool) -> []int
    let mut left = [1]
    let mut right = [2]
    return if flag then left else right end
end

func count_items(report: Report) -> int
    let rows = report.rows
    return len(rows)
end

let built = build(3)
assert(built[3][1] == 6)
assert(first_row(2)[0] == 0)
assert(pick(false)[0] == 2)
assert(count_items(report) == 3)

