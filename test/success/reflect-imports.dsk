import std/reflect as metadata
import std/reflect: type_of as inspect_type, type_of_value as inspect_value, is_same
import std/array

struct Item
    count: int
end

func inspect[T](value: T) -> metadata::Type
    assert(is_same(inspect_type[T](), inspect_value(value)))
    return inspect_type[T]()
end

func main() -> void
    let item = Item(7)
    let type = inspect(item)
    assert(is_same(type, inspect_type[Item]()))
    let closure = func() -> metadata::Type
        return inspect_type[Item]()
    end
    assert(is_same(closure(), type))
    let mut names: []string = []
    for metadata::fields(type): field do
        array::append(names, field.name)
    end
    assert(names[0] == "count")
end
