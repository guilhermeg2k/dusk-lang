error E
    Bad
end

error Kind
    A
    B
end

func classify(x: int) -> E!Kind
    if x < 0 then
        return E.Bad
    end
    if x == 0 then
        return Kind.B
    end
    let kind = Kind.A
    return kind
end

assert((classify(1) catch Kind.B) == Kind.A)
assert((classify(0) catch Kind.A) == Kind.B)
assert((classify(-1) catch Kind.B) == Kind.B)

classify(-1) catch e then
    assert(e == E.Bad)
end

func maybe_kind(x: int) -> E!?Kind
    if x < 0 then
        return E.Bad
    end
    if x == 0 then
        return null
    end
    return Kind.A
end

func unwrap_kind(kind: ?Kind) -> int
    if kind: value then
        if value == Kind.A then
            return 1
        end
        return 2
    end
    return 0
end

assert(unwrap_kind(maybe_kind(1) catch null) == 1)
assert(unwrap_kind(maybe_kind(0) catch Kind.B) == 0)
assert(unwrap_kind(maybe_kind(-1) catch Kind.B) == 2)

func inferred(x: int) -> !Kind
    if x < 0 then
        return E.Bad
    end
    return Kind.A
end

assert((inferred(1) catch Kind.B) == Kind.A)
assert((inferred(-1) catch Kind.B) == Kind.B)

func forward(x: int) -> E!Kind
    let kind = try classify(x)
    return kind
end

assert((forward(1) catch Kind.B) == Kind.A)
assert((forward(-1) catch Kind.B) == Kind.B)
