let mut kept: []string = []
let mut total = 0
for 1..20000: i do
    let line = "  key$i = value$i , extra  "
    let parts = str_split(str_trim(line), ",")
    let pair = str_split(parts[0], "=")
    let key = str_upper(str_trim(pair[0]))
    let value = str_replace(str_trim(pair[1]), "value", "v")
    let padded = try str_repeat("-", 3)
    total += len(key) + len(value) + len(padded)
    if i % 5000 == 0 then
        append(kept, str_concat(key, value))
        append(kept, str_lower(parts[1]))
    end
end
echo(kept)
echo(total)
