import std/array: append
import std/string

func main() -> !void
    let mut kept: []string = []
    let mut total = 0
    for 1..20000: i do
        let line = "  key$i = value$i , extra  "
        let parts = string::split(string::trim(line), ",")
        let pair = string::split(parts[0], "=")
        let key = string::upper(string::trim(pair[0]))
        let value = string::replace(string::trim(pair[1]), "value", "v")
        let padded = try string::repeat("-", 3)
        total = total + (string::len(key) + string::len(value) + string::len(padded))
        if i % 5000 == 0 then
            append(kept, string::concat(key, value))
            append(kept, string::lower(parts[1]))
        end
    end
    echo(kept)
    echo(total)
end
