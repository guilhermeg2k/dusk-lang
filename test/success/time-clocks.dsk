import "std/time"
import "std/task"
import "std/array"

func read_clock() -> int
    task::sleep(0)
    return time::monotonic_ns()
end

func main() -> void
    let wall: int = time::now_ms()
    let start: int = time::monotonic_ns()
    let mut previous = start
    for 1..1000: i do
        let current = time::monotonic_ns()
        assert(current >= previous)
        previous = current
    end
    let reader = spawn(func() -> return read_clock())
    let from_task = await(reader)
    let after_task = time::monotonic_ns()
    assert(from_task >= start and after_task >= from_task)
    let before_sleep = time::monotonic_ns()
    task::sleep(20)
    let elapsed = time::monotonic_ns() - before_sleep
    assert(elapsed >= 1000000)
    let mut values = [3, 1, 2]
    let before_sort = time::monotonic_ns()
    array::sort(values)
    let elapsed_ms = to_float(time::monotonic_ns() - before_sort) / 1000000.0
    assert(elapsed_ms >= 0.0)
    assert(values[0] == 1 and values[2] == 3)
    let wall_again: int = time::now_ms()
end
