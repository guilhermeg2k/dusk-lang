import std/reflect
import std/array
import std/task
import std/time

struct User
    name: string
    age: int = 30
    email: ?string = null
    let category = "user"

    func age_next_year(self: @) -> int
        return self.age + 1
    end
end

struct OtherUser
    name: string
    age: int = 30
    email: ?string = null
end

struct Node
    value: int
    next: ?Node = null
end

struct Empty
end

struct Private
    visible: int
    ~secret: string
end

struct Box[T]
    value: T
end

enum Color
    Red = 3
    Crimson = 3
    Blue = 7
end

union Response
    user: User
    message: string
end

union Tree
    leaf: int
    children: []Tree
end

struct Counter
    calls: int = 0
end

func make_user(mut counter: Counter) -> User
    counter.calls = counter.calls + 1
    return User("Ana")
end

func inspect[T]() -> reflect::Type
    return reflect::type_of[T]()
end

func main() -> !void
    let type = inspect[User]()
    assert(reflect::name(type) == "User")
    assert(reflect::kind(type) == reflect::Kind.Struct)
    assert(reflect::is_same(type, reflect::type_of[User]()))
    assert(reflect::is_same(copy(type), type))
    assert(!reflect::is_same(type, reflect::type_of[OtherUser]()))
    let mut description = reflect::fields(type)
    assert(array::len(description) == 3)
    assert(description[0].name == "name")
    assert(!description[0].has_default)
    assert(reflect::is_same(description[0].type, reflect::type_of[string]()))
    assert(description[1].name == "age")
    assert(description[1].has_default)
    assert(description[2].name == "email")
    assert(description[2].has_default)
    description[0].name = "changed"
    description[0].type = reflect::type_of[int]()
    assert(reflect::fields(type)[0].name == "name")
    assert(reflect::kind(reflect::fields(type)[0].type) == reflect::Kind.String)
    let mut counter = Counter()
    assert(reflect::is_same(reflect::type_of_value(make_user(counter)), type))
    assert(counter.calls == 1)
    if reflect::describe(type).structure: structure then
        assert(!structure.has_private_fields)
        assert(array::len(structure.fields) == 3)
    else
        assert(false)
    end
    let private_fields = reflect::fields(reflect::type_of[Private]())
    assert(array::len(private_fields) == 1)
    assert(private_fields[0].name == "visible")
    if reflect::describe(reflect::type_of[Private]()).structure: structure then
        assert(structure.has_private_fields)
    else
        assert(false)
    end
    assert(array::len(reflect::fields(reflect::type_of[time::Timestamp]())) == 0)
    assert(array::len(reflect::fields(reflect::type_of[Empty]())) == 0)
    assert(array::len(reflect::fields(reflect::type_of[int]())) == 0)
    let node_type = reflect::type_of[Node]()
    let next_type = reflect::fields(node_type)[1].type
    if reflect::describe(next_type).nullable: child then
        assert(reflect::is_same(child, node_type))
    else
        assert(false)
    end
    if reflect::describe(reflect::type_of[[]User]()).array: child then
        assert(reflect::is_same(child, type))
    else
        assert(false)
    end
    if reflect::describe(reflect::type_of[map[int, User]]()).map: mapping then
        assert(reflect::is_same(mapping.key, reflect::type_of[int]()))
        assert(reflect::is_same(mapping.value, type))
    else
        assert(false)
    end
    let variants = reflect::enum_variants(reflect::type_of[Color]())
    assert(array::len(variants) == 3)
    assert(variants[0].name == "Red")
    assert(variants[0].value == 3)
    assert(variants[1].name == "Crimson")
    assert(variants[1].value == 3)
    assert(variants[2].value == 7)
    assert(array::len(reflect::enum_variants(type)) == 0)
    let response = reflect::union_variants(reflect::type_of[Response]())
    assert(response[0].name == "user")
    assert(reflect::is_same(response[0].type, type))
    assert(response[1].name == "message")
    let tree = reflect::type_of[Tree]()
    let children = reflect::union_variants(tree)[1].type
    if reflect::describe(children).array: child then
        assert(reflect::is_same(child, tree))
    else
        assert(false)
    end
    assert(reflect::is_same(reflect::fields(reflect::type_of[Box[User]]())[0].type, type))
    assert(!reflect::is_same(reflect::type_of[Box[User]](), reflect::type_of[Box[OtherUser]]()))
    assert(reflect::kind(reflect::type_of[int]()) == reflect::Kind.Int)
    assert(reflect::kind(reflect::type_of[byte]()) == reflect::Kind.Byte)
    assert(reflect::kind(reflect::type_of[float]()) == reflect::Kind.Float)
    assert(reflect::kind(reflect::type_of[bool]()) == reflect::Kind.Bool)
    assert(reflect::kind(reflect::type_of[buffer]()) == reflect::Kind.Buffer)
    assert(reflect::kind(reflect::type_of[func(int) -> int]()) == reflect::Kind.Function)
    assert(reflect::kind(reflect::type_of[Task[int]]()) == reflect::Kind.Task)
    assert(reflect::kind(reflect::type_of[void]()) == reflect::Kind.Void)
    for 0..9999: i do
        let repeated = reflect::fields(node_type)
        assert(reflect::is_same(repeated[1].type, next_type))
        if i % 100 == 0 then
            task::sleep(0)
        end
    end
    assert(reflect::name(type) == "User")
end
