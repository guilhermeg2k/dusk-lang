func add(x: int, y = 2) -> return x + y

func add2(x: int = 2, y: int) -> return x + y

struct User
    username: string
    auth_method = "DUSK"
end

func main() -> void
    echo(add(50))
    echo(add(x = 50))
    echo(add(50,50))
    echo(add(y = 50,x = 50))

    echo(add2(10, 10))
    echo(add2(y = 10, x = 10))
    echo(add2(y = 45))

    echo(User("Rogerinho"))

    echo(User("Rogerinho", "Y"))

    echo(User(
        username="Rogerinho",
    ))

    echo(User(
        username="Rogerinho",
        auth_method="T"
    ))
end
