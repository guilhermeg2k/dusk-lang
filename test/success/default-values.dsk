import "std/io"

func add(x: int, y = 2) -> return x + y

func add2(x: int = 2, y: int) -> return x + y

struct User
    username: string
    auth_method = "DUSK"
end

func main() -> void
    io::println("${add(50)}")
    io::println("${add(x = 50)}")
    io::println("${add(50,50)}")
    io::println("${add(y = 50,x = 50)}")

    io::println("${add2(10, 10)}")
    io::println("${add2(y = 10, x = 10)}")
    io::println("${add2(y = 45)}")

    io::println("${User("Rogerinho")}")

    io::println("${User("Rogerinho", "Y")}")

    io::println("${User(
        username="Rogerinho",
    )}")

    io::println("${User(
        username="Rogerinho",
        auth_method="T"
    )}")
end
